<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MoxoPixel.MenuOverhaul</AssemblyName>
    <Description>MoxoPixel.MenuOverhaul</Description>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Version>1.2.2</Version>
    <Authors>MoxoPixel, GrooveypenguinX</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>MoxoPixel.MenuOverhaul</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**" />
    <Compile Remove="Interfaces\**" />
    <EmbeddedResource Remove="build\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="build\**" />
    <None Remove="Interfaces\**" />
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- References resolved from the local References/ folder (populated by compile-mod.sh
       from the SPT install). HintPaths were rewritten from the upstream ..\..\ layout so
       the mod builds outside the game directory. -->
  <ItemGroup>
    <Reference Include="DOTween">
      <HintPath>References\DOTween.dll</HintPath>
      <Private>False</Private>
    </Reference>
