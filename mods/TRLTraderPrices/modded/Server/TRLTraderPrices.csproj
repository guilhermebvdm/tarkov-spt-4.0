<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TRLTraderPrices</RootNamespace>
    <AssemblyName>TRLTraderPrices</AssemblyName>
    <Authors>trl</Authors>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesma linha do CustomClasses.Server / OutfitPersistenceFix. -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Common" Version="4.0.0" />
    <!-- Harmony: compila contra o 0Harmony (2.15.0) do servidor SPT; Private=false -> usa o do servidor
         em runtime, não redistribui. Necessário p/ o backstop de buy price (B-3): TradeHelper.SellItem
         não é virtual e DI typeOverride não intercepta. -->
    <Reference Include="0Harmony">
      <HintPath>References\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

<!--
    NOTE: config/overrides.json is USER DATA, written by the TRL Items Management viewer
    into user/mods/TRLTraderPrices/config/ at runtime. It is intentionally NOT shipped or
    copied here — shipping a default {} made compile-mod's config copy overwrite (clobber)
    the user's live overrides on every redeploy. The mod tolerates a missing file (logs
    "No overrides configured"); the viewer creates it on the first edit.
  -->

</Project>
