@code {
    [Parameter]
    public string BossId { get; set; } = "";

    public TRLConfig Config => TRLDynamicSpawnServer.Routers.TRLRouters.CurrentConfig;

    public EliteLocationInfo? CurrentBoss
    {
        get
        {
            if (string.IsNullOrEmpty(BossId)) return null;
            return BossId switch
            {
                "bossKnight" => Config.EliteConfig.BossKnight,
                "bossTagilla" => Config.EliteConfig.BossTagilla,
                "bossKilla" => Config.EliteConfig.BossKilla,
                "bossZryachiy" => Config.EliteConfig.BossZryachiy,
                "bossGluhar" => Config.EliteConfig.BossGluhar,
                "bossSanitar" => Config.EliteConfig.BossSanitar,
                "bossKolontay" => Config.EliteConfig.BossKolontay,
                "bossReshala" => Config.EliteConfig.BossReshala,
                "bossKaban" => Config.EliteConfig.BossKaban,
                "bossPartisan" => Config.EliteConfig.BossPartisan,
                "bossShturman" => Config.EliteConfig.BossShturman,
                "pmcBot" => Config.EliteConfig.Raiders,
                "exUsec" => Config.EliteConfig.Rogues,
                "arenaFighterEvent" => Config.EliteConfig.Bloodhounds,
                "sectantPriest" => Config.EliteConfig.Cultists,
                "sptBear" => Config.EliteConfig.Bear,
                "sptUsec" => Config.EliteConfig.Usec,
                "assault" => Config.EliteConfig.Scav,
                "gifter" => Config.EliteConfig.BossGifter,
                _ => null
            };
        }
    }

    private string ChanceLabel => (BossId == "sptBear" || BossId == "sptUsec" || BossId == "assault") ? "Hotzone Chance" : "Spawn Chance";

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private IEnumerable<string> GetZones(string? commaSeparated)
    {
        if (string.IsNullOrWhiteSpace(commaSeparated)) return new List<string>();
        return commaSeparated.Split(',').Select(x => x.Trim()).ToList();
    }

    private void SetZones(IEnumerable<string> zones, Action<string> setter)
    {
        setter(string.Join(",", zones));
    }

    public IEnumerable<string> CustomsZones
    {
        get => GetZones(CurrentBoss?.BossZone.Customs);
        set => SetZones(value, v => { if (CurrentBoss != null) CurrentBoss.BossZone.Customs = v; });
    }

