@page "/trldynamicspawn/boss/{BossId}"
@layout MainLayout

@using TRLDynamicSpawnServer.Models
@using System.Collections.Generic
@using System.Linq

<style>
    .mud-divider {
        border-width: 2.5px;
    }
    .dark-dropdown {
        background-color: #0f131f !important;
    }
</style>

<MudMainContent>
    <MudContainer Class="mb-20">
        @if (CurrentBoss != null)
        {
            <MudExpansionPanels MultiExpansion="true">
                
                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="@Localization.T("ENABLE/DISABLE")" Expanded=true>
                    <MudGrid>
                        <MudItem xs="1" />
                        <MudItem xs="4">
                            <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                <MudText>@Localization.T("Enable") @BossId.Replace("boss", "").Replace("pmcBot", "Raiders").Replace("exUsec", "Rogues").Replace("arenaFighterEvent", "Bloodhounds").Replace("sectantPriest", "Cultists").Replace("sptBear", "BEAR").Replace("sptUsec", "USEC").Replace("assault", "SCAV").Replace("Knight", "Goons (Knight, Big Pipe and Birdeye)").Replace("Gluhar", "Glukhar").Replace("Kolontay", "Kollontay").Replace("gifter", "Santa")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="1" />
                        <MudItem xs="6">
                            <MudSwitch @bind-Value="CurrentBoss.Enable" Color="Color.Success" Size="Size.Medium">
                                @((CurrentBoss.Enable) ? "True" : "False")
                            </MudSwitch>
                        </MudItem>
                    </MudGrid>                  </MudExpansionPanel>
  
                  @if (BossId != "pmcBot" && BossId != "sptBear" && BossId != "sptUsec" && BossId != "assault")
                  {
                      <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="@Localization.T("GENERAL")" Expanded=true>
                          <MudGrid>
                              <MudItem xs="1" />
                              <MudItem xs="4">
                                  <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                      <MudText>@Localization.T("Disable Followers")</MudText>
                                  </MudPaper>
                              </MudItem>
                              <MudItem xs="1" />
                              <MudItem xs="6">
                                  <MudSwitch @bind-Value="CurrentBoss.DisableFollowers" Color="Color.Primary" Size="Size.Medium">
                                      @((CurrentBoss.DisableFollowers) ? "True" : "False")
                                  </MudSwitch>
                              </MudItem>
                          </MudGrid>
                      </MudExpansionPanel>
                  }

                @if (BossId == "sptBear" || BossId == "sptUsec" || BossId == "assault")
                {
                    <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="@Localization.T("GROUP SPAWN SETTINGS")" Expanded=true>
                        <MudText Typo="Typo.body2" Class="mb-4">@Localization.T("Configure the size and chance of groups spawning instead of solo bots.")</MudText>
                        
                        <MudGrid Class="align-center mb-2 px-4">
                            <MudItem xs="4" sm="3" Class="pl-sm-12">
                                <MudText Typo="Typo.body2">@Localization.T("Group Spawn Chance (%)")</MudText>
                            </MudItem>
                            <MudItem xs="2" sm="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" Class="px-3">@CurrentBoss.GroupChance</MudButton>
                            </MudItem>
                            <MudItem xs="6" sm="6">
                                <MudSlider @bind-Value="CurrentBoss.GroupChance" Min="0" Max="100" Color="Color.Primary" Size="Size.Medium" ValueLabel="false" />
                            </MudItem>
                            <MudItem xs="0" sm="2" />
                        </MudGrid>

                        <MudGrid Class="align-center mb-6 px-4">
                            <MudItem xs="4" sm="3" Class="pl-sm-12">
                                <MudText Typo="Typo.body2">@Localization.T("Max Group Size")</MudText>
                            </MudItem>
                            <MudItem xs="2" sm="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" Class="px-3">@CurrentBoss.MaxGroupSize</MudButton>
                            </MudItem>
                            <MudItem xs="6" sm="6">
                                <MudSlider @bind-Value="CurrentBoss.MaxGroupSize" Min="1" Max="5" Color="Color.Primary" Size="Size.Medium" ValueLabel="false" />
                            </MudItem>
                            <MudItem xs="0" sm="2" />
                        </MudGrid>
                    </MudExpansionPanel>
                }

                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="@Localization.T("SPAWN CHANCES & ZONES")" Expanded=true>
                    
                                                                <!-- CUSTOMS -->
                      <MudText Typo="Typo.subtitle1" Class="mb-1 mt-6"><b>Customs</b></MudText>
                      <MudDivider Class="mb-4 mud-divider" />
                      
                      <MudGrid Class="align-center mb-2 px-4">
                          <MudItem xs="4" sm="3" Class="pl-sm-12">
                              <MudText Typo="Typo.body2">@ChanceLabel</MudText>
                          </MudItem>
                          <MudItem xs="2" sm="1">
                              <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" Class="px-3">@CurrentBoss.SpawnChance.Customs</MudButton>
                          </MudItem>
                          <MudItem xs="6" sm="6">
                              <MudSlider @bind-Value="CurrentBoss.SpawnChance.Customs" Min="0" Max="100" Color="Color.Primary" Size="Size.Medium" ValueLabel="false" />
                          </MudItem>
                          <MudItem xs="0" sm="2" />
                      </MudGrid>
                      
                      <MudGrid Class="align-center mb-6 px-4">
                          <MudItem xs="4" sm="3" Class="pl-sm-12">
                              <MudText Typo="Typo.body2">Spawn Zones</MudText>
                          </MudItem>
                          <MudItem xs="8" sm="7">
                              <TRLMultiSelect Label="Spawn Zones" @bind-SelectedValues="CustomsZones" Items="@(BotZones.CustomsZones.ToList())" />
                          </MudItem>
                          <MudItem xs="0" sm="2" />
                      </MudGrid>

                    <!-- FACTORY (DAY) -->
                      <MudText Typo="Typo.subtitle1" Class="mb-1 mt-6"><b>Factory (Day)</b></MudText>
                      <MudDivider Class="mb-4 mud-divider" />
                      
                      <MudGrid Class="align-center mb-2 px-4">
                          <MudItem xs="4" sm="3" Class="pl-sm-12">
                              <MudText Typo="Typo.body2">@ChanceLabel</MudText>
                          </MudItem>
                          <MudItem xs="2" sm="1">
                              <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" Class="px-3">@CurrentBoss.SpawnChance.Factory4Day</MudButton>
                          </MudItem>
                          <MudItem xs="6" sm="6">
                              <MudSlider @bind-Value="CurrentBoss.SpawnChance.Factory4Day" Min="0" Max="100" Color="Color.Primary" Size="Size.Medium" ValueLabel="false" />
                          </MudItem>
                          <MudItem xs="0" sm="2" />
                      </MudGrid>
                      
                      <MudGrid Class="align-center mb-6 px-4">
                          <MudItem xs="4" sm="3" Class="pl-sm-12">
