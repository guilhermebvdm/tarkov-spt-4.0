@page "/trldynamicspawn"
@layout MainLayout

<MudMainContent Class="pt-4">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-10 mt-4">
        <MudPaper Class="pa-4 pa-sm-6 ma-4 ma-sm-6" Elevation="4">
            <MudText Align="Align.Center" Typo="Typo.h3" Color="Color.Primary">@Localization.T("Welcome to TRL Dynamic Spawn!")</MudText>
            <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="mt-2 text-muted">@Localization.T("The evolution of spawn in SPTarkov: Combining the best of MOAR with the control of ABPS.")</MudText>
        </MudPaper>

        <MudExpansionPanels MultiExpansion="true" Class="ma-6">
            
            <MudExpansionPanel Class="mud-expansion-panels-borders pa-2" Text="@Localization.T("How does the Mod work?")" Expanded=true>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @Localization.T("TRL Dynamic Spawn is not just a simple bot manager. It completely rebuilds how the game decides when, where, and who will spawn in your raid.")
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @Localization.T("Instead of letting SPTarkov dump all bots at once at the start of the match, the mod creates dynamic waves (Hordes), which evaluate the maximum amount of bots allowed on the map (BotCap) and fill the available slots periodically. This ensures always alive maps and constant combat, without destroying your PC performance.")
                </MudText>
            </MudExpansionPanel>

            <MudExpansionPanel Class="mud-expansion-panels-borders pa-2" Text="@Localization.T("The Union: MOAR + ABPS")" Expanded=true>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @Localization.T("This project was born from the idea of merging two great philosophies of spawn mods:")
                </MudText>
                <MudList T="string" Class="mb-4">
                    <MudListItem Icon="@Icons.Material.Filled.MergeType">
                        <b>@Localization.T("The Logic of MOAR:")</b> @Localization.T("Inherits the concept of continuous waves and the Custom Spawns system. The mod decides the faction distribution and keeps sending reinforcements as bots die.")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.MergeType">
                        <b>@Localization.T("The Control of ABPS (Advanced Bot Placement System):")</b> @Localization.T("TRLDynamicSpawn brings the incredible interface and absurd level of control over Bosses and Elites. You can configure spawn chances and, most importantly, in exactly which specific zones each Boss is allowed to appear on each map.")
                    </MudListItem>
                </MudList>
            </MudExpansionPanel>

            <MudExpansionPanel Class="mud-expansion-panels-borders pa-2" Text="@Localization.T("Horde System & Limits (BotCap)")" Expanded=true>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @Localization.T("The mod uses the horde spawn system (Spawn Wave). Here is how it works:")
                </MudText>
                <MudList T="string">
                    <MudListItem Icon="@Icons.Material.Filled.Timer">
                        <b>@Localization.T("Timers:")</b> @Localization.T("You configure in the Map Configs page the time for the first wave (Delay Before First Wave) and the interval between subsequent waves (Seconds Between Waves).")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.GroupAdd">
                        <b>@Localization.T("Smart Filling:")</b> @Localization.T("At each cycle, the mod checks how many bots are alive. If the map supports 20 bots and only has 10 alive, the next wave will try to generate 10 new bots to fill the map again.")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Star">
                        <b>@Localization.T("Elite Priority:")</b> @Localization.T("Bosses, Rogues, Raiders, and Cultists always spawn first, as soon as the map loads. If Reshala has a 100% chance to spawn at Dorms, he and his guards will reserve their spots in the BotCap immediately.")
                    </MudListItem>
                </MudList>
            </MudExpansionPanel>

            <MudExpansionPanel Class="mud-expansion-panels-borders pa-2" Text="@Localization.T("Configuration Guide (Sidebar Menu)")" Expanded=true>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @Localization.T("Use the menu on the left to customize every aspect of your raid:")
                </MudText>
                <MudList T="string">
                    <MudListItem Icon="@Icons.Material.Filled.Map">
                        <b>@Localization.T("Map Configs:")</b> @Localization.T("Configure general map settings, preset faction ratios, horde wave timers, and anti-overlap distances.")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Casino">
                        <b>@Localization.T("Difficulty Roulette:")</b> @Localization.T("Set the difficulty weights. Do you want 50% of PMCs to be Hard and 50% Impossible? Configure the weights here.")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Grain">
                        <b>@Localization.T("Custom Spawns (MOAR):")</b> @Localization.T("Injects a list of new custom spawn points into the map. Adds new possibilities for PMCs, Scavs, Snipers, and Player spawns.")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Security">
                        <b>@Localization.T("Bot Config:")</b> @Localization.T("Click on a Boss name and change their spawn chance (%) and exactly the zones they are allowed to spawn in.")
                    </MudListItem>
                </MudList>
            </MudExpansionPanel>

        </MudExpansionPanels>
    </MudContainer>
</MudMainContent>

@code {

}





