@page "/trldynamicspawn/customspawns"
@layout MainLayout

@using TRLDynamicSpawnServer.Models

<style>
    .mud-divider {
        border-width: 2.5px;
    }
</style>

<MudMainContent Class="pt-4">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-20 mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">@Localization.T("Custom Spawns")</MudText>
        <MudText Typo="Typo.body2" Class="mb-6 text-muted">
            @Localization.T("Configure additional custom spawn locations (zones) on maps, allowing bots to spawn in areas where they normally wouldn't in the base game.")
        </MudText>
        
        <MudExpansionPanels MultiExpansion="true">
            
            <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-2 pa-sm-5" Text="@Localization.T("CUSTOM SPAWNS")" Expanded=true>
                <MudGrid>
                    
                    <!-- PMC Custom Spawns -->
                    <MudItem xs="1" />
                    <MudItem xs="4">
                        <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                            <MudTooltip Text="@Localization.T("Replaces random spawn with specific PMC spawn points.")" Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                <MudText>@Localization.T("Enable Custom PMC Spawns")</MudText>
                            </MudTooltip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="1" />
                    <MudItem xs="6">
                        <MudSwitch @bind-Value="Config.CustomSpawnsConfig.EnableCustomPmcSpawns" Color="Color.Success" Size="Size.Medium">
                            @((Config.CustomSpawnsConfig.EnableCustomPmcSpawns) ? "True" : "False")
                        </MudSwitch>
                    </MudItem>

                    <!-- Scav Custom Spawns -->
                    <MudItem xs="1" />
                    <MudItem xs="4">
                        <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                            <MudTooltip Text="@Localization.T("Replaces random spawn with specific Scav spawn points.")" Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                <MudText>@Localization.T("Enable Custom Scav Spawns")</MudText>
                            </MudTooltip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="1" />
                    <MudItem xs="6">
                        <MudSwitch @bind-Value="Config.CustomSpawnsConfig.EnableCustomScavSpawns" Color="Color.Success" Size="Size.Medium">
                            @((Config.CustomSpawnsConfig.EnableCustomScavSpawns) ? "True" : "False")
                        </MudSwitch>
                    </MudItem>

                    <!-- Sniper Custom Spawns -->
                    <MudItem xs="1" />
                    <MudItem xs="4">
                        <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                            <MudTooltip Text="@Localization.T("Replaces random spawn with specific Sniper spawn points.")" Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                <MudText>@Localization.T("Enable Custom Sniper Spawns")</MudText>
                            </MudTooltip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="1" />
                    <MudItem xs="6">
                        <MudSwitch @bind-Value="Config.CustomSpawnsConfig.EnableCustomSniperSpawns" Color="Color.Success" Size="Size.Medium">
                            @((Config.CustomSpawnsConfig.EnableCustomSniperSpawns) ? "True" : "False")
                        </MudSwitch>
                    </MudItem>

                    <!-- Player Custom Spawns -->
                    <MudItem xs="1" />
                    <MudItem xs="4">
                        <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                            <MudTooltip Text="@Localization.T("Replaces random initial spawn with specific Player spawn points.")" Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                <MudText>@Localization.T("Enable Custom Player Spawns")</MudText>
                            </MudTooltip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="1" />
                    <MudItem xs="6">
                        <MudSwitch @bind-Value="Config.CustomSpawnsConfig.EnableCustomPlayerSpawns" Color="Color.Success" Size="Size.Medium">
                            @((Config.CustomSpawnsConfig.EnableCustomPlayerSpawns) ? "True" : "False")
                        </MudSwitch>
                    </MudItem>

                </MudGrid>
            </MudExpansionPanel>

        </MudExpansionPanels>
    </MudContainer>
</MudMainContent>

@code {
    public TRLConfig Config => TRLDynamicSpawnServer.Routers.TRLRouters.CurrentConfig;
}






