                showToast("ok", t("toast_success"), `${t("copy_success_msg")} ${sourceName} ${t("copy_to_msg")} ${mapInfo.name}`);
            };
        }
    }

    function ensureMapConfig(mapId) {
        if (!stateCurrent.presets) {
            stateCurrent.presets = {
                high_end: { name: "Full Map / Open World (High-End)", enableSpawnBubble: false, enableTeleport: false, mapConfigs: {} },
                balanced: { name: "Dynamic Bubble (Balanced)", enableSpawnBubble: true, enableTeleport: true, mapConfigs: {} },
                performance: { name: "Performance / FPS Boost (Low-End)", enableSpawnBubble: true, enableTeleport: true, mapConfigs: {} }
            };
        }
        const profileKey = (activePresetTab && stateCurrent.presets[activePresetTab]) ? activePresetTab : "balanced";
        const currentProfile = stateCurrent.presets[profileKey];
        if (!currentProfile.mapConfigs) currentProfile.mapConfigs = {};

        if (!currentProfile.mapConfigs[mapId]) {
            const isHighEnd = profileKey === 'high_end';
            const isPerf = profileKey === 'performance';
            currentProfile.mapConfigs[mapId] = {
                secondsBetweenWaves: isPerf ? 420 : 360,
                sniperChance: isHighEnd ? 40 : (isPerf ? 20 : 30),
                safeZoneDistance: isHighEnd ? 40.0 : (isPerf ? 25.0 : 30.0),
                enableDespawn: !isHighEnd,
                despawnPMCs: !isHighEnd,
                despawnDistance: isHighEnd ? 600 : (isPerf ? 220 : 350),
                despawnInterval: isPerf ? 15 : 20,
                spawnBubbleDistance: isHighEnd ? 600 : (isPerf ? 220 : 350),
                enableSpawnBubble: !isHighEnd,
                teleportMinDistance: isPerf ? 80 : 100
            };
        }

        // Sincroniza mapConfigs raiz para retrocompatibilidade
        if (!stateCurrent.mapConfigs) stateCurrent.mapConfigs = {};
        stateCurrent.mapConfigs[mapId] = currentProfile.mapConfigs[mapId];

        return currentProfile.mapConfigs[mapId];
    }

