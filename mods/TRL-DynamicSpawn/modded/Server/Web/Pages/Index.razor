@page "/trldynamicspawn"
@page "/trldynamicspawn/{*path}"

<style>
/* TRL DESIGN SYSTEM TOKENS & COMPONENTS INLINED */
:root {
  --trl-ground-deep: #0d0d0e;
  --trl-ground:      #131314;
  --trl-surface-1:   #1b1b1d;
  --trl-surface-2:   #222225;
  --trl-surface-3:   #29292c;
  --trl-surface-4:   #303034;

  --trl-tan-100: #e8ddc4;
  --trl-tan-200: #d8c9a4;
  --trl-tan-300: #c7b48a;
  --trl-tan-400: #ab9a71;
  --trl-tan-500: #8f8560;
  --trl-tan-600: #6b6247;
  --trl-tan-700: #453f2d;
  --trl-tan-800: #2b2719;

  --trl-red-brand: #ff0000;
  --trl-red-300:   #ff6b60;
  --trl-red-400:   #f04438;
  --trl-red-500:   #d92c20;
  --trl-red-600:   #a8231a;
  --trl-red-700:   #711712;
  --trl-red-soft:  #d27a7a;

  --trl-green-400: #9ad27a;
  --trl-green-600: #5f8a49;
  --trl-amber-400: #cc9a3e;
  --trl-amber-600: #8a6a2c;
  --trl-blue-400:  #6f93bd;

  --trl-ink:         #e8e7e4;
  --trl-ink-muted:   #9b9a96;
  --trl-ink-faint:   #706f6b;
  --trl-ink-ghost:   #464541;
  --trl-ink-inverse: #131314;

  --trl-font-display: 'Bahnschrift', 'Segoe UI', system-ui, sans-serif;
  --trl-font-body:    'Segoe UI', system-ui, -apple-system, sans-serif;
  --trl-font-mono:    'Cascadia Mono', 'Consolas', ui-monospace, monospace;

  --trl-text-2xs: 10px;
  --trl-text-xs:  11px;
  --trl-text-sm:  12px;
  --trl-text-md:  13px;
  --trl-text-lg:  15px;
  --trl-text-xl:  18px;
  --trl-text-2xl: 22px;
  --trl-text-3xl: 28px;

  --trl-track-wide:   .08em;
  --trl-track-wider:  .14em;
  --trl-track-widest: .22em;

  --trl-weight-regular:  400;
  --trl-weight-semibold: 600;
  --trl-weight-bold:     700;

  --trl-space-0:  0;
  --trl-space-h:  2px;
  --trl-space-1:  4px;
  --trl-space-2:  8px;
  --trl-space-3:  12px;
  --trl-space-4:  16px;
  --trl-space-5:  20px;
  --trl-space-6:  24px;
  --trl-space-8:  32px;

  --trl-border-w:     1px;
  --trl-accent-bar-w: 2px;
  --trl-radius:       0;

  --trl-shadow-1: 0 2px 8px rgba(0, 0, 0, .35);
  --trl-shadow-2: 0 8px 24px rgba(0, 0, 0, .5);

  --trl-glow-tan:   0 0 6px rgba(199, 180, 138, .35);
  --trl-glow-green: 0 0 6px rgba(154, 210, 122, .55);
  --trl-glow-amber: 0 0 6px rgba(204, 154, 62, .55);
  --trl-glow-red:   0 0 8px rgba(255, 0, 0, .45);

  --trl-z-nav:     50;
  --trl-z-popover: 120;
  --trl-z-toast:   200;

  --trl-dur-1: 100ms;
  --trl-dur-2: 160ms;
  --trl-dur-3: 260ms;
  --trl-ease: cubic-bezier(.2, .7, .3, 1);

  --trl-sidebar-w:    280px;
  --trl-topbar-h:     48px;

  --trl-bg-app:     var(--trl-ground);
  --trl-bg-panel:   var(--trl-surface-1);
  --trl-bg-raised:  var(--trl-surface-2);
  --trl-bg-input:   var(--trl-ground-deep);
  --trl-bg-hover:   rgba(199, 180, 138, .08);
  --trl-bg-active:  rgba(199, 180, 138, .14);

  --trl-edge:        rgba(255, 255, 255, .09);
  --trl-edge-strong: rgba(255, 255, 255, .20);

  --trl-fg:           var(--trl-ink);
  --trl-fg-muted:     var(--trl-ink-muted);
  --trl-fg-faint:     var(--trl-ink-faint);
  --trl-fg-label:     var(--trl-ink-muted);
  --trl-fg-on-accent: var(--trl-ink-inverse);

  --trl-accent:        var(--trl-tan-300);
  --trl-accent-strong: var(--trl-tan-200);
  --trl-accent-dim:    var(--trl-tan-500);

  --trl-danger:        var(--trl-red-soft);
  --trl-danger-strong: var(--trl-red-500);
  --trl-success:       var(--trl-green-400);

  --trl-laser: linear-gradient(90deg, transparent, rgba(255, 0, 0, .55) 22%, #ff0000 50%, rgba(255, 0, 0, .55) 78%, transparent);
}

html, body {
  margin: 0;
  padding: 0;
  height: 100vh;
  background-color: var(--trl-ground);
  color: var(--trl-fg);
  font-family: var(--trl-font-body);
  font-size: var(--trl-text-md);
  overflow: hidden;
}

.trl-shell {
  display: grid;
  grid-template-rows: var(--trl-topbar-h) 1fr;
  grid-template-columns: var(--trl-sidebar-w) 1fr;
  grid-template-areas: "topbar topbar" "sidebar main";
  height: 100vh;
}

.trl-topbar {
  grid-area: topbar;
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--trl-space-4);
  padding: 0 var(--trl-space-4);
  background: var(--trl-ground-deep);
  border-bottom: 1px solid var(--trl-edge);
  z-index: var(--trl-z-nav);
}

.trl-topbar::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: -1px;
  height: 1px;
  background: var(--trl-laser);
  box-shadow: var(--trl-glow-red);
}

.trl-brand {
  display: flex;
  align-items: center;
  gap: var(--trl-space-2);
  font-family: var(--trl-font-display);
  text-transform: uppercase;
  letter-spacing: var(--trl-track-wider);
  font-size: var(--trl-text-md);
  color: var(--trl-ink);
  cursor: default;
}

.trl-brand__version {
  font-family: var(--trl-font-mono);
  font-size: var(--trl-text-2xs);
  color: var(--trl-fg-faint);
}

.trl-topbar__sep { width: 1px; height: 20px; background: var(--trl-edge); }
.trl-topbar__spacer { margin-left: auto; }

.trl-sidebar {
  grid-area: sidebar;
  background: var(--trl-bg-panel);
  border-right: 1px solid var(--trl-edge);
  overflow-y: auto;
  padding: var(--trl-space-3) 0;
}

.trl-main {
  grid-area: main;
  overflow-y: auto;
  padding: var(--trl-space-6);
}

.trl-nav { display: flex; flex-direction: column; gap: 2px; }
.trl-nav__label {
  padding: var(--trl-space-3) var(--trl-space-3) var(--trl-space-1);
  font-family: var(--trl-font-display);
  text-transform: uppercase;
  letter-spacing: var(--trl-track-widest);
  font-size: var(--trl-text-2xs);
  color: var(--trl-fg-faint);
}

.trl-nav__item {
  display: flex;
  align-items: center;
  gap: var(--trl-space-2);
  padding: var(--trl-space-2) var(--trl-space-3);
  border-left: 2px solid transparent;
  color: var(--trl-fg-muted);
  font-size: var(--trl-text-md);
  text-decoration: none;
  cursor: pointer;
  transition: all var(--trl-dur-1) var(--trl-ease);
  background: transparent;
  width: 100%;
  text-align: left;
}

.trl-nav__item:hover { background: var(--trl-bg-hover); color: var(--trl-fg); }
.trl-nav__item.is-active { border-left-color: var(--trl-accent); background: var(--trl-bg-active); color: var(--trl-fg); }

.trl-panel {
  background: var(--trl-bg-panel);
  border: 1px solid var(--trl-edge);
  margin-bottom: var(--trl-space-4);
}

.trl-screen-bar {
  display: flex;
  align-items: center;
  gap: var(--trl-space-2);
  height: 34px;
  padding: 0 var(--trl-space-3);
  background: rgba(0, 0, 0, .25);
  border-bottom: 1px solid var(--trl-edge);
  font-family: var(--trl-font-display);
  text-transform: uppercase;
  letter-spacing: var(--trl-track-wider);
  font-size: var(--trl-text-xs);
  color: var(--trl-fg-faint);
}

.trl-screen-bar__title { color: var(--trl-accent); }
.trl-screen-bar__meta { margin-left: auto; font-family: var(--trl-font-mono); }
.trl-screen-bar__dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
.trl-screen-bar__dot--ok { background: var(--trl-success); box-shadow: var(--trl-glow-green); }
.trl-screen-bar__dot--live { background: var(--trl-red-brand); box-shadow: var(--trl-glow-red); animation: trl-pulse 1.6s var(--trl-ease) infinite; }

.trl-panel__body { padding: var(--trl-space-4); }

.trl-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--trl-space-2);
  height: 30px;
  padding: 0 var(--trl-space-4);
  background: transparent;
  border: 1px solid var(--trl-edge-strong);
  color: var(--trl-fg-muted);
  font-family: var(--trl-font-display);
  text-transform: uppercase;
  letter-spacing: var(--trl-track-wide);
  font-size: var(--trl-text-sm);
  cursor: pointer;
  transition: all var(--trl-dur-1) var(--trl-ease);
}

.trl-btn:hover { background: var(--trl-bg-hover); color: var(--trl-fg); }
.trl-btn--primary { background: var(--trl-accent); border-color: var(--trl-accent); color: var(--trl-fg-on-accent); font-weight: bold; }
.trl-btn--primary:hover { background: var(--trl-accent-strong); box-shadow: var(--trl-glow-tan); }
.trl-btn--danger { background: var(--trl-danger-strong); border-color: var(--trl-danger-strong); color: #fff; font-weight: bold; }
.trl-btn--ghost { border-color: transparent; }

.trl-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--trl-space-3) var(--trl-space-4); }
.trl-form-grid__full { grid-column: 1 / -1; }

.trl-field { display: flex; flex-direction: column; gap: var(--trl-space-1); margin-bottom: var(--trl-space-3); }
.trl-field__label { font-family: var(--trl-font-display); text-transform: uppercase; font-size: var(--trl-text-xs); color: var(--trl-fg-label); display: flex; justify-content: space-between; align-items: center; }

.trl-slider { appearance: none; width: 100%; height: 4px; background: rgba(255, 255, 255, .06); outline: none; cursor: pointer; }
.trl-slider::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; background: var(--trl-accent); border: 1px solid var(--trl-tan-100); }
.trl-slider-val { font-family: var(--trl-font-mono); font-weight: bold; color: var(--trl-accent); margin-left: var(--trl-space-2); }

.trl-select {
  appearance: none; -webkit-appearance: none; width: 100%; height: 30px;
  padding: 0 var(--trl-space-6) 0 var(--trl-space-2);
  background-color: var(--trl-bg-input); border: 1px solid var(--trl-edge); color: var(--trl-fg); font-size: var(--trl-text-md);
  background-image:
    linear-gradient(45deg, transparent 50%, var(--trl-accent-dim) 50%),
    linear-gradient(135deg, var(--trl-accent-dim) 50%, transparent 50%);
  background-position: calc(100% - 14px) 13px, calc(100% - 9px) 13px;
  background-size: 5px 5px;
  background-repeat: no-repeat;
  cursor: pointer;
}

.trl-switch { display: inline-flex; align-items: center; gap: var(--trl-space-2); font-size: var(--trl-text-md); color: var(--trl-fg-muted); cursor: pointer; margin-bottom: var(--trl-space-2); }
.trl-switch input { appearance: none; width: 32px; height: 16px; background: var(--trl-bg-input); border: 1px solid var(--trl-edge-strong); position: relative; cursor: pointer; }
.trl-switch input::before { content: ""; position: absolute; top: 2px; left: 2px; width: 10px; height: 10px; background: var(--trl-fg-faint); transition: transform var(--trl-dur-2) var(--trl-ease); }
.trl-switch input:checked { background: var(--trl-bg-active); border-color: var(--trl-accent); }
.trl-switch input:checked::before { transform: translateX(16px); background: var(--trl-accent); }

.trl-view-section { display: none; }
.trl-view-section.is-active { display: block; }
.trl-subtabs { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: var(--trl-space-4); border-bottom: 1px solid var(--trl-edge); padding-bottom: 4px; }
.trl-subtab-btn { background: transparent; border: 1px solid var(--trl-edge); color: var(--trl-fg-muted); font-family: var(--trl-font-display); font-size: var(--trl-text-xs); text-transform: uppercase; padding: 6px 12px; cursor: pointer; }
.trl-subtab-btn.is-active { border-color: var(--trl-accent); background: var(--trl-bg-active); color: var(--trl-accent); }

.trl-boss-card { border: 1px solid var(--trl-edge); padding: var(--trl-space-3); margin-bottom: var(--trl-space-3); border-left: 2px solid var(--trl-accent); }
.trl-boss-card:nth-child(odd) { background: var(--trl-surface-1); }
.trl-boss-card:nth-child(even) { background: rgba(255, 255, 255, 0.035); }
.trl-boss-card__title { font-family: var(--trl-font-display); font-size: var(--trl-text-sm); text-transform: uppercase; color: var(--trl-fg); margin-bottom: var(--trl-space-2); }

.is-disabled {
  opacity: 0.35 !important;
  pointer-events: none !important;
  user-select: none !important;
  transition: opacity var(--trl-dur-2) var(--trl-ease);
}
.is-disabled input,
.is-disabled select,
.is-disabled button {
  cursor: not-allowed !important;
}

.trl-zone-matrix { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; margin-top: 8px; }
.trl-zone-chip {
  display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: var(--trl-surface-2); border: 1px solid var(--trl-edge);
  font-size: var(--trl-text-xs); font-family: var(--trl-font-mono); color: var(--trl-fg-muted); cursor: pointer; transition: all var(--trl-dur-1) var(--trl-ease);
}
.trl-zone-chip:hover { border-color: var(--trl-edge-strong); color: var(--trl-fg); }
.trl-zone-chip.is-active { background: var(--trl-bg-active); border-color: var(--trl-accent); color: var(--trl-accent); font-weight: bold; }

.trl-toast-container { position: fixed; right: var(--trl-space-4); bottom: var(--trl-space-4); display: flex; flex-direction: column; gap: var(--trl-space-2); z-index: var(--trl-z-toast); }
.trl-toast { min-width: 260px; max-width: 380px; background: var(--trl-surface-2); border: 1px solid var(--trl-edge-strong); border-left: 3px solid var(--trl-accent); padding: var(--trl-space-2) var(--trl-space-3); }
.trl-toast--ok { border-left-color: var(--trl-success); }
.trl-toast--warn { border-left-color: var(--trl-amber-400); }
.trl-toast--error { border-left-color: var(--trl-danger-strong); }
.trl-toast__title { font-family: var(--trl-font-display); text-transform: uppercase; font-size: var(--trl-text-xs); color: var(--trl-fg); }
.trl-toast__msg { font-size: var(--trl-text-sm); color: var(--trl-fg-muted); }

.trl-h3 { font-family: var(--trl-font-display); font-size: var(--trl-text-xl); color: var(--trl-fg); margin: 0 0 var(--trl-space-2); }
.trl-divider { border: none; height: 1px; background: var(--trl-edge); margin: var(--trl-space-4) 0; }

/* CUSTOMIZAÇÃO TRL DO MODAL DE RECONEXÃO NATIVO DO BLAZOR */
#components-reconnect-modal {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(13, 13, 14, 0.85) !important;
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

#components-reconnect-modal > div,
.components-reconnect-show {
  background: var(--trl-surface-1) !important;
  border: 1px solid var(--trl-edge-strong) !important;
  border-left: 3px solid var(--trl-red-brand) !important;
  color: var(--trl-ink) !important;
  font-family: var(--trl-font-display) !important;
  text-transform: uppercase;
  letter-spacing: var(--trl-track-wide);
  padding: var(--trl-space-6) var(--trl-space-8) !important;
  box-shadow: var(--trl-shadow-2) !important;
  border-radius: 0 !important;
  text-align: center;
}

/* TRL MODAL STYLES */
.trl-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(13, 13, 14, 0.85);
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  padding: 16px;
  z-index: 99999 !important;
}

.trl-modal {
  width: min(520px, 92vw);
  background: var(--trl-surface-1);
  border: 1px solid var(--trl-edge-strong);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
  z-index: 100000 !important;
}

.trl-modal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: rgba(0, 0, 0, 0.3);
  border-bottom: 1px solid var(--trl-edge);
}

.trl-modal__title {
  font-family: var(--trl-font-display);
  text-transform: uppercase;
  font-size: 13px;
  color: var(--trl-accent);
  margin: 0;
}

.trl-modal__close {
  background: none;
  border: none;
  color: var(--trl-fg-muted);
  font-size: 20px;
  cursor: pointer;
  line-height: 1;
}

.trl-modal__close:hover { color: var(--trl-danger); }

.trl-modal__body {
  padding: 16px;
  font-size: 13px;
  color: var(--trl-fg);
}

.trl-modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid var(--trl-edge);
  background: rgba(0, 0, 0, 0.15);
}

@@keyframes trl-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
</style>

<div class="trl-shell">
    <!-- TOPBAR -->
    <header class="trl-topbar">
        <div class="trl-brand">
            <span>TRL-DYNAMIC SPAWN</span>
            <span class="trl-brand__version">v1.0.0</span>
        </div>
        <div class="trl-topbar__sep"></div>
        
        <div class="trl-screen-bar" style="border-bottom: none; background: transparent; padding: 0;">
            <span id="syncDot" class="trl-screen-bar__dot trl-screen-bar__dot--ok"></span>
            <span id="syncText" class="trl-screen-bar__meta" style="color: var(--trl-fg-muted);" data-i18n="synced">SYNCED</span>
        </div>

        <div class="trl-topbar__spacer"></div>

        <div style="display:flex; gap:8px; align-items:center;">
            <select id="langSelect" class="trl-select" style="width: auto; height: 30px;">
                <option value="pt">PT-BR</option>
                <option value="en">EN-US</option>
            </select>
            <button type="button" id="btnReset" class="trl-btn" onclick="openResetModal()"><span data-i18n="reset">PADRÃO</span></button>
        </div>
    </header>

    <!-- SIDEBAR -->
    <aside class="trl-sidebar">
        <nav class="trl-nav">
            <div class="trl-nav__label" data-i18n="nav_label">GERENCIADOR DE SPAWN</div>
            <button type="button" class="trl-nav__item is-active" onclick="switchMainTab('sec-home', this)">
                <span data-i18n="nav_home">INÍCIO</span>
            </button>
            <button type="button" class="trl-nav__item" onclick="switchMainTab('sec-map-configs', this)">
                <span data-i18n="nav_maps">ONDAS</span>
            </button>
            <button type="button" class="trl-nav__item" onclick="switchMainTab('sec-boss-config', this)">
                <span data-i18n="nav_bosses">BOTS</span>
            </button>
            <button type="button" class="trl-nav__item" onclick="switchMainTab('sec-difficulty-config', this)">
                <span data-i18n="nav_difficulty">DIFICULDADE IA</span>
            </button>
            <button type="button" class="trl-nav__item" onclick="switchMainTab('sec-events-config', this)">
                <span data-i18n="nav_events">EVENTOS & INVASÕES</span>
            </button>
            <button type="button" class="trl-nav__item" onclick="switchMainTab('sec-custom-spawns', this)">
                <span data-i18n="nav_custom">SPAWNPOINTS ADICIONAIS</span>
            </button>
        </nav>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="trl-main">
        <!-- 0. HOME / INÍCIO -->
        <section id="sec-home" class="trl-view-section is-active">
            <div class="trl-panel">
                <div class="trl-screen-bar">
                    <span class="trl-screen-bar__title" data-i18n="title_home">VISÃO GERAL DO MOD & INSTRUÇÕES</span>
                </div>
                <div class="trl-panel__body">
                    <!-- HERO BANNER -->
                    <div style="background: var(--trl-surface-2); border: 1px solid var(--trl-edge); border-left: 3px solid var(--trl-accent); padding: var(--trl-space-4); margin-bottom: var(--trl-space-4);">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                            <div>
                                <h2 style="font-family: var(--trl-font-display); text-transform: uppercase; margin: 0 0 6px 0; font-size: 20px; color: var(--trl-ink);" data-i18n="home_hero_title">TRL - DYNAMIC SPAWN SYSTEM</h2>
                                <div style="color: var(--trl-fg-muted); font-size: 13px;" data-i18n="home_hero_subtitle">Gerenciador Avançado de Ondas, Injeção Dinâmica de Bots e Controle em Tempo Real para SPT Tarkov 4.0</div>
                            </div>
                            <div style="display:flex; gap:8px;">
                                <span style="background:var(--trl-ground-deep); border:1px solid var(--trl-edge); padding:4px 8px; font-family:var(--trl-font-mono); font-size:11px; color:var(--trl-success);">SPT 4.0.x READY</span>
                                <span style="background:var(--trl-ground-deep); border:1px solid var(--trl-edge); padding:4px 8px; font-family:var(--trl-font-mono); font-size:11px; color:var(--trl-accent);">v3.6.0</span>
                            </div>
                        </div>
                    </div>

                    <!-- DESCRIÇÃO DO MOD -->
                    <div class="trl-h3" data-i18n="home_section_desc_title">SOBRE O TRL-DYNAMIC SPAWN</div>
                    <p style="color: var(--trl-fg-muted); line-height: 1.6; margin-bottom: var(--trl-space-4);" data-i18n="home_desc_body">
                        O <strong>TRL-DynamicSpawn</strong> é um sistema de controle de spawns de alta performance projetado para Single Player Tarkov. Ele substitui os geradores rígidos de ondas nativos por um motor reativo que equilibra a densidade de PMCs, Scavs e Chefões, prevenindo o surgimento de bots visíveis ou sobrepostos (overlap) e garantindo uma experiência de combate dinâmica sem comprometer o desempenho do servidor.
                    </p>

                    <div class="trl-divider"></div>

                    <!-- A UNIÃO: MOAR + ABPS -->
                    <div class="trl-h3" data-i18n="home_union_title">A UNIÃO: LÓGICA MOAR + CONTROLE ABPS</div>
                    <p style="color: var(--trl-fg-muted); line-height: 1.6; margin-bottom: var(--trl-space-3);" data-i18n="home_union_body">
                        Este projeto nasceu da fusão das duas melhores filosofias de mods de spawn do SPTarkov:
                    </p>
                    <div class="trl-form-grid" style="margin-bottom: var(--trl-space-4);">
                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="home_moar_title">A Lógica do MOAR:</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="home_moar_desc">Herda o conceito de ondas contínuas de reforços e o sistema de Custom Spawns. O mod decide a distribuição de facções e envia reforços à medida que os bots morrem.</div>
                        </div>

                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="home_abps_title">O Controle do ABPS (Advanced Bot Placement System):</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="home_abps_desc">Traz a interface avançada e um nível de controle absurdo sobre Bosses e Elites. Você pode configurar as chances de spawn e, mais importante, exatamente em quais zonas específicas cada Boss tem permissão para aparecer em cada mapa.</div>
                        </div>
                    </div>

                    <div class="trl-divider"></div>

                    <!-- SISTEMA DE HORDAS E LIMITES (BOTCAP) -->
                    <div class="trl-h3" data-i18n="home_horde_title">SISTEMA DE HORDAS E LIMITES (BOTCAP)</div>
                    <p style="color: var(--trl-fg-muted); line-height: 1.6; margin-bottom: var(--trl-space-3);" data-i18n="home_horde_body">
                        O mod utiliza o sistema de spawn em hordas (Spawn Wave). Veja como funciona:
                    </p>
                    <div style="display:flex; flex-direction:column; gap:10px; margin-bottom: var(--trl-space-4);">
                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 12px 14px;">
                            <strong style="color:var(--trl-amber-400);" data-i18n="home_horde_timers_title">Temporizadores:</strong>
                            <span style="font-size:12px; color:var(--trl-fg-muted);" data-i18n="home_horde_timers_desc"> Você configura na página de Mapas o tempo para a primeira onda (Delay Before First Wave) e o intervalo entre as ondas subsequentes (Seconds Between Waves).</span>
                        </div>
                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 12px 14px;">
                            <strong style="color:var(--trl-amber-400);" data-i18n="home_horde_fill_title">Preenchimento Inteligente:</strong>
                            <span style="font-size:12px; color:var(--trl-fg-muted);" data-i18n="home_horde_fill_desc"> A cada ciclo, o mod verifica quantos bots estão vivos. Se o mapa suporta 20 bots e só tem 10 vivos, a próxima onda tentará gerar 10 novos bots para preencher o mapa novamente.</span>
                        </div>
                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 12px 14px;">
                            <strong style="color:var(--trl-amber-400);" data-i18n="home_horde_elite_title">Prioridade de Elites:</strong>
                            <span style="font-size:12px; color:var(--trl-fg-muted);" data-i18n="home_horde_elite_desc"> Bosses, Rogues, Raiders e Cultistas sempre aparecem primeiro, assim que o mapa carrega. Se Reshala tiver 100% de chance no Dorms, ele e seus guardas reservam suas vagas no BotCap imediatamente.</span>
                        </div>
                    </div>

                    <div class="trl-divider"></div>

                    <!-- INSTRUÇÕES E GUIA RÁPIDO -->
                    <div class="trl-h3" data-i18n="home_section_guide_title">INSTRUÇÕES E GUIA RÁPIDO</div>
                    <div class="trl-form-grid" style="margin-bottom: var(--trl-space-4);">
                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="guide_step1_title">1. CONFIGURAÇÃO DE MAPAS</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="guide_step1_desc">Ajuste o preset global de facções (Guerra de PMCs, Equilibrado, Infestação de Scavs) e defina o intervalo entre ondas, raio de segurança e distância de remoção anti-overlap para cada mapa individualmente.</div>
                        </div>

                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="guide_step2_title">2. CONTROLE DE BOSSES E ELITES</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="guide_step2_desc">Gerencie a chance de spawn de cada chefão por mapa e defina as zonas de patrulha nativas de forma visual. É possível desativar guardas/seguidores ou ajustar spawns em grupo para Scavs e PMCs.</div>
                        </div>

                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="guide_step3_title">3. DIFICULDADE DA IA</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="guide_step3_desc">Personalize os pesos percentuais de dificuldade (Fácil, Normal, Difícil, Impossível) para PMCs, Scavs e Chefões. O servidor sorteia a dificuldade de cada bot com base nessa curva.</div>
                        </div>

                        <div style="background: var(--trl-surface-1); border: 1px solid var(--trl-edge); padding: 14px;">
                            <div style="font-family:var(--trl-font-display); text-transform:uppercase; font-weight:bold; color:var(--trl-accent); margin-bottom:6px;" data-i18n="guide_step4_title">4. EVENTOS E INVASÕES</div>
                            <div style="font-size:12px; color:var(--trl-fg-muted); line-height:1.5;" data-i18n="guide_step4_desc">Configure o sistema de Invasão de Bosses para permitir que chefões apareçam em mapas não nativos, além de habilitar grupos aleatórios de Raiders e Rogues em qualquer localização.</div>
                        </div>
                    </div>

                    <div class="trl-divider"></div>

                    <!-- DICAS E RECOMENDAÇÕES DE DESEMPENHO -->
                    <div class="trl-h3" data-i18n="home_section_tips_title">DICAS E RECOMENDAÇÕES DE DESEMPENHO</div>
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <div style="background: rgba(154, 210, 122, 0.08); border-left: 3px solid var(--trl-success); padding: 10px 14px; font-size: 12px; color: var(--trl-ink);">
                            <strong style="color:var(--trl-success);" data-i18n="tip_perf_title">💡 Otimização de FPS (Teleport & Despawn):</strong>
                            <span data-i18n="tip_perf_desc"> Mantenha o 'Teleport de Bots Distantes' ativado. Isso recicla automaticamente bots que se distanciaram demais do combate, preservando a taxa de quadros (FPS) em mapas grandes como Streets e Lighthouse.</span>
                        </div>

                        <div style="background: rgba(204, 154, 62, 0.08); border-left: 3px solid var(--trl-amber-400); padding: 10px 14px; font-size: 12px; color: var(--trl-ink);">
                            <strong style="color:var(--trl-amber-400);" data-i18n="tip_save_title">⚠️ Persistência sem Reiniciar:</strong>
                            <span data-i18n="tip_save_desc"> Ao salvar suas configurações pelo painel, as alterações são gravadas diretamente no servidor (config/config.json) e aplicadas na próxima partida ou onda de spawn imediatamente!</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 1. MAP CONFIGS -->
        <section id="sec-map-configs" class="trl-view-section">
