    function markDirty(status) {
        const syncDot = document.getElementById("syncDot");
        const syncText = document.getElementById("syncText");

        if (status === "saving") {
            syncDot.className = "trl-screen-bar__dot trl-screen-bar__dot--live";
            syncDot.style.background = "var(--trl-amber-400)";
            syncDot.style.boxShadow = "var(--trl-glow-amber)";
            syncText.textContent = t("saving");
            syncText.style.color = "var(--trl-amber-400)";
        } else if (status === "pending" || status === true) {
            syncDot.className = "trl-screen-bar__dot trl-screen-bar__dot--live";
            syncDot.style.background = "";
            syncDot.style.boxShadow = "";
            syncText.textContent = t("unsaved");
            syncText.style.color = "var(--trl-red-300)";

            if (autoSaveTimer) clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(() => {
                saveConfig(true);
            }, 1000);
        } else {
            if (autoSaveTimer) {
                clearTimeout(autoSaveTimer);
                autoSaveTimer = null;
            }
            syncDot.className = "trl-screen-bar__dot trl-screen-bar__dot--ok";
            syncDot.style.background = "";
            syncDot.style.boxShadow = "";
            syncText.textContent = t("synced");
            syncText.style.color = "var(--trl-fg-muted)";
        }
    }

    async function parseResponseBody(res) {
        let rawText = "";
        try {
            const ds = new DecompressionStream('deflate');
            const decompressedStream = res.clone().body.pipeThrough(ds);
            const reader = decompressedStream.getReader();
            const bytes = [];
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                bytes.push(...value);
            }
            rawText = new TextDecoder().decode(new Uint8Array(bytes));
        } catch (zlibErr) {
            try {
                rawText = await res.clone().text();
            } catch (e) {
                rawText = "";
            }
        }

        let data = rawText;
        while (typeof data === 'string') {
            try { data = JSON.parse(data); } catch (e) { break; }
        }

        if (data && typeof data === 'object' && 'data' in data && data.data !== null && data.data !== undefined) {
            let innerData = data.data;
            while (typeof innerData === 'string') {
                try { innerData = JSON.parse(innerData); } catch (e) { break; }
            }
            data = innerData;
        }

        return data;
    }

    async function fetchConfig() {
        try {
            const res = await fetch("/trldynamicspawn/getConfig");
            if (!res.ok) throw new Error("Erro na requisição HTTP " + res.status);
            
            const data = await parseResponseBody(res);

            if (!data || typeof data !== 'object') {
                throw new Error("Formato de dados JSON inválido");
            }

            stateInitial = JSON.parse(JSON.stringify(data));
            stateCurrent = JSON.parse(JSON.stringify(data));
            renderUI();
            markDirty(false);
        } catch (err) {
            showToast("error", "ERRO", "Falha ao carregar configuração: " + err.message);
        }
    }

    async function saveConfig(isAutoSave = false) {
        if (autoSaveTimer) {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = null;
        }
        markDirty("saving");
        try {
            collectUI();
            if (!stateCurrent) {
                throw new Error("Objeto de configuração não inicializado.");
            }
            const res = await fetch("/trldynamicspawn/saveConfig", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "requestcompressed": "0"
                },
                body: JSON.stringify(stateCurrent)
            });

            if (!res.ok) throw new Error("Erro HTTP ao salvar " + res.status);

            const result = await parseResponseBody(res);

            if (result && (result.status === "success" || result.err === 0)) {
                stateInitial = JSON.parse(JSON.stringify(stateCurrent));
                markDirty(false);
                if (!isAutoSave) {
                    showToast("ok", t("toast_success"), t("toast_saved"));
                }
            } else {
                throw new Error(result?.message || result?.errmsg || "Erro do servidor ao salvar");
            }
        } catch (err) {
            markDirty(true);
            showToast("error", "ERRO", "Falha ao salvar: " + err.message);
        }
    }

