<div id="modalResetConfirm" class="trl-modal-overlay" style="display: none;">
    <div class="trl-modal">
        <div class="trl-modal__head">
            <h3 class="trl-modal__title" data-i18n="modal_reset_title">CONFIRMAR RESTAURAR PADRÕES</h3>
