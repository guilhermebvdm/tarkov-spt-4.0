                    <div class="trl-field">
                        <label class="trl-field__label">${t('diff_easy')} <span id="val_${f.prefix}_easy" class="trl-slider-val">${diffObj.easy ?? 10}</span></label>
                        <input type="range" id="${f.prefix}_easy" class="trl-slider" min="0" max="100" value="${diffObj.easy ?? 10}">
                    </div>
                    <div class="trl-field">
                        <label class="trl-field__label">${t('diff_normal')} <span id="val_${f.prefix}_normal" class="trl-slider-val">${diffObj.normal ?? 50}</span></label>
                        <input type="range" id="${f.prefix}_normal" class="trl-slider" min="0" max="100" value="${diffObj.normal ?? 50}">
                    </div>
                    <div class="trl-field">
                        <label class="trl-field__label">${t('diff_hard')} <span id="val_${f.prefix}_hard" class="trl-slider-val">${diffObj.hard ?? 30}</span></label>
                        <input type="range" id="${f.prefix}_hard" class="trl-slider" min="0" max="100" value="${diffObj.hard ?? 30}">
                    </div>
                    <div class="trl-field">
                        <label class="trl-field__label">${t('diff_impossible')} <span id="val_${f.prefix}_impossible" class="trl-slider-val">${diffObj.impossible ?? 10}</span></label>
                        <input type="range" id="${f.prefix}_impossible" class="trl-slider" min="0" max="100" value="${diffObj.impossible ?? 10}">
                    </div>
                </div>
            `;

            if (idx < factions.length - 1) {
                const divider = document.createElement("div");
                divider.className = "trl-divider";
                divider.style.marginTop = "20px";
                divider.style.marginBottom = "0px";
                block.appendChild(divider);
            }
            container.appendChild(block);

            bindSlider(`${f.prefix}_easy`, val => { ensureDiffObj(f.prop).easy = parseFloat(val); });
            bindSlider(`${f.prefix}_normal`, val => { ensureDiffObj(f.prop).normal = parseFloat(val); });
            bindSlider(`${f.prefix}_hard`, val => { ensureDiffObj(f.prop).hard = parseFloat(val); });
            bindSlider(`${f.prefix}_impossible`, val => { ensureDiffObj(f.prop).impossible = parseFloat(val); });
        });
    }

    function ensureDiffObj(propName) {
        if (!stateCurrent[propName]) stateCurrent[propName] = { easy: 10, normal: 50, hard: 30, impossible: 10 };
        return stateCurrent[propName];
    }

    // --- EVENTOS E INVASÕES ---

    function renderInvasionMatrices(invasion) {
        const bossContainer = document.getElementById("invasionBossesMatrix");
        const mapContainer = document.getElementById("invasionMapsMatrix");
        bossContainer.innerHTML = "";
        mapContainer.innerHTML = "";

        const selectedBosses = invasion.selectedBosses || ["Random"];
        const selectedMaps = invasion.selectedMaps || ["Random"];

        INVASION_BOSS_OPTIONS.forEach(b => {
            const isSelected = selectedBosses.includes(b);
            const chip = document.createElement("div");
            chip.className = `trl-zone-chip ${isSelected ? 'is-active' : ''}`;
            chip.textContent = b;
            chip.onclick = () => {
                let list = invasion.selectedBosses || [];
                if (b === "All") {
                    list = INVASION_BOSS_OPTIONS.filter(x => x !== "Random" && x !== "All");
                    list.unshift("All");
                } else if (b === "Random") {
                    list = ["Random"];
                } else {
                    if (list.includes("All")) list = list.filter(x => x !== "All");
                    if (list.includes("Random")) list = list.filter(x => x !== "Random");
                    if (list.includes(b)) list = list.filter(x => x !== b);
                    else list.push(b);
                }
                invasion.selectedBosses = list;
                renderInvasionMatrices(invasion);
                markDirty(true);
            };
            bossContainer.appendChild(chip);
        });

        INVASION_MAP_OPTIONS.forEach(m => {
            const isSelected = selectedMaps.includes(m);
            const chip = document.createElement("div");
            chip.className = `trl-zone-chip ${isSelected ? 'is-active' : ''}`;
            chip.textContent = m;
            chip.onclick = () => {
                let list = invasion.selectedMaps || [];
                if (m === "All") {
                    list = INVASION_MAP_OPTIONS.filter(x => x !== "Random" && x !== "All");
                    list.unshift("All");
                } else if (m === "Random") {
                    list = ["Random"];
                } else {
                    if (list.includes("All")) list = list.filter(x => x !== "All");
                    if (list.includes("Random")) list = list.filter(x => x !== "Random");
                    if (list.includes(m)) list = list.filter(x => x !== m);
                    else list.push(m);
                }
                invasion.selectedMaps = list;
                renderInvasionMatrices(invasion);
                markDirty(true);
            };
            mapContainer.appendChild(chip);
        });
    }

    function updateEventDependents() {
        const isBossInvasionActive = document.getElementById("evt_boss_invasion_enable")?.checked ?? false;
        setDependentState(["bossInvasionPanel"], isBossInvasionActive);

        const isRaiderActive = document.getElementById("evt_raiders_enable")?.checked ?? false;
        setDependentState(["evt_raiders_chance_wrap"], isRaiderActive);

        const isRogueActive = document.getElementById("evt_rogues_enable")?.checked ?? false;
        setDependentState(["evt_rogues_chance_wrap"], isRogueActive);
    }

    // --- COLETOR DE UI DE VOLTA AO OBJETO STATE ---

    function collectUI() {
        if (!stateCurrent) return;

        const factionEl = document.getElementById("factionDistribution");
        if (factionEl) {
            stateCurrent.factionDistribution = factionEl.value;
        }
        stateCurrent.activePreset = activePresetTab;

        if (!stateCurrent.eliteConfig) stateCurrent.eliteConfig = {};
        stateCurrent.eliteConfig.disableBosses = document.getElementById("disableBosses").checked;
        stateCurrent.eliteConfig.bossOpenZones = document.getElementById("bossOpenZones").checked;

        if (!stateCurrent.eliteConfig.bossInvasion) stateCurrent.eliteConfig.bossInvasion = {};
        stateCurrent.eliteConfig.bossInvasion.enable = document.getElementById("evt_boss_invasion_enable").checked;

        stateCurrent.eliteConfig.randomRaiderGroup = document.getElementById("evt_raiders_enable").checked;
        stateCurrent.eliteConfig.randomRogueGroup = document.getElementById("evt_rogues_enable").checked;

        if (!stateCurrent.customSpawnsConfig) stateCurrent.customSpawnsConfig = {};
        stateCurrent.customSpawnsConfig.enableCustomPmcSpawns = document.getElementById("enableCustomPmcSpawns").checked;
        stateCurrent.customSpawnsConfig.enableCustomScavSpawns = document.getElementById("enableCustomScavSpawns").checked;
        stateCurrent.customSpawnsConfig.enableCustomSniperSpawns = document.getElementById("enableCustomSniperSpawns").checked;
        stateCurrent.customSpawnsConfig.enableCustomPlayerSpawns = document.getElementById("enableCustomPlayerSpawns").checked;
    }

    function setLanguage(lang) {
        currentLang = lang;
        renderUI();

        const dict = I18N[lang] || I18N.pt;
        document.querySelectorAll("[data-i18n]").forEach(el => {
            const key = el.getAttribute("data-i18n");
            if (dict[key]) {
                el.textContent = dict[key];
            }
        });
    }

    // INICIALIZAÇÃO EVENT LISTENERS
    setTimeout(() => {
        setLanguage("pt");
        fetchConfig();

        const factionEl = document.getElementById("factionDistribution");
        if (factionEl) {
            factionEl.onchange = (e) => {
                const descDict = PRESET_DESCRIPTIONS[currentLang] || PRESET_DESCRIPTIONS.pt;
                document.getElementById("presetDescriptionText").textContent = descDict[e.target.value] || "";
                markDirty(true);
            };
        }

        bindSlider("delayBeforeFirstWave", val => {
            const firstMap = MAP_LIST[0].id;
            ensureMapConfig(firstMap).delayBeforeFirstWave = parseInt(val);
        });

        bindSlider("evt_boss_invasion_map_chance", val => { ensureInvasion().mapChance = parseInt(val); });
        bindSlider("evt_boss_invasion_boss_chance", val => { ensureInvasion().bossChance = parseInt(val); });
        bindSlider("evt_raiders_chance", val => { stateCurrent.eliteConfig.randomRaiderGroupChance = parseInt(val); });
        bindSlider("evt_rogues_chance", val => { stateCurrent.eliteConfig.randomRogueGroupChance = parseInt(val); });

        function ensureInvasion() {
            if (!stateCurrent.eliteConfig) stateCurrent.eliteConfig = {};
            if (!stateCurrent.eliteConfig.bossInvasion) stateCurrent.eliteConfig.bossInvasion = {};
            return stateCurrent.eliteConfig.bossInvasion;
        }

        document.getElementById("disableBosses").onchange = () => markDirty(true);
        document.getElementById("bossOpenZones").onchange = () => markDirty(true);
        document.getElementById("evt_boss_invasion_enable").onchange = () => { updateEventDependents(); markDirty(true); };
        document.getElementById("evt_raiders_enable").onchange = () => { updateEventDependents(); markDirty(true); };
        document.getElementById("evt_rogues_enable").onchange = () => { updateEventDependents(); markDirty(true); };
        document.getElementById("enableCustomPmcSpawns").onchange = () => markDirty(true);
        document.getElementById("enableCustomScavSpawns").onchange = () => markDirty(true);
        document.getElementById("enableCustomSniperSpawns").onchange = () => markDirty(true);
        document.getElementById("enableCustomPlayerSpawns").onchange = () => markDirty(true);

        document.getElementById("btnReset").onclick = openResetModal;
        document.getElementById("btnConfirmReset").onclick = confirmReset;

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeResetModal();
        });

        document.getElementById("langSelect").onchange = (e) => {
            setLanguage(e.target.value);
        };
    }, 100);
})();
</script>

