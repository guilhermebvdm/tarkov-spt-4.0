    function formatSliderVal(id, val) {
        if (id === "bc_lh_rogue_max" && (val == -1 || val == "-1")) {
            return t('no_limit');
        }
        return val;
    }

    function setSliderVal(id, val) {
        const input = document.getElementById(id);
        const display = document.getElementById("val_" + id);
        if (input) input.value = val;
        if (display) display.textContent = formatSliderVal(id, val);
    }

    function bindSlider(id, callback) {
        const input = document.getElementById(id);
        const display = document.getElementById("val_" + id);
        if (input) {
            input.oninput = (e) => {
                if (display) display.textContent = formatSliderVal(id, e.target.value);
                if (callback) callback(e.target.value);
                markDirty(true);
            };
        }
    }


    function setDependentState(ids, isEnabled) {
        const idArray = Array.isArray(ids) ? ids : [ids];
        idArray.forEach(id => {
            const el = typeof id === 'string' ? document.getElementById(id) : id;
            if (!el) return;
            if (isEnabled) {
                el.classList.remove("is-disabled");
                el.style.opacity = "1";
                el.style.pointerEvents = "auto";
                el.querySelectorAll("input, select, button").forEach(i => { i.disabled = false; });
                if (["INPUT", "SELECT", "BUTTON"].includes(el.tagName)) el.disabled = false;
            } else {
                el.classList.add("is-disabled");
                el.style.opacity = "0.35";
                el.style.pointerEvents = "none";
                el.querySelectorAll("input, select, button").forEach(i => { i.disabled = true; });
                if (["INPUT", "SELECT", "BUTTON"].includes(el.tagName)) el.disabled = true;
            }
        });
    }

