    // Scroll to page top and flash the anchor alert element
    window.scrollToTopAlert = function(event, containerId, alertId) {
        event.preventDefault();
        const alert = document.getElementById(alertId);

        // Scroll the main scrollable area to the very top
        const main = document.querySelector('.trl-main') || document.querySelector('main') || document.documentElement;
        main.scrollTo({ top: 0, behavior: 'smooth' });
        // Also reset inner containers just in case
        const container = document.getElementById(containerId);
        if (container) container.scrollTop = 0;

        // Flash the note box after scroll settles
        if (alert) {
            setTimeout(() => {
                alert.style.transition = 'box-shadow 0.15s ease';
                let flashes = 0;
                const interval = setInterval(() => {
                    alert.style.boxShadow = flashes % 2 === 0
                        ? '0 0 0 2px var(--trl-accent), 0 0 12px rgba(200,170,80,0.45)'
                        : 'none';
                    flashes++;
                    if (flashes >= 6) {
                        clearInterval(interval);
                        alert.style.boxShadow = 'none';
                    }
                }, 180);
            }, 400); // pequeno delay para o scroll terminar antes do flash
        }
    };

    window.toggleBossZone = function(bossProp, mapKey, zoneName, chipEl) {
        const bossInfo = ensureBossInfo(bossProp);
        if (!bossInfo.bossZone) bossInfo.bossZone = {};

        let currentStr = bossInfo.bossZone[mapKey] || "";
        let zones = currentStr ? currentStr.split(",").map(z => z.trim()).filter(Boolean) : [];

        if (zones.includes(zoneName)) {
            zones = zones.filter(z => z !== zoneName);
            chipEl.classList.remove("is-active");
        } else {
            zones.push(zoneName);
            chipEl.classList.add("is-active");
        }

        bossInfo.bossZone[mapKey] = zones.join(",");
        markDirty(true);
    };

    function ensureBossInfo(bossProp) {
        if (!stateCurrent.eliteConfig) stateCurrent.eliteConfig = {};
        if (!stateCurrent.eliteConfig[bossProp]) {
            stateCurrent.eliteConfig[bossProp] = {
                enable: true, disableFollowers: false, groupChance: 30, maxGroupSize: 3,
                spawnChance: {}, bossZone: {}
            };
        }
        return stateCurrent.eliteConfig[bossProp];
    }

