                const sourceMapId = sourceSelect?.value;
                if (!sourceMapId) {
                    showToast("warn", t("toast_undo") || "AVISO", t("copy_select_source_warn"));
                    return;
                }

                const currentProfile = (stateCurrent.presets && stateCurrent.presets[activePresetTab]) ? stateCurrent.presets[activePresetTab] : { mapConfigs: stateCurrent.mapConfigs };
                const sourceCfg = currentProfile.mapConfigs?.[sourceMapId] || stateCurrent.mapConfigs?.[sourceMapId];
                if (!sourceCfg) {
                    showToast("warn", t("toast_undo") || "AVISO", t("copy_no_cfg_warn"));
                    return;
                }

                const targetCfg = ensureMapConfig(mapInfo.id);
                Object.assign(targetCfg, JSON.parse(JSON.stringify(sourceCfg)));

                markDirty(true);
                renderActiveMapConfig();

                const sourceMapObj = MAP_LIST.find(m => m.id === sourceMapId);
