<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TarkovRedLine.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- Manter em sincronia com Plugin.cs (SemanticVersioning.Version). Define AssemblyVersion/
         FileVersion/InformationalVersion → é a "Versão do arquivo" que o Windows mostra. -->
    <Version>4.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Homolog)'=='true'">
    <DefineConstants>$(DefineConstants);HOMOLOG</DefineConstants>
    <AssemblyName>TarkovRedLine.Server.Homolog</AssemblyName>
    <!-- Output próprio: evita o IncrementalClean apagar o DLL de produção do bin/Release
         (prod e homolog compartilhariam a mesma pasta e um clobberaria o outro). -->
    <BaseOutputPath>bin-homolog\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet em vez de HintPath local (E:\TORRENT era path de outra máquina) — mesmo padrão validado no CustomClasses.Server -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.2" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.0.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.2" />
    <PackageReference Include="SPTarkov.Common" Version="4.0.2" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
  </ItemGroup>
</Project>
