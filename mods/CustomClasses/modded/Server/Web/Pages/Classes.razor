@page "/customclasses/classes"
@layout BaseLayout

@* Item 024: class list — one row per FILE in config/classes/ (ClassEditorService.ListClassFiles),
   never from the registries: a disabled or invalid class only exists on disk. Costs come from
   CostService (item 022). Rows navigate to the read-only detail page (extension-less file name
   in the route — see ClassDetail.razor).
   Item 027: lifecycle actions — "New class" in the toolbar, Duplicate/Delete per row (dialogs in
   Web/Shared/ClassLifecycle*.razor). Create navigates to the 025 edit form; duplicate to the new
   detail page; delete/disable reloads the list (everything hot-applies — no restart). *@

@using System.Globalization
@inject ClassEditorService EditorService
@inject CostService CostService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>CustomClasses — Classes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h4">Classes</MudText>
            <MudSpacer/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">
                New class
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mb-4">
            Every class file in <code>config/classes/</code> (including disabled and invalid ones),
            with the boot-equivalent dry-run diagnostics and the item-022 cost model.
            Click a row for the read-only detail.
        </MudText>

        @if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No class files found in config/classes/.</MudAlert>
        }
        else
        {
            <MudTable T="Row" Items="@_rows" Dense="true" Hover="true"
                      OnRowClick="@OnRowClick" RowClass="cursor-pointer">
                <HeaderContent>
                    <MudTh Style="width:48px"></MudTh>
                    <MudTh>Class</MudTh>
                    <MudTh>Display name (en)</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Skills</MudTh>
                    <MudTh Style="text-align:right">Skill cost</MudTh>
                    <MudTh Style="text-align:right">Loadout</MudTh>
                    <MudTh>File</MudTh>
                    <MudTh Style="width:96px">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="">
                        @if (context.IconUrl is not null)
                        {
                            <img src="@context.IconUrl" alt="" width="32" height="32"
                                 style="object-fit:contain;vertical-align:middle;"/>
                        }
                    </MudTd>
                    <MudTd DataLabel="Class">
                        <MudText Typo="Typo.body1" Style="@NameStyle(context)"><b>@context.Name</b></MudText>
                    </MudTd>
                    <MudTd DataLabel="Display name (en)">@context.DisplayNameEn</MudTd>
                    <MudTd DataLabel="Status">
                        @StatusChip(context)
                    </MudTd>
                    <MudTd DataLabel="Skills" Style="text-align:right">@context.SkillCount</MudTd>
                    <MudTd DataLabel="Skill cost" Style="text-align:right">
                        @SkillCostChip(context)
                    </MudTd>
                    <MudTd DataLabel="Loadout" Style="text-align:right">
                        @(context.SkillCost is null ? "—" : FormatRub(context.LoadoutTotal))
                    </MudTd>
                    <MudTd DataLabel="File"><code>@context.Entry.FileName</code></MudTd>
                    <MudTd DataLabel="Actions">
                        @* Plain div with stopPropagation: the row itself navigates on click (item 024). *@
                        <div @onclick:stopPropagation="true" style="display:flex;gap:4px;">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           title="Duplicate (the official rename path)"
                                           Disabled="@(context.Entry.Definition is null)"
                                           OnClick="@(() => OpenDuplicateDialogAsync(context))"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" title="Delete / disable"
                                           OnClick="@(() => OpenDeleteDialogAsync(context))"/>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    /// <summary>One list row: file entry + precomputed costs (computed once in OnInitialized).</summary>
    private sealed record Row(
        ClassFileEntry Entry,
        string? IconUrl,
        string Name,
        string? NameColor,
        string DisplayNameEn,
        int SkillCount,
        SkillCostBreakdown? SkillCost,
        double LoadoutTotal,
        bool HasError);

    private List<Row> _rows = [];

    private static readonly DialogOptions LifecycleDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true,
    };

    protected override void OnInitialized() => LoadRows();

    private void LoadRows()
    {
        _rows = [];

        // ListClassFiles runs one parse + dry-run per file — fine for ~12 classes, loaded once per visit.
        foreach (var entry in EditorService.ListClassFiles())
        {
            var def = entry.Definition;
            var hasError = def is null || entry.Diagnostics.Any(d => d.Severity == DiagnosticSeverity.Error);

            // Definition == null (parse error): the row still renders, with the error chip + tooltip.
            var skillCost = def is null ? null : CostService.ComputeSkillCost(def);
            var loadoutTotal = def is null ? 0 : CostService.ComputeLoadoutCost(def).TotalRub;

            _rows.Add(new Row(
                entry,
                def?.IconFile is { Length: > 0 } icon ? $"/CustomClasses-Server/icons/{icon}" : null,   // wwwroot statics (item 020)
                def?.Name ?? entry.FileName,
                def?.NameColor,
                def?.DisplayName?.En ?? "—",
                def?.Skills?.Count ?? 0,
                skillCost,
                loadoutTotal,
                hasError));
        }
    }

    private void OnRowClick(TableRowClickEventArgs<Row> args)
    {
        if (args.Item is null)
        {
            return;
        }

        // Extension-less name in the route: ".jsonc" in the last URL segment can be hijacked by
        // static-file handling — the detail page resolves it back (see ClassDetail.razor).
        var bare = Path.GetFileNameWithoutExtension(args.Item.Entry.FileName);
        Nav.NavigateTo($"/customclasses/classes/{Uri.EscapeDataString(bare)}");
    }

    // ── Lifecycle actions (item 027) ─────────────────────────────────────────

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ClassLifecycleCreateDialog>("New class", LifecycleDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string fileName })
        {
            // Kickoff: a freshly created class opens straight in the 025 edit form.
            var bare = Path.GetFileNameWithoutExtension(fileName);
            Nav.NavigateTo($"/customclasses/classes/{Uri.EscapeDataString(bare)}/edit");
        }
    }

    private async Task OpenDuplicateDialogAsync(Row row)
    {
        var parameters = new DialogParameters<ClassLifecycleDuplicateDialog>
        {
            { x => x.SourceFileName, row.Entry.FileName },
            { x => x.SourceClassName, row.Entry.Definition?.Name },
        };
        var dialog = await DialogService.ShowAsync<ClassLifecycleDuplicateDialog>("Duplicate class", parameters, LifecycleDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string fileName })
        {
            Snackbar.Add($"Class duplicated to '{fileName}' and hot-applied.", Severity.Success);
            var bare = Path.GetFileNameWithoutExtension(fileName);
            Nav.NavigateTo($"/customclasses/classes/{Uri.EscapeDataString(bare)}");
        }
    }

    private async Task OpenDeleteDialogAsync(Row row)
    {
        var parameters = new DialogParameters<ClassLifecycleDeleteDialog>
        {
            { x => x.FileName, row.Entry.FileName },
            { x => x.ClassName, row.Entry.Definition?.Name },
            // "Disable instead" needs a parseable, currently-enabled definition to re-save.
            { x => x.CanDisable, row.Entry.Definition is not null && row.Entry.Enabled },
        };
        var dialog = await DialogService.ShowAsync<ClassLifecycleDeleteDialog>("Delete class", parameters, LifecycleDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string action })
        {
            Snackbar.Add(action == "deleted"
                ? $"'{row.Entry.FileName}' deleted (edition hot-removed; .bak1 keeps the last content)."
                : $"'{row.Entry.FileName}' disabled (edition hot-removed; file kept).",
                Severity.Success);
            LoadRows();
            StateHasChanged();
        }
    }

    private static string? NameStyle(Row row) =>
        string.IsNullOrWhiteSpace(row.NameColor) ? null : $"color:{row.NameColor};";

    private RenderFragment StatusChip(Row row) => __builder =>
    {
        if (row.HasError)
        {
            var tooltip = string.Join(" • ", row.Entry.Diagnostics.Select(d => $"[{d.Code}] {d.Message}"));
            <MudTooltip Text="@tooltip">
                <MudChip T="string" Size="Size.Small" Color="Color.Error">Invalid</MudChip>
            </MudTooltip>
        }
        else if (!row.Entry.Enabled)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default">Disabled</MudChip>
        }
        else if (row.Entry.Registered)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">Registered</MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Not registered</MudChip>
        }
    };

    private RenderFragment SkillCostChip(Row row) => __builder =>
    {
        if (row.SkillCost is null)
        {
            <MudText Typo="Typo.body2">—</MudText>
        }
        else if (row.SkillCost.Total == 0)
        {
            // intentionally empty class (e.g. Peladão) — neutral, not "over/under budget"
            <MudChip T="string" Size="Size.Small" Color="Color.Default">0</MudChip>
        }
        else
        {
            <MudTooltip Text="@($"Weighted skill cost — budget [{SkillWeights.BudgetMin:0}, {SkillWeights.BudgetMax:0}]")">
                <MudChip T="string" Size="Size.Small"
                         Color="@(row.SkillCost.WithinBudget ? Color.Success : Color.Warning)">
                    @row.SkillCost.Total.ToString("0.00", CultureInfo.InvariantCulture)
                </MudChip>
            </MudTooltip>
        }
    };

    private static string FormatRub(double value) =>
        value.ToString("N0", CultureInfo.InvariantCulture) + " ₽";
}
