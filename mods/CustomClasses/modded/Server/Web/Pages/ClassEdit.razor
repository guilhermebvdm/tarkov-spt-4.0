    // ── Stash (item 028) ─────────────────────────────────────────────────────

    private static readonly DialogOptions StashPickerOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
    };

    /// <summary>Sum of root counts (count ≥ 1) — stacks/contents expansion is the dry-run's job.</summary>
    private int StashUnitTotal() => _model!.Stash.Sum(l => Math.Max(1, l.Count));

    // ── Item 034: Stash tab name filter + category grouping (display only) ─────
    private string _stashFilter = string.Empty;

    private sealed record StashGroupEntry(ItemSpecModel Line, int Number, string Name);
    private sealed record StashEditGroup(string Name, List<StashGroupEntry> Lines);

    private const string StashOtherGroup = "Other";

    /// <summary>
    ///     Item 034: filter changed. Display-only re-bucketing — never calls ScheduleRecompute/RecomputeLoadoutCost
    ///     (PA-037-04: the stash cost/capacity dry-run is unrelated to which cards are shown).
    /// </summary>
    private void StashFilterChanged() => StateHasChanged();

    /// <summary>
    ///     Buckets <c>_model.Stash</c> by handbook category for display, preserving the underlying list order
    ///     (the #N badge is the original 1-based index, stable regardless of filter/group). Resolves each line's
    ///     root tpl (preset > tpl) once to derive name/short name/category. The filter matches name, short name
    ///     or tpl (case-insensitive). Groups are sorted by name; "Other" collects lines with no handbook category.
    /// </summary>
    private List<StashEditGroup> BuildStashGroups()
    {
        var filter = _stashFilter?.Trim() ?? string.Empty;
        var groups = new Dictionary<string, List<StashGroupEntry>>(StringComparer.Ordinal);

        for (var i = 0; i < _model!.Stash.Count; i++)
        {
            var line = _model.Stash[i];
            var rootTpl = StashRootTpl(line);
            var name = rootTpl is not null ? Catalog.GetItemName(new MongoId(rootTpl)) : (line.Preset ?? line.Tpl ?? "(no tpl)");

            if (filter.Length > 0)
            {
                var raw = $"{name} {rootTpl} {line.Tpl} {line.Preset}";
                if (!raw.Contains(filter, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }
            }

            var groupName = (rootTpl is not null ? Catalog.GetCategoryName(rootTpl) : null) ?? StashOtherGroup;
            if (!groups.TryGetValue(groupName, out var list))
            {
                groups[groupName] = list = [];
            }

            list.Add(new StashGroupEntry(line, i + 1, name));
        }

        return groups
            .Select(kv => new StashEditGroup(kv.Key, kv.Value))
            .OrderBy(g => g.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Root item tpl for a stash line (preset > tpl), null when unresolved. Mirrors ClassViewItemSpec.</summary>
    private string? StashRootTpl(ItemSpecModel line)
    {
        if (!string.IsNullOrWhiteSpace(line.Preset) && MongoId.IsValidMongoId(line.Preset))
        {
            var key = new MongoId(line.Preset);
            var preset = line.Premium ? Catalog.ResolvePremiumPreset(key) : Catalog.ResolveDefaultPreset(key);
            return preset?.Items?.FirstOrDefault()?.Template.ToString();
        }

        return !string.IsNullOrWhiteSpace(line.Tpl) && MongoId.IsValidMongoId(line.Tpl) ? line.Tpl : null;
    }

    /// <summary>New stash line via ItemPicker (unfiltered — the stash accepts any item template).</summary>
    private async Task AddStashLineAsync()
    {
        var parameters = new DialogParameters<ItemPicker> { { x => x.Title, "Add stash item" } };
        var dialog = await DialogService.ShowAsync<ItemPicker>("Add stash item", parameters, StashPickerOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string tpl })
        {
            _model!.Stash.Add(new ItemSpecModel { Tpl = tpl });
            RecomputeLoadoutCost();
        }
    }

    /// <summary>Deep copy via the spec round-trip (ToSpec → FromSpec), inserted right below the original.</summary>
    private void DuplicateStashLine(ItemSpecModel line)
    {
        var clone = ItemSpecModel.FromSpec(line.ToSpec());
        _model!.Stash.Insert(_model.Stash.IndexOf(line) + 1, clone);
        RecomputeLoadoutCost();
    }

    private async Task RemoveStashLineAsync(ItemSpecModel line)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Remove stash line",
            "Remove this item line (and everything nested in it) from the stash?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            _model!.Stash.Remove(line);
            RecomputeLoadoutCost();
        }
    }

    /// <summary>
    ///     Capacity verdict (item 028): green = everything fits; orange = overflow lines listed (the
    ///     server skips them with a warning); info = grid unresolved. Extra dry-run notes (pre-existing
    ///     base stash items, malformed lines) render as separate info alerts.
    /// </summary>
    private RenderFragment StashCapacityAlert() => __builder =>
    {
        if (_stashCapacity is not { } cap)
        {
            return;
        }

        if (!cap.GridResolved)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Stash capacity not checked — @(cap.Warnings.Count > 0 ? string.Join(" ", cap.Warnings) : "stash grid unresolved.")
            </MudAlert>
        }
        else
        {
            var grid = $"{string.Join(" + ", cap.GridSizes)} of base '{cap.BaseEdition}'";
            if (cap.Unplaced.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                    Fits — @cap.OccupancyPercent.ToString("0.#", CultureInfo.InvariantCulture)% occupied
                    (@cap.UsedCells/@cap.TotalCells cells, stash @grid).
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    @cap.Unplaced.Count item line(s) won't fit: @string.Join(", ", cap.Unplaced) —
                    the server will skip them with a warning
                    (@cap.OccupancyPercent.ToString("0.#", CultureInfo.InvariantCulture)% occupied, stash @grid).
                </MudAlert>
            }

            @foreach (var warning in cap.Warnings)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@warning</MudAlert>
            }
        }
    };

