        }
    }

    /// <summary>
    ///     Item 031: skill name → XP factor for the canonical list's ±% chip. Tolerant aggregation
    ///     (B1 — a hand-written file may repeat a skill; ToDictionary would throw): first occurrence
    ///     wins, mirroring ClassEditModel.ToDict.
    /// </summary>
    private Dictionary<string, double> MultiplierLookup()
    {
        var d = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _model!.Multipliers)
        {
            if (!string.IsNullOrWhiteSpace(m.Skill))
            {
                d.TryAdd(m.Skill, m.Factor);
            }
        }

        return d;
    }

