@using SPTarkov.Server.Core.Models.Common

@* Item 023: lista os presets de uma arma/armadura (CatalogService.GetPresetsFor) com chips
   Standard/Premium iguais ao que o InventoryBuilder resolve para `preset: <tpl>` + `premium: true`.
   Clique numa linha dispara OnPresetSelected com o id do preset. O id mongo fica só no tooltip
   (UX: era ruído na tabela antiga); a linha mostra nome + nº de peças + chips + marca de selecionado. *@

@inject CatalogService Catalog

<MudStack Spacing="1">
    @if (string.IsNullOrWhiteSpace(WeaponTpl))
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No item selected.</MudText>
    }
    else if (_presets.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No presets found for this item.</MudText>
    }
    else
    {
        <div class="cc-preset-list">
            @foreach (var p in _presets)
            {
                var selected = string.Equals(p.Id, SelectedPresetId, StringComparison.Ordinal);
                <div class="cc-preset-row @(selected ? "cc-preset-row--sel" : null)"
                     title="@p.Id" @onclick="@(() => SelectAsync(p))">
                    <div class="cc-preset-row__main">
                        <span class="cc-preset-row__name">@(p.Name ?? "Unnamed preset")</span>
                        <span class="cc-preset-row__sub">@p.ItemCount parts</span>
                    </div>
                    @if (p.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Standard</MudChip>
                    }
                    @if (p.IsPremium)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Premium</MudChip>
                    }
                    @if (selected)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small"/>
                    }
                </div>
            }
        </div>
    }
</MudStack>

@code {
    /// <summary>Root weapon/armor tpl whose presets are listed.</summary>
    [Parameter] public string? WeaponTpl { get; set; }

    /// <summary>Currently selected preset id (highlighted with a check) — null when on Standard/Premium.</summary>
    [Parameter] public string? SelectedPresetId { get; set; }

    /// <summary>Fired with the selected preset id.</summary>
    [Parameter] public EventCallback<string> OnPresetSelected { get; set; }

    private List<CatalogPreset> _presets = [];
    private string? _loadedTpl;

    protected override void OnParametersSet()
    {
        if (string.Equals(WeaponTpl, _loadedTpl, StringComparison.Ordinal))
        {
            return;
        }

        _loadedTpl = WeaponTpl;
        // MongoId(string) throws on malformed ids — guard so a half-typed tpl can't kill the circuit.
        _presets = WeaponTpl is not null && MongoId.IsValidMongoId(WeaponTpl)
            ? Catalog.GetPresetsFor(new MongoId(WeaponTpl))
            : [];
    }

    private Task SelectAsync(CatalogPreset? preset) =>
        preset is null ? Task.CompletedTask : OnPresetSelected.InvokeAsync(preset.Id);
}
