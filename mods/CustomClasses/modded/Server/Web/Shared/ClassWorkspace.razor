@* Fase F1/F2 (rascunho): workspace unificado de 3 painéis, estilo inventário EFT. Recebe a
   ClassDefinition já carregada (parse+diagnostics ficam no ClassDetail) + os custos já computados.
     • header slim: badges (skill cost / loadout ₽) + botão EDIT (read) / SAVE+DISCARD (edit);
     • ESQUERDA: skills (SkillCanonicalList) + multipliers + hideout + outfit simbólico;
     • CENTRO: CharacterDoll (paper doll dos equipados);
     • DIREITA: StashGrid (grade 2D do stash).
   Cada painel rola só internamente (single-screen). O polimento visual fica pro orquestrador.

   ── F2a: EDIÇÃO IN-PLACE ────────────────────────────────────────────────────────────────────
   Em vez de linkar pra /edit, o botão EDIT liga _editMode=true E navega pra .../edit (replace:true)
   só pra a URL acompanhar (refresh preserva: a rota /edit monta o workspace com InitialEdit=true).
   A LÓGICA migra inteira do antigo ClassEdit.razor:
     • _model = ClassEditModel.FromDefinition(def) ao entrar em editMode;
     • Save = FlushPendingRecompute + ToDefinition + EditorService.Save(hotApply:true) + sai do edit + recarrega;
     • Discard = descarta _model + sai do edit;
     • EditGuardState (CascadingParameter) p/ guard de unsaved; Ctrl+S (window.ccPrefs.registerSaveShortcut);
     • recompute debounced (037) → custo ao vivo no header slim.
   O painel esquerdo vira editável (SkillCanonicalList Editable, multipliers add/remove, hideout add/remove)
   e o outfit-preview vira clicável → SkinPickerDialog. StashGrid/CharacterDoll recebem Editable (no-op
   visual por enquanto — F2c do orquestrador: DnD do stash + clicar-slot-equipado). *@

@using System.Globalization
@using SPTarkov.Server.Core.Models.Enums
@using SPTarkov.Server.Core.Models.Enums.Hideout
@using SPTarkov.Server.Core.Models.Common
@using CustomClasses.Web
@implements IDisposable
@inject CatalogService Catalog
@inject ClassEditorService EditorService
@inject CostService CostService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

@if (Definition is null)
{
    <MudText Typo="Typo.body2">No parsed class to display.</MudText>
}
else
{
    var def = Definition;
    // Camada 4 (fluidez): re-@key o span pelo valor exibido → quando o recompute muda o número,
    // o Blazor recria o elemento e o .cc-pulse roda 1× (auto-reset). Sem custo extra.
    var skillCostStr = LiveSkillCost?.Total.ToString("0.00", CultureInfo.InvariantCulture) ?? "—";
    var loadoutStr = LiveLoadoutCost is null ? "—" : FormatRub(LiveLoadoutCost.TotalRub);
    var loadoutTraderStr = LiveLoadoutCost is null ? null : FormatRub(LiveLoadoutCost.TotalHandbook);

    <div class="cc-ws @(_editMode ? "cc-ws--edit" : null)">
        @* Camada 3 (fluidez): overlay + spinner sobre o workspace durante o Save (hot-apply off-circuit). *@
        <MudOverlay Visible="@_saving" Absolute="true" DarkBackground="false" Class="cc-ws__overlay">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large"/>
        </MudOverlay>
        @* ── Slim metrics bar + ações (Edit / Save+Discard) ── *@
        <div class="cc-ws__header">
            <div class="cc-ws__badges">
                <span class="cc-ws__badge">
                    <span class="cc-ws__badge-label">Skill cost</span>
                    <span @key="skillCostStr" class="cc-ws__badge-val cc-pulse">@skillCostStr</span>
                </span>
                <span class="cc-ws__badge">
                    <span class="cc-ws__badge-label">Loadout (flea · trader)</span>
                    <span @key="loadoutStr" class="cc-ws__badge-val cc-pulse">@loadoutStr@if (loadoutTraderStr is not null){<span class="cc-ws__badge-sub"> · @loadoutTraderStr</span>}</span>
                </span>
            </div>

            <div class="cc-ws__actions">
                @* Sempre em edição (item: removido o modo view). O guard de unsaved + Discard são o
                   "fallback" — Save grava, Discard reverte ao disco; ambos mantêm a tela em edição. *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || !IsDirty)" OnClick="@(async () => await SaveAsync())">
                    @(_saving ? "Saving…" : "Save")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Restore"
                           Disabled="@(_saving || !IsDirty)" OnClick="DiscardEdit">
                    Discard
                </MudButton>
                @if (IsDirty)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">unsaved</MudChip>
                }
            </div>
        </div>

        @* ── Save outcome (edit mode) ── *@
        @if (_editMode && _saveDiagnostics.Count > 0)
        {
            @foreach (var d in _saveDiagnostics)
            {
                <MudAlert Severity="@MapSeverity(d.Severity)" Dense="true" Class="mb-1">
                    [@d.Code] @d.Message
                </MudAlert>
            }
        }

        @* ── 3 colunas ──────────────────────────────────────────────────────── *@
        <div class="cc-ws__grid">

            @* ░ ESQUERDA ░ *@
            <div class="cc-ws__panel cc-ws__panel--left">

                @* ── Skills ── *@
                <div class="cc-section">
                    <div class="cc-section__title">Skills (@SkillsCount)</div>
                    @if (_editMode && _model is not null)
                    {
                        <SkillCanonicalList Editable="true"
                                            EditRows="@_model.Skills"
                                            Cost="@LiveSkillCost"
                                            Multipliers="@MultiplierLookup()"
                                            EditMultipliers="@_model.Multipliers"
                                            BaselineLevels="@def.Skills"
                                            BaselineMultipliers="@def.SkillMultipliers"
                                            OnLevelChanged="OnSkillsEdited"
                                            OnMultipliersChanged="OnSkillsEdited"/>
                    }
                    else
                    {
                        <SkillCanonicalList Levels="@def.Skills"
                                            Cost="@SkillCost"
                                            Multipliers="@def.SkillMultipliers"
                                            Editable="false"/>
                    }
                </div>

                @* XP multipliers: editados IN-ROW na própria SkillCanonicalList (clique no chip de % →
                   popup com slider de 5%). A seção separada foi removida. *@

                @* ── Hideout ── *@
                <div class="cc-section">
                    <div class="cc-section__title">Hideout (@HideoutCount)</div>
                    @if (_editMode && _model is not null)
                    {
                        @if (_model.Hideout.Count > 0)
                        {
                            <div class="cc-hideout-list">
                                @foreach (var row in _model.Hideout)
                                {
                                    <div class="cc-hideout-row" @key="row">
                                        <MudIcon Icon="@StationIcon(row.Station)" Size="Size.Small" Class="cc-hideout-row__icon"/>
                                        <span class="cc-hideout-row__name">@StationLabel(row.Station)</span>
                                        <MudNumericField T="int" @bind-Value="row.Level"
                                                         @bind-Value:after="MarkDirty"
                                                         Min="1" Margin="Margin.Dense" Label="level"
                                                         Variant="Variant.Outlined" Style="max-width:78px;"/>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" title="Remove station"
                                                       OnClick="@(() => RemoveStation(row))"/>
                                    </div>
                                }
                            </div>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudSelect T="string" @bind-Value="_newStation" Label="Add station"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                       Style="min-width:220px">
                                @foreach (var name in AvailableStations())
                                {
                                    <MudSelectItem T="string" Value="@name">
                                        <div class="cc-hideout-opt">
                                            <MudIcon Icon="@StationIcon(name)" Size="Size.Small"/>
                                            <span>@StationLabel(name)</span>
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@string.IsNullOrEmpty(_newStation)" OnClick="AddStation"
                                           title="Add station"/>
                        </MudStack>
                    }
                    else if (def.Hideout is { Count: > 0 })
                    {
                        <div class="cc-hideout-grid">
                            @foreach (var (station, lvl) in def.Hideout)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                         Icon="@StationIcon(station)">@StationLabel(station) · L@lvl</MudChip>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">No hideout station overrides.</MudText>
                    }
                </div>

            </div>

            @* ░ CENTRO ░ *@
            <div class="cc-ws__panel cc-ws__panel--center">
                <div class="cc-section__title">Equipped (@EquippedCount slots) <span class="cc-section__sum">@FormatRub(EquippedRub) <span class="cc-section__sum-trader">flea · @FormatRub(EquippedHb) trader</span></span></div>
                <CharacterDoll Equipped="@EquippedForView" Editable="@_editMode" OnSlotClick="EditSlotAsync"/>

                @* ── Outfit (movido pro painel EQUIPPED — é a aparência do personagem) ── *@
                <div class="cc-section cc-ws__outfit-section">
                    <div class="cc-section__title">Outfit</div>
                    <div class="cc-ws__outfit">
                        @if (_editMode && _model is not null)
                        {
                            @EditOutfitCard("USEC", "Upper", "Usec", () => _model.UsecUpper, v => _model.UsecUpper = v)
                            @EditOutfitCard("USEC", "Lower", "Usec", () => _model.UsecLower, v => _model.UsecLower = v)
                            @EditOutfitCard("BEAR", "Upper", "Bear", () => _model.BearUpper, v => _model.BearUpper = v)
                            @EditOutfitCard("BEAR", "Lower", "Bear", () => _model.BearLower, v => _model.BearLower = v)
                        }
                        else
                        {
                            @OutfitCard("USEC", "Upper", def.Outfit?.Usec?.Upper)
                            @OutfitCard("USEC", "Lower", def.Outfit?.Usec?.Lower)
                            @OutfitCard("BEAR", "Upper", def.Outfit?.Bear?.Upper)
                            @OutfitCard("BEAR", "Lower", def.Outfit?.Bear?.Lower)
                        }
                    </div>
                </div>
            </div>

            @* ░ DIREITA ░ *@
            <div class="cc-ws__panel cc-ws__panel--right">
                <div class="cc-ws__panel-head">
                    <div class="cc-section__title">Stash (@StashCount lines) <span class="cc-section__sum">@FormatRub(StashRub) <span class="cc-section__sum-trader">flea · @FormatRub(StashHb) trader</span></span></div>
                    @if (_editMode && _model is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddStashItemAsync">
                            Add item
                        </MudButton>
                    }
                </div>
                <StashGrid Stash="@StashForView" BaseEdition="@def.BaseEdition" Editable="@_editMode"
                           EditItems="@(_editMode ? _model?.Stash : null)"
                           Revision="@_loadoutRevision"
                           OnChanged="OnLoadoutEdited"
                           OnItemClick="EditStashItemAsync"/>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Classe já parseada (parse/diagnostics ficam no ClassDetail). Null → nada a mostrar.</summary>
    [Parameter] public ClassDefinition? Definition { get; set; }

    /// <summary>Nome do arquivo SEM extensão (para o link de EDIT e fallback de título).</summary>
    [Parameter] public string FileNameBare { get; set; } = "";

    /// <summary>Custo de skills já computado (CostService.ComputeSkillCost) — modo read.</summary>
    [Parameter] public SkillCostBreakdown? SkillCost { get; set; }

    /// <summary>Custo de loadout já computado (CostService.ComputeLoadoutCost) — modo read.</summary>
    [Parameter] public LoadoutCostBreakdown? LoadoutCost { get; set; }

    /// <summary>Status do arquivo (Registered/Disabled/Invalid/Not registered) — passado pelo ClassDetail.</summary>
    [Parameter] public ClassFileEntry? Entry { get; set; }

    /// <summary>F2a: a rota /edit monta o workspace JÁ em edição (refresh preserva). false = começa em read.</summary>
    [Parameter] public bool InitialEdit { get; set; }

    /// <summary>F2a: callback opcional p/ a página recarregar a definição do disco após um Save bem-sucedido.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Item 030: guard de unsaved (per-circuit POCO via CascadingValue no BaseLayout).</summary>
    [CascadingParameter] private BaseLayout.EditGuardState? Guard { get; set; }

    // ── Estado de edição (F2a) ────────────────────────────────────────────────
    private bool _editMode;
    private ClassEditModel? _model;
    private string? _resolvedFileName;            // nome real do arquivo (alvo do Save)
    private List<ClassDiagnostic> _saveDiagnostics = [];
    private SkillCostBreakdown? _editSkillCost;
    private LoadoutCostBreakdown? _editLoadoutCost;
    private bool _saving;

    private string _newStation = string.Empty;

    // Ctrl+S (item 035)
    private DotNetObjectReference<ClassWorkspace>? _dotNetRef;
    private bool _shortcutRegistered;

    // recompute debounce (item 037)
    private System.Threading.CancellationTokenSource? _recomputeCts;
    private bool _disposed;

    // outfit id → nome (ambas as facções) — read mode
    private Dictionary<string, string> _clothingNames = new(StringComparer.Ordinal);

    // ── Views: edit usa o _model; read usa a Definition ────────────────────────
    private SkillCostBreakdown? LiveSkillCost => _editMode ? _editSkillCost : SkillCost;
    private LoadoutCostBreakdown? LiveLoadoutCost => _editMode ? _editLoadoutCost : LoadoutCost;

    private int SkillsCount => _editMode && _model is not null ? _model.Skills.Count : Definition?.Skills?.Count ?? 0;
    private int HideoutCount => _editMode && _model is not null ? _model.Hideout.Count : Definition?.Hideout?.Count ?? 0;
    private int EquippedCount => _editMode && _model is not null ? _model.Equipped.Count : Definition?.Loadout?.Equipped?.Count ?? 0;
    private int StashCount => _editMode && _model is not null ? _model.Stash.Count : Definition?.Loadout?.Stash?.Count ?? 0;

    // Somatório ₽ por painel (cabeçalho) = soma do VALOR DE BUILD de cada item (root + peças + ammo +
    // contents, com count) — bate com o que cada tooltip mostra e cobre ammo/contents (antes ficavam de
    // fora). Em edição é cacheado no RecomputeLoadoutCost (não recomputa a cada slider); em read deriva
    // da Definition (renderiza poucas vezes).
    private double _equippedRub, _stashRub, _equippedHb, _stashHb;
    private double EquippedRub => _editMode && _model is not null
        ? _equippedRub
        : Definition?.Loadout?.Equipped?.Values.Sum(s => CostService.ItemBuildValue(s, true)) ?? 0;
    private double StashRub => _editMode && _model is not null
        ? _stashRub
        : Definition?.Loadout?.Stash?.Sum(s => CostService.ItemBuildValue(s, false)) ?? 0;
    // Valor de trader/handbook (base aterrada) por painel — contraste do flea especulativo (item 037 UX).
    private double EquippedHb => _editMode && _model is not null
        ? _equippedHb
        : Definition?.Loadout?.Equipped?.Values.Sum(s => CostService.ItemBuildValueDual(s, true).Handbook) ?? 0;
    private double StashHb => _editMode && _model is not null
        ? _stashHb
        : Definition?.Loadout?.Stash?.Sum(s => CostService.ItemBuildValueDual(s, false).Handbook) ?? 0;

    // PERF: os snapshots da doll/stash são CACHEADOS (rebuild só quando o loadout muda — RebuildLoadoutViews),
    // NÃO recomputados a cada render. Antes, EquippedForView/StashForView chamavam _model.ToDefinition()
    // (rebuild completo) 2× por render; cada step do slider de skill disparava isso + re-pack do stash →
    // lag. Agora mudança de skill não toca esses caches (referência estável → os filhos pulam o rebuild).
    private Dictionary<string, ItemSpec>? _equippedView;
    private List<ItemSpec>? _stashView;

    /// <summary>Recomputa os snapshots da doll/stash a partir do _model — chamado só ao montar e ao editar o loadout.</summary>
    // Token incrementado a cada (re)build do loadout. O StashGrid edita a lista VIVA (_model.Stash), cuja
    // REFERÊNCIA não muda ao adicionar/remover/editar item — então o grid precisa de um sinal explícito
    // pra reconstruir. Só muda em edições de loadout (skill slider não chama isto → sem rebuild à toa).
    private int _loadoutRevision;

    private void RebuildLoadoutViews()
    {
        _loadoutRevision++;
        if (_model is null)
        {
            _equippedView = null;
            _stashView = null;
            return;
        }

        var def = _model.ToDefinition();
        _equippedView = def.Loadout?.Equipped;
        _stashView = def.Loadout?.Stash;
    }

    /// <summary>Equipados desenhados na doll: snapshot cacheado em edição, senão a Definition.</summary>
    private Dictionary<string, ItemSpec>? EquippedForView =>
        _editMode && _model is not null ? _equippedView : Definition?.Loadout?.Equipped;

    /// <summary>Stash desenhado na grade: snapshot cacheado em edição, senão a Definition.</summary>
    private List<ItemSpec>? StashForView =>
        _editMode && _model is not null ? _stashView : Definition?.Loadout?.Stash;

    protected override void OnParametersSet()
    {
        // Sempre-edição: (re)monta o modelo sempre que a Definition muda — nova classe (troca pela
        // sidebar) ou recarga pós-save. A MESMA instância do workspace é reusada entre navegações,
        // por isso comparamos a referência da Definition (e não rebuildamos a cada render).
        if (Definition is not null && !ReferenceEquals(Definition, _modelSource))
        {
            _modelSource = Definition;
            LoadClothingNames();
            EnterEditFor(Definition);
        }
    }

    private ClassDefinition? _modelSource;

    /// <summary>id → nome p/ os labels do outfit (ambas as facções) — recarregado por classe.</summary>
    private void LoadClothingNames()
    {
        _clothingNames = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var side in new[] { "Usec", "Bear" })
        {
            foreach (var piece in Catalog.GetClothing(side))
            {
                if (!string.IsNullOrWhiteSpace(piece.Name))
                {
                    _clothingNames[piece.Id] = piece.Name!;
                }
            }
        }
    }

    // ── Sempre em edição: monta o modelo, registra os handlers do guard (sem marcar dirty) ──────

    /// <summary>
    ///     Monta o ClassEditModel da classe atual, computa os custos ao vivo e registra Save/Discard no
    ///     guard. NÃO marca dirty — a classe recém-carregada está limpa; o dirty só liga na 1ª mudança
    ///     real (MarkDirty), pra que trocar de classe sem editar NÃO dispare o diálogo de unsaved.
    /// </summary>
    private void EnterEditFor(ClassDefinition def)
    {
        _resolvedFileName = ResolveFileName();
        _model = ClassEditModel.FromDefinition(def);
        _editMode = true;
        _saveDiagnostics = [];
        RecomputeSkillCost();
        RecomputeLoadoutCost();
        RebuildLoadoutViews();
        RegisterGuardHandlers();
        if (Guard is not null)
        {
            Guard.IsDirty = false;
        }
    }

    /// <summary>Discard: reverte o modelo ao estado do disco (Definition atual) e limpa o dirty — sem sair da edição.</summary>
    private void DiscardEdit()
    {
        if (Definition is not null)
        {
            _model = ClassEditModel.FromDefinition(Definition);
        }

        _saveDiagnostics = [];
        _newStation = string.Empty;
        RecomputeSkillCost();
        RecomputeLoadoutCost();
        RebuildLoadoutViews();
        if (Guard is not null)
        {
            Guard.IsDirty = false;
        }

        Snackbar.Add("Changes discarded.", Severity.Info);
    }

    /// <summary>Resolve route name (bare ou exato) → nome real do arquivo (mesma lógica do ClassDetail/ClassEdit).</summary>
    private string? ResolveFileName()
    {
        if (Entry?.FileName is { Length: > 0 } fn)
        {
            return fn;
        }

        if (string.IsNullOrWhiteSpace(FileNameBare))
        {
            return null;
        }

        var entries = EditorService.ListClassFiles();
        var entry = entries.FirstOrDefault(e => string.Equals(e.FileName, FileNameBare, StringComparison.OrdinalIgnoreCase))
                    ?? entries.FirstOrDefault(e => string.Equals(
                        System.IO.Path.GetFileNameWithoutExtension(e.FileName), FileNameBare, StringComparison.OrdinalIgnoreCase));
        return entry?.FileName;
    }

    // ── Save (migrado do ClassEdit) ─────────────────────────────────────────────

    private async Task<bool> SaveAsync()
    {
        if (_model is null || _resolvedFileName is null)
        {
            // review #3: não falhar em silêncio — Save/Ctrl+S precisa avisar quando não há alvo resolvido.
            Snackbar.Add("Could not resolve the class file to save — reload the class and try again.", Severity.Error);
            return false;
        }

        // Item 037: um Save pode cair dentro da janela de debounce — força o recompute pendente
        // (capacity incluída) antes de tirar o snapshot da definição a persistir.
        FlushPendingRecompute();

        _saving = true;
        try
        {
            // CR2-EP-09: snapshot da definição NA thread do circuito (a UI fica editável durante o save).
            var def = _model.ToDefinition();
            var result = await Task.Run(() => EditorService.Save(_resolvedFileName, def, hotApply: true));
            _saveDiagnostics = result.Diagnostics;
            if (result.Success)
            {
                Snackbar.Add("Class saved and hot-applied.", Severity.Success);
                if (Guard is not null)
                {
                    Guard.IsDirty = false;   // limpo de novo; permanece em edição
                }

                // A página recarrega a Definition do disco (nova instância) → OnParametersSet
                // remonta o _model. Continuamos NA edição (sem navegar) — o modo view foi removido.
                if (OnSaved.HasDelegate)
                {
                    await OnSaved.InvokeAsync();
                }

                return true;
            }

            Snackbar.Add("Save blocked by validation — nothing was written.", Severity.Error);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Guard de unsaved (item 030) + Ctrl+S (item 035) ─────────────────────────

    /// <summary>Há mudanças não salvas? (espelha o guard do circuito.)</summary>
    private bool IsDirty => Guard?.IsDirty ?? false;

    /// <summary>
    ///     Registra Save/Discard no guard SEM marcar dirty. O guard só dispara o diálogo quando IsDirty
    ///     liga (1ª mudança real via MarkDirty) — assim, abrir/trocar de classe sem editar NÃO pergunta.
    ///     O Discard do guard (saída com mudanças → "Discard") reverte o modelo ao disco e limpa o dirty.
    /// </summary>
    private void RegisterGuardHandlers()
    {
        if (Guard is null)
        {
            return;
        }

        Guard.SaveAsync = SaveAsync;
        Guard.Discard = () =>
        {
            if (Definition is not null)
            {
                _model = ClassEditModel.FromDefinition(Definition);
            }

            if (Guard is not null)
            {
                Guard.IsDirty = false;
            }
        };
    }

    /// <summary>Liga o dirty na 1ª mudança real (qualquer mutação do modelo chama isto).</summary>
    private void MarkDirty()
    {
        if (Guard is not null && !Guard.IsDirty)
        {
            Guard.IsDirty = true;
        }
    }

    /// <summary>MarkDirty + recompute do custo de skills (handler das mutações de skills/multipliers).</summary>
    private void OnSkillsEdited()
    {
        MarkDirty();
        RecomputeSkillCost();
    }

    /// <summary>MarkDirty + recompute do custo de loadout + rebuild dos snapshots da doll/stash.</summary>
    private void OnLoadoutEdited()
    {
        MarkDirty();
        RecomputeLoadoutCost();
        RebuildLoadoutViews();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_shortcutRegistered)
        {
            _shortcutRegistered = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("ccPrefs.registerSaveShortcut", _dotNetRef);
            }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
    }

    /// <summary>Ctrl/Cmd+S → Save. Roda FORA do render context → marshalled via InvokeAsync (igual ao botão).</summary>
    [JSInvokable]
    public async Task OnSaveShortcut() =>
        await InvokeAsync(async () =>
        {
            if (_saving || !_editMode)
            {
                return;
            }

            await SaveAsync();
        });

    // ── Recompute (item 037) ────────────────────────────────────────────────────

    private void RecomputeSkillCost()
    {
        if (_model is not null)
        {
            _editSkillCost = CostService.ComputeSkillCost(_model.ToDefinition());
        }
    }

    private void RecomputeLoadoutCost()
    {
        if (_model is not null)
        {
            var def = _model.ToDefinition();
            _editLoadoutCost = CostService.ComputeLoadoutCost(def);
            var eq = def.Loadout?.Equipped?.Values.Select(s => CostService.ItemBuildValueDual(s, true)).ToList() ?? [];
            var st = def.Loadout?.Stash?.Select(s => CostService.ItemBuildValueDual(s, false)).ToList() ?? [];
            _equippedRub = eq.Sum(v => v.Flea);
            _stashRub = st.Sum(v => v.Flea);
            _equippedHb = eq.Sum(v => v.Handbook);
            _stashHb = st.Sum(v => v.Handbook);
        }
    }

    /// <summary>Debounce ~250 ms — agrupa keystrokes (factor/level). Add/remove de linha é discreto (chama direto).</summary>
    private void ScheduleRecompute()
    {
        _recomputeCts?.Cancel();
        var cts = _recomputeCts = new System.Threading.CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(250, cts.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            RecomputeLoadoutCost();
            if (!_disposed)
            {
                try
                {
                    StateHasChanged();
                }
                catch (ObjectDisposedException) { }
            }
        });
    }

    private void FlushPendingRecompute()
    {
        _recomputeCts?.Cancel();
        RecomputeSkillCost();
        RecomputeLoadoutCost();
    }

    public void Dispose()
    {
        _disposed = true;
        _recomputeCts?.Cancel();
        _recomputeCts?.Dispose();

        if (_shortcutRegistered)
        {
            try
            {
                _ = JS.InvokeVoidAsync("ccPrefs.unregisterSaveShortcut");
            }
            catch { }
        }

        _dotNetRef?.Dispose();
        // Não chamamos Guard.Reset() aqui: o BaseLayout pode dispor antes do save concluir.
    }

    // ── Multipliers / hideout (add/remove) — migrado do ClassEdit ───────────────

    private Dictionary<string, double> MultiplierLookup()
    {
        var d = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _model!.Multipliers)
        {
            if (!string.IsNullOrWhiteSpace(m.Skill))
            {
                d.TryAdd(m.Skill, m.Factor);
            }
        }

        return d;
    }

    private IEnumerable<string> AvailableStations()
    {
        var taken = new HashSet<string>(_model!.Hideout.Select(r => r.Station), StringComparer.OrdinalIgnoreCase);
        return Enum.GetNames<HideoutAreas>()
            .Where(n => !string.Equals(n, nameof(HideoutAreas.NotSet), StringComparison.Ordinal) && !taken.Contains(n))
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);
    }


    private void AddStation()
    {
        if (!string.IsNullOrEmpty(_newStation))
        {
            var name = _newStation;
            _model!.Hideout.Add(new HideoutRow { Station = name, Level = 1 });
            _newStation = string.Empty;
            MarkDirty();
            Snackbar.Add($"Hideout station '{StationLabel(name)}' added (level 1).", Severity.Success);
        }
    }

    private void RemoveStation(HideoutRow row)
    {
        _model!.Hideout.Remove(row);
        MarkDirty();
        Snackbar.Add($"Hideout station '{StationLabel(row.Station)}' removed.", Severity.Info);
    }

