@* Fase F2c: editor in-place de UM slot de equipamento, aberto ao clicar no slot da silhueta
   (CharacterDoll → ClassWorkspace.EditSlotAsync). Hospeda o ItemSpecEditor (item 026) ligado ao
   ItemSpecModel do slot, com o filtro do EquipmentSlot (Catalog.IsAllowedInEquipmentSlot) como
   TplFilter. O ItemSpecModel é mutado EM LUGAR — o Discard da sessão de edição faz o rollback global.
     • "Done"  → fecha Ok("keep"): o workspace mantém (e, se era um slot novo com item, adiciona);
     • "Clear" → fecha Ok("clear"): o workspace remove o slot;
     • Cancel  → fecha cancelado: o workspace trata como "keep" (edições já estão no modelo). *@

@using CustomClasses.Web

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@SlotName</MudText>
    </TitleContent>
    <DialogContent>
        <ItemSpecEditor Spec="@Item" TplFilter="@Filter" OnChanged="OnEditorChanged"/>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                   OnClick="@(() => Dialog?.Close(DialogResult.Ok("clear")))">
            Clear slot
        </MudButton>
        <MudButton OnClick="@(() => Dialog?.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => Dialog?.Close(DialogResult.Ok("keep")))">
            Done
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }

    /// <summary>Modelo mutável do item neste slot (editado em lugar pelo ItemSpecEditor).</summary>
    [Parameter, EditorRequired] public ItemSpecModel Item { get; set; } = default!;

    /// <summary>Nome do EquipmentSlot (título + semântica do filtro).</summary>
    [Parameter] public string SlotName { get; set; } = string.Empty;

    /// <summary>Filtro do slot (Catalog.IsAllowedInEquipmentSlot) — restringe o ItemPicker do editor.</summary>
    [Parameter] public Func<string, bool>? Filter { get; set; }

    /// <summary>Bubble opcional p/ o workspace recomputar o custo ao vivo enquanto edita.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task OnEditorChanged()
    {
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }

        StateHasChanged();
    }
}
