@* Item 034: reusable hover tooltip for a gear/stash item cell. Wraps the cell (ChildContent)
   in a MudTooltip whose TooltipContent is a premium card: item image (with category fallback),
   bold name, category, W×H size, qty, flea price + source (or a "no price" warning). Hover only.
   Fields resolved server-side by the caller (GearPanel / CharacterDoll / StashGrid) via CatalogService. *@

@using System.Globalization

<MudTooltip Placement="Placement.Top" Arrow="true">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <TooltipContent>
        <div class="cc-item-tip">
            @if (IconId is { Length: > 0 })
            {
                <img class="cc-item-tip__img" src="@($"https://assets.tarkov.dev/{IconId}-icon.webp")"
                     alt="" draggable="false"
                     data-fb="@(IconId != RootTpl ? RootTpl : null)" data-cat="@CategoryIcon"
                     onerror="if(this.dataset.fb){this.src='https://assets.tarkov.dev/'+this.dataset.fb+'-icon.webp';this.dataset.fb='';}else if(this.dataset.cat){this.src=this.dataset.cat;this.dataset.cat='';this.classList.add('cc-item-tip__img--cat');}else{this.style.display='none';}"/>
            }
            <div class="cc-item-tip__name">@Name</div>
            @if (!string.IsNullOrWhiteSpace(Category))
            {
                <div class="cc-item-tip__cat">@Category</div>
            }
            <div class="cc-item-tip__meta">
                <span>@Width×@Height</span>
                @if (Qty is > 1)
                {
                    <span>· qty @Qty.Value.ToString("N0", CultureInfo.InvariantCulture)</span>
                }
                @if (Contents > 0)
                {
                    <span>· @Contents inside</span>
                }
            </div>
            <div class="cc-item-tip__price">
                @if (MissingPrice)
                {
                    <span class="cc-item-tip__warn">⚠ no flea/handbook price</span>
                }
                else
                {
                    <span class="mud-text-secondary">base </span><b>@Price.ToString("N0", CultureInfo.InvariantCulture) ₽</b>
                    <span class="cc-item-tip__src"> flea</span>
                    @* Valor de trader/handbook (base "aterrada") lado a lado com o flea especulativo. *@
                    @if (HandbookPrice > 0)
                    {
                        <span class="cc-item-tip__trader"> · @HandbookPrice.ToString("N0", CultureInfo.InvariantCulture) ₽ trader</span>
                    }
                }
            </div>
            @* Valor da build montada (peças do preset/mods + ammo + contents, com count) — explica por que
               um item "pesa" mais que o tpl base no somatório do painel. Só quando difere do base. *@
            @if (BuildValue > Price + 1)
            {
                <div class="cc-item-tip__build">
                    assembled <b>@BuildValue.ToString("N0", CultureInfo.InvariantCulture) ₽</b><span class="cc-item-tip__src"> flea</span>
                    @if (HandbookBuildValue > 0)
                    {
                        <span class="cc-item-tip__trader"> · @HandbookBuildValue.ToString("N0", CultureInfo.InvariantCulture) ₽ trader</span>
                    }
                </div>
            }
        </div>
    </TooltipContent>
</MudTooltip>

@code {
    /// <summary>The cell rendered as the hover target (the dimensioned icon + label).</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Category { get; set; }
    [Parameter] public int Width { get; set; } = 1;
    [Parameter] public int Height { get; set; } = 1;
    [Parameter] public double Price { get; set; }
    [Parameter] public string? PriceSource { get; set; }
    [Parameter] public double? Qty { get; set; }
    [Parameter] public bool MissingPrice { get; set; }

    /// <summary>tarkov.dev icon id (preset or tpl) shown big in the tooltip; falls back to RootTpl/category.</summary>
    [Parameter] public string? IconId { get; set; }
    [Parameter] public string? RootTpl { get; set; }
    [Parameter] public string? CategoryIcon { get; set; }

    /// <summary>Items inside this container (rig/backpack) — shown as "N inside".</summary>
    [Parameter] public int Contents { get; set; }

    /// <summary>Total value of the assembled build (root + parts + ammo + contents). Shown when &gt; base price.</summary>
    [Parameter] public double BuildValue { get; set; }

    /// <summary>Trader/handbook base price (per unit) shown next to the flea base. 0 hides the trader column.</summary>
    [Parameter] public double HandbookPrice { get; set; }

    /// <summary>Trader/handbook value of the assembled build, shown next to the flea assembled value. 0 hides it.</summary>
    [Parameter] public double HandbookBuildValue { get; set; }
}
