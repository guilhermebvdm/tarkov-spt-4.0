@* Fase F1/F2c: grade 2D do stash estilo inventário EFT. Dimensiona a grade pela baseEdition
   (CostService.GetStashGridSize; fallback 10×40) e posiciona cada item loose:
     • com X/Y → célula fixa (GridPacker.TryPlaceAt, rotação por Rotated);
     • sem coord → first-fit sequencial (GridPacker.Place) nas células livres.
   Cada item: ícone (padrão GearPanel: tarkov.dev, onerror-hidden), badge de qty (>1), hover ItemTooltip.

   ── F2c: DRAG-AND-DROP (modo edição) ────────────────────────────────────────────────────────
   Quando Editable E EditItems (a List<ItemSpecModel> VIVA do _model.Stash) é fornecida, os itens
   ficam draggable e a grade vira drop-zone única. O cálculo da célula é Blazor-nativo (SEM JS):
     • drop na .cc-grid2d → OffsetX/Y do DragEventArgs / CellPx = célula alvo;
     • durante o drag, .cc-grid2d--dragging zera pointer-events dos itens, então o drop SEMPRE cai
       na grade (offset relativo a ela) mesmo soltando sobre outro item.
   Soltar valida bounds + colisão (CanPlace, excluindo o próprio item); válido → seta X/Y no modelo
   e fixa (pin). Botão ⟳ rotaciona (re-valida na posição atual). Em edição NÃO embrulhamos no
   ItemTooltip (o wrapper do MudTooltip interferiria no grid-item/drag). READ-ONLY mantém o tooltip.
   NOTA: usa Catalog.GetItemDimensions (tamanho BASE) — TODO tamanho-com-mods (presets montados). *@

@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SPTarkov.Server.Core.Models.Common
@using CustomClasses.Web
@implements IAsyncDisposable
@inject CatalogService Catalog
@inject CostService CostService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="cc-grid2d-wrap">
    <div class="cc-grid2d-meta">@_w × @_h cells</div>
    @* A grade (linhas) é pintada via background-gradient no .cc-grid2d (CSS) — só os itens reais
       entram como filhos posicionados. Em edição a própria grade é a drop-zone. *@
    <div class="cc-grid2d" @ref="_gridEl" data-cell="@CellPx.ToString(CultureInfo.InvariantCulture)"
         data-cols="@_w" data-rows="@_h"
         style="@($"grid-template-columns:repeat({_w}, var(--cc-cell-unit));grid-template-rows:repeat({_h}, var(--cc-cell-unit));")">
        @foreach (var cell in _cells)
        {
            if (_editable)
            {
                <div class="cc-item-cell cc-grid2d__item cc-grid2d__item--edit @(cell.Rotated ? "cc-grid2d__item--rot" : null)"
                     style="@CellStyle(cell)" title="Click to edit · drag to move · ⟳ rotate · ✕ remove"
                     data-index="@(EditItems!.IndexOf(cell.Model!))"
                     data-x="@cell.X" data-y="@cell.Y" data-w="@cell.W" data-h="@cell.H"
                     @onclick="@(() => OnItemClick.InvokeAsync(cell.Model))">
                    @ItemInner(cell)
                    <button class="cc-grid2d__rotate" type="button" title="Rotate"
                            @onclick="@(() => RotateAsync(cell))" @onclick:stopPropagation="true">⟳</button>
                    <button class="cc-grid2d__remove" type="button" title="Remove item"
                            @onclick="@(() => RemoveAsync(cell))" @onclick:stopPropagation="true">✕</button>
                </div>
            }
            else
            {
                <ItemTooltip Name="@cell.Name" Category="@cell.Category"
                             Width="@cell.Width" Height="@cell.Height"
                             Price="@cell.Price" PriceSource="@cell.PriceSource"
                             Qty="@cell.Qty" MissingPrice="@cell.MissingPrice">
                    <div class="cc-item-cell cc-grid2d__item @(cell.Rotated ? "cc-grid2d__item--rot" : null)"
                         style="@CellStyle(cell)">
                        @ItemInner(cell)
                    </div>
                </ItemTooltip>
            }
        }
    </div>
    @if (_overflow > 0)
    {
        <div class="cc-grid2d-overflow">@_overflow item(s) did not fit the grid (not shown).</div>
    }
    @if (_editable)
    {
        <div class="cc-grid2d-hint">Drag to move · ⟳ to rotate · drop on a free area</div>
    }
</div>

@code {
    /// <summary>Itens loose do stash (Loadout.Stash) — modo READ-ONLY. Null/vazio → grade vazia.</summary>
    [Parameter] public List<ItemSpec>? Stash { get; set; }

    /// <summary>baseEdition da classe (dimensiona a grade). Vazio → default (Zero to hero).</summary>
    [Parameter] public string? BaseEdition { get; set; }

    /// <summary>F2c: habilita drag-and-drop (requer EditItems). Sem EditItems → render read-only.</summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>F2c: lista VIVA do _model.Stash (mutada em lugar pelo DnD). Null → read-only.</summary>
    [Parameter] public List<ItemSpecModel>? EditItems { get; set; }

    /// <summary>F2c: bubble após mover/rotacionar → o workspace recomputa o custo.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Token que muda a cada edição de loadout — força rebuild mesmo com a lista VIVA (ref estável).</summary>
    [Parameter] public int Revision { get; set; }

    /// <summary>Clicar num item (modo edição) → o workspace abre o editor daquele item (count/preset/remover).</summary>
    [Parameter] public EventCallback<ItemSpecModel?> OnItemClick { get; set; }

    private const int FallbackW = 10;
    private const int FallbackH = 40;

    /// <summary>Pixel de uma célula — DEVE casar com --cc-cell-unit no CSS (.cc-ws { 36px }).</summary>
    private const double CellPx = 36;

    private int _w = FallbackW;
    private int _h = FallbackH;
    private int _overflow;
    private List<PlacedCell> _cells = [];

    private bool _editable => Editable && EditItems is not null;

    // Pointer-drag interop (customclasses.mjs / window.ccGridDnd): a grade é a drop-zone; o JS calcula a
    // célula pelo rect da grade e chama MoveItemTo. Um init por elemento de grade (delegado no pointerdown).
    private ElementReference _gridEl;
    private DotNetObjectReference<StashGrid>? _dotNetRef;
    private bool _dndInit;

    private sealed record PlacedCell(
        int X, int Y, int W, int H, int W0, int H0, string? RootTpl, string? IconId, string Name, string? Category,
        double Qty, double Price, string? PriceSource, bool MissingPrice, int Width, int Height,
        ItemSpecModel? Model, bool Rotated);

    /// <summary>Campos normalizados de um item de origem (ItemSpec read-only OU ItemSpecModel editável).</summary>
    private readonly record struct SrcItem(
        string? Preset, string? Tpl, bool Premium, double Count, int? X, int? Y, bool Rotated, ItemSpecModel? Model);

    private object? _lastSource;
    private string? _lastBase;
    private int _lastRevision = -1;
    private bool _built;

    protected override void OnParametersSet()
    {
        // PERF: só reconstrua (pack do GridPacker) quando a fonte/baseEdition/Revision mudar. O Blazor
        // chama OnParametersSet a cada render do pai; sem o guard, mexer num slider de SKILL re-empacotava
        // o stash inteiro a cada step. O DnD chama Build() direto, então move/rotate reflete na hora.
        // Revision: a lista editável (_model.Stash) é mutada EM LUGAR (add/remove/edit) sem trocar a
        // referência — o token do workspace é o sinal de "o conteúdo mudou, reconstrua".
        object? source = _editable ? EditItems : Stash;
        if (_built
            && ReferenceEquals(source, _lastSource)
            && string.Equals(_lastBase, BaseEdition, StringComparison.Ordinal)
            && Revision == _lastRevision)
        {
            return;
        }

        _built = true;
        _lastSource = source;
        _lastBase = BaseEdition;
        _lastRevision = Revision;
        Build();
    }

    private void Build()
    {
        var baseKey = string.IsNullOrWhiteSpace(BaseEdition) ? ClassRegistrar.DefaultBaseEdition : BaseEdition!;
        var size = CostService.GetStashGridSize(baseKey);
        (_w, _h) = size ?? (FallbackW, FallbackH);

        _cells = [];
        _overflow = 0;

        var src = SourceItems();
        if (src.Count == 0)
        {
            return;
        }

        var packer = new GridPacker(_w, _h);

        // Dois passos: primeiro itens com coordenada fixa (X/Y), depois auto-posiciona o resto
        // (mesma prioridade do InventoryBuilder/PackSpecsIntoGrids — pinned antes do first-fit).
        var pinned = src.Where(s => s.X is not null && s.Y is not null).ToList();
        var loose = src.Where(s => s.X is null || s.Y is null).ToList();

        foreach (var item in pinned)
        {
            var data = Resolve(item);
            if (data is null)
            {
                continue;
            }

            var (rootTpl, name, category, w, h, qty, price, source, missing) = data.Value;
            var rotated = item.Rotated;
            if (packer.TryPlaceAt(item.X!.Value, item.Y!.Value, w, h, rotated))
            {
                AddCell(item, rootTpl, name, category, w, h, qty, price, source, missing, item.X.Value, item.Y.Value, rotated);
            }
            else if (packer.Place(w, h) is { } pos)
            {
                AddCell(item, rootTpl, name, category, w, h, qty, price, source, missing, pos.X, pos.Y, pos.Rotated);
            }
            else
            {
                _overflow++;
            }
        }

        foreach (var item in loose)
        {
            var data = Resolve(item);
            if (data is null)
            {
                continue;
            }

            var (rootTpl, name, category, w, h, qty, price, source, missing) = data.Value;
            if (packer.Place(w, h) is { } pos)
            {
                AddCell(item, rootTpl, name, category, w, h, qty, price, source, missing, pos.X, pos.Y, pos.Rotated);
            }
            else
            {
                _overflow++;
            }
        }
    }

    private void AddCell(SrcItem item, string? rootTpl, string name, string? category, int w0, int h0,
        double qty, double price, string? source, bool missing, int x, int y, bool rotated)
    {
        var (dw, dh) = rotated ? (h0, w0) : (w0, h0);
        // #3: ícone do PRESET montado (tarkov.dev hospeda o render do preset) quando o item é um preset;
        // o tpl base fica como fallback no onerror (vide ItemInner). Sem preset → ícone = tpl base.
        var iconId = ResolvePresetIconId(item) ?? rootTpl;
        _cells.Add(new PlacedCell(x, y, dw, dh, w0, h0, rootTpl, iconId, name, category,
            qty, price, source, missing, w0, h0, item.Model, rotated && w0 != h0));
    }

    /// <summary>Id do preset (default/premium) p/ a imagem do tarkov.dev — null se o item não é preset.</summary>
    private string? ResolvePresetIconId(SrcItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Preset) || TryMongoId(item.Preset!) is not { } key)
        {
            return null;
        }

        var preset = item.Premium ? Catalog.ResolvePremiumPreset(key) : Catalog.ResolveDefaultPreset(key);
        return preset?.Id.ToString();
    }

    private List<SrcItem> SourceItems()
    {
        if (_editable)
        {
            return EditItems!.Select(m => new SrcItem(
                m.Preset, m.Tpl, m.Premium, Math.Max(1, m.Count), m.X, m.Y, m.Rotated ?? false, m)).ToList();
        }

        return (Stash ?? [])
            .Select(s => new SrcItem(s.Preset, s.Tpl, s.Premium, Math.Max(1, s.Count), s.X, s.Y, s.Rotated ?? false, null))
            .ToList();
    }

    // ── DnD (modo edição) — pointer-based via window.ccGridDnd ────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Liga o drag uma vez, quando a grade editável existe. O listener é delegado no elemento da
        // grade (estável), então um init basta; o JS resolve o item alvo pelo data-index a cada drag.
        if (_editable && !_dndInit)
        {
            _dndInit = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ccGridDnd.init", _gridEl, _dotNetRef);
        }
    }

    /// <summary>
    ///     Chamado pelo JS no fim do drag: tenta posicionar o item <paramref name="index"/> (na lista
    ///     EditItems) na célula (x,y). Valida bounds+colisão (CanPlace); válido → fixa X/Y, re-empacota e
    ///     recomputa o custo. Inválido → ignora (o item volta pra onde estava). StateHasChanged porque a
    ///     chamada vem de fora do ciclo de render do Blazor.
    /// </summary>
    [JSInvokable]
    public async Task MoveItemTo(int index, int x, int y)
    {
        if (!_editable || EditItems is null || index < 0 || index >= EditItems.Count)
        {
            return;
        }

        var model = EditItems[index];
        var cell = _cells.FirstOrDefault(c => ReferenceEquals(c.Model, model));
        if (cell is null)
        {
            return;
        }

        var rotated = model.Rotated ?? false;
        var (w, h) = rotated ? (cell.H0, cell.W0) : (cell.W0, cell.H0);
        if (!CanPlace(x, y, w, h, model))
        {
            Snackbar.Add("Doesn't fit there — it overlaps another item or the grid edge.", Severity.Info);
            StateHasChanged();   // re-render põe o item de volta na origem (o ghost já sumiu no cliente)
            return;
        }

        model.X = x;
        model.Y = y;
        Build();
        StateHasChanged();
        await OnChanged.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_dndInit)
        {
            try
            {
                await JS.InvokeVoidAsync("ccGridDnd.dispose", _gridEl);
            }
            catch (JSDisconnectedException)
            {
                // circuito já caiu (navegação/refresh) — nada a limpar no cliente.
            }
        }

        _dotNetRef?.Dispose();
    }

    /// <summary>⟳: alterna Rotated na posição atual (fixando se era loose). Reverte se não couber.</summary>
    private async Task RotateAsync(PlacedCell cell)
    {
        if (!_editable || cell.Model is null)
        {
            return;
        }

        var rot = !(cell.Model.Rotated ?? false);
        var (w, h) = rot ? (cell.H0, cell.W0) : (cell.W0, cell.H0);
        var x = cell.Model.X ?? cell.X;
        var y = cell.Model.Y ?? cell.Y;

        if (CanPlace(x, y, w, h, cell.Model))
        {
            cell.Model.Rotated = rot;
            cell.Model.X = x;   // rotacionar fixa a posição (era loose → vira pinned)
            cell.Model.Y = y;
            Build();
            await OnChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add("Can't rotate here — no room. Move it to a free area first.", Severity.Info);
        }
    }

    /// <summary>✕: remove o item direto da lista viva do stash (atalho do "Remove item" do diálogo).</summary>
    private async Task RemoveAsync(PlacedCell cell)
    {
        if (!_editable || cell.Model is null)
        {
            return;
        }

        EditItems!.Remove(cell.Model);
        Build();
        StateHasChanged();
        await OnChanged.InvokeAsync();
    }

    /// <summary>Cabe em (x,y) o retângulo w×h sem sair da grade nem colidir (exclui o item arrastado).</summary>
    private bool CanPlace(int x, int y, int w, int h, ItemSpecModel? exclude)
    {
        if (x < 0 || y < 0 || x + w > _w || y + h > _h)
        {
            return false;
        }

        var occ = new bool[_w, _h];
        foreach (var c in _cells)
        {
            if (exclude is not null && ReferenceEquals(c.Model, exclude))
            {
                continue;
            }

            for (var yy = c.Y; yy < c.Y + c.H && yy < _h; yy++)
            {
                for (var xx = c.X; xx < c.X + c.W && xx < _w; xx++)
                {
                    occ[xx, yy] = true;
                }
            }
        }

        for (var yy = y; yy < y + h; yy++)
        {
            for (var xx = x; xx < x + w; xx++)
            {
                if (occ[xx, yy])
                {
                    return false;
                }
            }
        }

        return true;
    }

    // ── Render compartilhado da célula ────────────────────────────────────────────

    private RenderFragment ItemInner(PlacedCell cell) => __builder =>
    {
        <span class="cc-item-cell__txt">@cell.Name</span>
        @if (cell.IconId is not null)
        {
            @* #3: tenta o ícone do PRESET montado; no erro cai pro tpl base; no 2º erro esconde.
               draggable="false": a <img> é arrastável por padrão e capturaria o drag NATIVO da
               imagem em vez do nosso @ondragstart no div pai (era o "mistério" do DnD travado). *@
            <img src="@($"https://assets.tarkov.dev/{cell.IconId}-icon.webp")"
                 loading="lazy" alt="" draggable="false"
                 data-fb="@(cell.IconId != cell.RootTpl ? cell.RootTpl : null)"
                 onerror="if(this.dataset.fb){this.src='https://assets.tarkov.dev/'+this.dataset.fb+'-icon.webp';this.dataset.fb='';}else{this.style.display='none';}"/>
        }
        @if (cell.Qty > 1)
        {
            <span class="cc-item-cell__qty">@cell.Qty.ToString("N0", CultureInfo.InvariantCulture)</span>
        }
        @if (cell.MissingPrice)
        {
            <span class="cc-item-cell__warn" title="No flea or handbook price found">⚠</span>
        }
    };

    /// <summary>1-based grid-column/row + span (grid começa em 1; X/Y são 0-based).</summary>
    // --cw0/--ch0 = dimensões BASE (não rotacionadas) em células: o CSS .cc-grid2d__item--rot usa-as
    // pra dimensionar o ícone no tamanho natural e girá-lo 90° (preenchendo a célula já invertida).
    private static string CellStyle(PlacedCell c) =>
        $"grid-column:{c.X + 1} / span {c.W};grid-row:{c.Y + 1} / span {c.H};--cw0:{c.W0};--ch0:{c.H0};";

    private (string? RootTpl, string Name, string? Category, int W, int H, double Qty,
        double Price, string? PriceSource, bool Missing)? Resolve(SrcItem item)
    {
        var rootTpl = ResolveRootTpl(item);
        var qty = Math.Max(1, item.Count);
        if (rootTpl is null)
        {
            var raw = item.Preset ?? item.Tpl ?? "(no tpl)";
            return (null, raw, null, 1, 1, qty, 0, null, true);
        }

        // TODO tamanho-com-mods: GetItemDimensions é o tamanho BASE; presets/mods com ExtraSize não
        // são considerados aqui (o builder usa InventoryHelper.GetItemSize sobre a árvore montada).
        var (w, h) = Catalog.GetItemDimensions(rootTpl);
        var id = new MongoId(rootTpl);
        var name = Catalog.GetItemName(id);
        var category = Catalog.GetCategoryName(rootTpl);
        var (price, source) = Catalog.GetPrice(id);
        return (rootTpl, name, category, w, h, qty, price, source,
            string.Equals(source, "missing", StringComparison.Ordinal));
    }

    /// <summary>preset > tpl (mesma ordem do GearPanel). null = nada resolve.</summary>
    private string? ResolveRootTpl(SrcItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.Preset))
        {
            var key = TryMongoId(item.Preset!);
            var preset = key is null
                ? null
                : item.Premium ? Catalog.ResolvePremiumPreset(key.Value) : Catalog.ResolveDefaultPreset(key.Value);
            return preset?.Items?.FirstOrDefault()?.Template.ToString();
        }

        if (!string.IsNullOrWhiteSpace(item.Tpl) && TryMongoId(item.Tpl!) is not null)
        {
            return item.Tpl;
        }

        return null;
    }

    private static MongoId? TryMongoId(string raw) =>
        MongoId.IsValidMongoId(raw) ? new MongoId(raw) : (MongoId?)null;
}
