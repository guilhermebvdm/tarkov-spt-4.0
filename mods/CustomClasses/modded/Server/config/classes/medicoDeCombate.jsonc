{
  "name": "Combat Medic",
  "displayName": {
    "en": "Combat Medic",
    "pt": "Médico de Combate"
  },
  "enabled": true,
  "baseEdition": "SPT Zero to hero",
  "description": {
    "en": "Combat Medic. Takes hits that would kill normal people and patches himself up complaining the whole time. Back in the firefight before the bandage is done, because stopping to heal is for amateurs.",
    "pt": "Médico de Combate. Leva tiro que mataria gente normal e ainda se trata reclamando. Volta pro tiroteio antes de acabar o curativo, porque parar pra sarar é coisa de amador."
  },
  "iconFile": "medicoDeCombate.png",
  "nameColor": "#6f9455",
  "skills": {
    "FirstAid": 5,
    "FieldMedicine": 5,
    "Surgery": 4,
    "Vitality": 0,
    "HideoutManagement": 5,
    "Immunity": 0,
    "Perception": 5,
    "Memory": 5,
    "Metabolism": 0,
    "Endurance": 3
  },
  "skillMultipliers": {
    // B8 (balance 2026-07-11): o Médico tinha o MENOR netMult do mod (11.31 — o piso). Subida cirúrgica:
    // FirstAid ×2.5→×3 (+0.47) · Vitality ×1→×1.5 (+0.84, era neutro) · Charisma ×1→×1.5 (+0.20, era neutro).
    // ⚠️ Health já é ×2 — NÃO tocar (o board é explícito). Resultado: 11.31 → ≈12.8.
    "FirstAid": 3,
    "Vitality": 1.5,
    "Charisma": 1.5,
    "FieldMedicine": 2,
    "Surgery": 2,
    "HideoutManagement": 1.5,
    "Crafting": 1.5,
    "Assault": 0.6,
    "AimDrills": 0.7,
    "CovertMovement": 0.7,
    "Perception": 1.5,
    "Intellect": 1.5,
    "Memory": 2,
    "Metabolism": 1.5,
    "Immunity": 2,
    "Health": 2,
    "StressResistance": 1.5,
    "Shotgun": 0.7,
    "Sniper": 0.7,
    "DMR": 0.7,
    "Melee": 2,
    "TroubleShooting": 0.85,
    "Lockpicking": 1.5,
    "Endurance": 1.5
  },
  "hideout": {
    "MedStation": 1
  },
