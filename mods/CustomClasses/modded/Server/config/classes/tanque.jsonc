{
  "name": "Tank",
  "displayName": {
    "en": "Tank",
    "pt": "Tanque"
  },
  "enabled": true,
  "baseEdition": "SPT Zero to hero",
  "description": {
    "en": "Tank. Walking fortress — soaks damage that drops others, hauls heavy gear and keeps pushing. Trades speed for armor.",
    "pt": "Tanque. Fortaleza ambulante — absorve dano que derruba os outros, carrega equipamento pesado e continua avançando. Troca velocidade por blindagem."
  },
  "iconFile": "tanque.png",
  "nameColor": "#6b7280",
  "skills": {
    // B5 (balance 2026-07-11): 3 → 2. Custo inicial estava em 35.28, fora do alvo 28–32 (única classe fora).
    // A classe treina HeavyVests ×2, então recupera o nível rápido. Novo custo ≈ 31.53.
    "HeavyVests": 2,
    "Health": 0,
    "Vitality": 5,
    "Strength": 5,
    "Shotgun": 5,
    "Throwing": 1
  },
