    "Throwing": 2,
    "Melee": 2,
    "Metabolism": 0.5,
    "CovertMovement": 0.5,
    "AimDrills": 0.7,
    "DMR": 0.7,
    // B18 (balance 2026-07-11): ×2 → ×1.75 (−0.94). Junto com o Shotgun: netMult 19.19 → ≈17.0 (teto da faixa).
