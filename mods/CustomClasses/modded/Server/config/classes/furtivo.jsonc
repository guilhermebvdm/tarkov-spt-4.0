{
  "name": "Stealth",
  "displayName": {
    "en": "Stealth",
    "pt": "Furtivo"
  },
  "enabled": true,
  "baseEdition": "SPT Zero to hero",
  "description": {
    "en": "Stealth. Furtive killer — moves unheard, strikes from the dark. Devastating melee execution and a suppressed sidearm.",
    "pt": "Furtivo. Assassino furtivo — move-se sem ser ouvido e ataca do escuro. Execução melee devastadora e pistola silenciada."
  },
  "iconFile": "operadorFurtivo.png",
  "nameColor": "#8b8fa3",
  "skills": {
    "SilentOps": 5,
    "Pistol": 1,
    "CovertMovement": 5,
    "Perception": 5,
    "Melee": 3,
    "Lockpicking": 3,
    "Throwing": 2,
    "ProneMovement": 3
  },
  "skillMultipliers": {
    "SilentOps": 2.5,
    "Pistol": 3,
    "CovertMovement": 2,
    "Perception": 2,
    "Melee": 1.5,
    "LightVests": 1.3,
    "ProneMovement": 2,
    "Lockpicking": 2,
    "Assault": 0.6,
    // B11: StressResistance (Ph — categoria que o Furtivo não treina) era o 5º debuff GRÁTIS. Removido.
    "Shotgun": 0.7,
    "Throwing": 2,
    "Shadowconnections": 2,
    "Memory": 2,
    // B11 (balance 2026-07-11): o Furtivo tinha 5 debuffs "GRÁTIS" — penalidades em skills que ele nem treina
    // (StressResistance, Vitality, Metabolism = categoria Ph; BearRawpower, UsecNegotiations = categoria S).
    // Pareciam custo, não custavam nada: netMult cru 12.43 vs plausível 14.35. REMOVIDOS.
    // No lugar, debuffs que MORDEM de verdade — em categorias que ele TREINA (C/M/P) e temáticos (ele é leve,
    // não é atirador de rifle pesado):
    //   HeavyVests ×0.9 (peso 3.75 → −0.375) · RecoilControl ×0.9 (peso 1.0 → −0.10).
    // Resultado: netMult ≈13.9 (alvo do board ≈14), agora HONESTO (cru == plausível, zero debuff grátis).
    // ⚠️ O board sugeria `Endurance ×0.8` como exemplo — mas Endurance é Ph, categoria que ele NÃO treina:
    // seria mais um debuff grátis. Por isso a troca por HeavyVests/RecoilControl.
    "HeavyVests": 0.9,
    "RecoilControl": 0.9
  },
  "hideout": {
    "WaterCloset": 1
  },
