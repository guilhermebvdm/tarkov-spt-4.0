<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_0</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\ladders.bep\tarkin.ladders.bep.csproj" />
    <ProjectReference Include="..\ladders.shared\tarkin.ladders.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll">
      <Private>False</Private>
    </Reference>
    
    <Reference Include="..\.References\Fika.Core.dll">
      <Private>False</Private>
    </Reference>

    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\AnimationSystem.Types.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
  
  <Target Name="CopyFilesAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginsDir>$(SPTPath)\BepInEx\plugins\tarkin-ladders\</PluginsDir>
      <BepDestination>$(PluginsDir)</BepDestination>
    </PropertyGroup>

    <ItemGroup>
      <BepFiles Include="$(OutputPath)\tarkin.ladders.fika.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(BepFiles)" DestinationFolder="$(BepDestination)" />
  </Target>

  <!-- release zipping -->
  <Target Name="PackageZip" AfterTargets="CopyFilesAfterBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ZipStagingDir>$(IntermediateOutputPath)ZipStaging\</ZipStagingDir>
      <ZipPluginDir>$(ZipStagingDir)BepInEx\plugins\tarkin-ladders\</ZipPluginDir>
      <ZipFileName>tarkin-ladders-fikasync-v$(Version).zip</ZipFileName>
      <ZipOutputPath>$(OutputPath)$(ZipFileName)</ZipOutputPath>
    </PropertyGroup>

    <RemoveDir Directories="$(ZipStagingDir)" />

    <ItemGroup>
      <FilesToZip Include="$(BepDestination)tarkin.ladders.fika.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToZip)" DestinationFolder="$(ZipPluginDir)%(RecursiveDir)" />

    <ZipDirectory SourceDirectory="$(ZipStagingDir)" DestinationFile="$(ZipOutputPath)" Overwrite="true" />

    <RemoveDir Directories="$(ZipStagingDir)" />
    <Message Importance="High" Text="Successfully packaged release: $(ZipOutputPath)" />
  </Target>
</Project>
