<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- SPT 4.0 port: the 4.0 server runs on .NET 9 (upstream targets net10.0 for SPT 4.1). -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Orbit.Server</AssemblyName>
    <Version>2.1.0</Version>
    <RootNamespace>Orbit.Server</RootNamespace>
    <!-- SPT 4.0 port: SPT_DIR (the SPT 4.0 server folder the references resolve from) comes from ..\Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per-map zone defaults, seeded from the client's compiled-in defaults (Config/Maps/Zones). -->
    <EmbeddedResource Include="Resources\Zones\*.json" LogicalName="Orbit.Server.Resources.Zones.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPT_DIR)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Web"><HintPath>$(SPT_DIR)\SPTarkov.Server.Web.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPT_DIR)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPT_DIR)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SPT_DIR)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MudBlazor"><HintPath>$(SPT_DIR)\MudBlazor.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Zones\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="EnsureSptDir" BeforeTargets="Build">
    <Error Condition="!Exists('$(SPT_DIR)\SPTarkov.Server.Core.dll')" Text="SPT_DIR ($(SPT_DIR)) does not point at a valid SPT 4.0 server (SPTarkov.Server.Core.dll not found). Set SPT_PATH or the .spt-path file at the repository root." />
  </Target>

  <!-- SPT 4.0 port: the upstream DeployMod copy into SPT_DIR\user\mods\ORBIT was removed; /compile-mod installs the build. -->

</Project>
