<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>default</LangVersion>
        <Deterministic>false</Deterministic>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- SPT 4.0 port: SptRoot and FikaRef (the installed Fika.Core) come from ..\Directory.Build.props -->
        <AssemblyName>Orbit.Fika</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <!-- SPT 4.0 port: global using aliases are per project, so the addon compiles the core's alias file too. -->
      <Compile Include="..\Orbit\Compat\Spt40TypeAliases.cs" Link="Compat\Spt40TypeAliases.cs" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="0Harmony">
        <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <ProjectReference Include="..\Orbit\Orbit.csproj">
        <Private>false</Private>
      </ProjectReference>
      <Reference Include="Fika.Core">
        <HintPath>$(FikaRef)</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Assembly-CSharp">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="BepInEx">
        <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Comfort">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.AudioModule">
        <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

</Project>
