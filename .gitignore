# .NET / C#
bin/
obj/
bin-homolog/
*.user
*.suo
*.userprefs
.vs/

# Mod build output — fully reproducible via /compile-mod (keep the folder, drop the artifacts).
mods/**/builds/*
!mods/**/builds/.gitkeep
# Version-gate state (last compiled version per assembly) — per-machine, written by compile-mod.sh.
mods/**/.last-compile-versions
# Engine/reference DLLs copied from the SPT/EFT install — not source, large and licensed.
mods/**/References/*.dll

# Heavy mod assets — Unity bundles and showcase images (re-fetchable from upstream).
mods/**/*.bundle
mods/**/*.webp

# Generated icon-review contact sheet — reproducible via scripts/preview-icons.mjs.
mods/**/scripts/preview/

# Node / TypeScript
node_modules/
*.log
npm-debug.log*
yarn-error.log

# IDE / Editor
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets / Env
.env
.env.local
.env.*.local

# Per-machine SPT/EFT install path (compile-mod.sh reads it). Versioned: .spt-path.example
/.spt-path

# Claude Code (gitignored — preferências pessoais)
.claude/settings.local.json
.tmp-research.md
.qa-shots

# Local API caches (third-party data, refetchable)
mods/RZCustomProfiles/scripts/cache/

# Discord topic captures — assets (imagens/vídeos/JSONs brutos) podem somar centenas de MB
# e são rebaixáveis do Discord. Só os .md (transcrição/análise) são versionados.
docs/discord-mods-topics/*/assets/

# SPT server source code — vendored read-only reference, ~856 MB.
# Re-fetch instructions in references/README.md
references/spt-source/

# Fika server, plugin and headless sources - vendored read-only reference
references/fika-server/
references/fika-plugin/
references/fika-headless/

# EFT decompiled dump — ~14 mil arquivos (~50-90 MB), gerado por scripts/decompile-eft.sh a partir
# da Assembly-CSharp.dll do jogo instalado. NÃO é re-fetchável sem o jogo (ver references/README.md).
# O que fica VERSIONADO ao lado (não ignorar!): types-index.json, .provenance.json, README.md —
# o índice responde "esse tipo existe?" mesmo sem o dump em disco.
references/eft-decompiled/Assembly-CSharp/

# Grafo do decompilado — DERIVADO do dump acima (~140 MB, acima do limite de 100 MB/arquivo do
# GitHub). Regenerável: bash scripts/update-graphs.sh eft-decompiled
references/graphs/eft-decompiled/

# Saída de `scripts/decompile-eft.sh --dry-run` (inspeção antes de substituir o dump).
/.decompile-dryrun/

*.exe
*.Backup.tmp

# Graphify working outputs — per-scope scratch; the VERSIONED graphs live in
# references/graphs/ (published by scripts/update-graphs.sh)
graphify-out/

# Release bundles produced by tools/trl-items-management/scripts/package-release.sh
# (default OUTDIR). Build artifacts — never committed.
/dist/
