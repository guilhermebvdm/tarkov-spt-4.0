<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SPT.Launcher.CustomControls.LoginBox">
        <Border Classes="card">
            
        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto, Auto" Margin="5" HorizontalAlignment="Center">
            <!-- Row 0 -->
            <!-- Username box -->
            <TextBox Grid.Row="0" Grid.Column="0"
                     Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=username}"
                     VerticalAlignment="Center"
                     Width="230"
                     Margin="0,0,15,5"
                     Text="{Binding $parent[UserControl].Username}"
                     />
            
            <!-- Password box com olho mágico interno -->
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,15,5" Width="230">
                <TextBox x:Name="PasswordBox"
                         Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=password}"
                         VerticalAlignment="Center"
                         PasswordChar="●"
                         Padding="8,6,30,6"
                         Text="{Binding $parent[UserControl].Password}"
                         />
                <Button Content="🙈" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="4,2" Margin="0,0,4,0"
                        Background="Transparent" Foreground="Gray"
                        FontSize="13" Cursor="Hand"
                        ToolTip.Tip="Mostrar/ocultar senha"
                        Click="TogglePasswordVisibility"/>
            </Grid>
            
            <!-- Login button -->
            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Stretch"
                    Command="{Binding $parent[UserControl].LoginCommand}"
                    IsEnabled="{Binding !$parent[UserControl].IsLoggingIn}"
                    IsDefault="True"
                    Classes="acc"
                    Padding="20,0"
                    MinWidth="130"
                    Margin="0,0,0,15">
                <TextBlock
                        Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=login_or_register}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        FontWeight="Bold"
                        />
            </Button>
            
            <!-- Lembrar Usuário -->
            <CheckBox Grid.Row="1" Grid.Column="0"
                      IsChecked="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=RememberUsername}"
                      Content="Lembrar Usuário"
                      FontSize="12"
                      Margin="0"
                      HorizontalAlignment="Left"
                      />
            
            <!-- Login Automático & Resetar Senha -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" Margin="0">
                <CheckBox IsChecked="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=UseAutoLogin}"
                          Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=login_automatically}"
                          FontSize="12"
                          Margin="0"
                          />
                <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=reset_password}"
                        Command="{Binding $parent[UserControl].ResetPasswordCommand}"
                        Classes="transparent"
                        FontSize="11"
                        Padding="5,2"
                        Margin="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentBrush}"
                        />
            </StackPanel>
        </Grid>
        </Border>
</UserControl>