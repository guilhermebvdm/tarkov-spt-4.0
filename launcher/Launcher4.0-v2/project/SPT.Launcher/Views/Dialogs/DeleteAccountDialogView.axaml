<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
             x:Class="SPT.Launcher.Views.Dialogs.DeleteAccountDialogView"
             MaxWidth="460">

  <cc:TrlDialogChrome Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_dialog_title}">
    <cc:TrlDialogChrome.HeaderContent>
      <Button Classes="icon sm" Content="✕" Cursor="Hand"
              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}">
        <Button.CommandParameter>
          <s:Boolean>False</s:Boolean>
        </Button.CommandParameter>
      </Button>
    </cc:TrlDialogChrome.HeaderContent>

    <StackPanel Spacing="12">
      <TextBlock TextWrapping="Wrap" Classes="trl-danger" FontWeight="Bold"
                 Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_permanent_warning}"/>

      <TextBlock TextWrapping="Wrap" Classes="trl-muted"
                 Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_vs_wipe_explanation}"/>

      <!-- Item 023 (Frente B / RN-4 / CA-B1): aviso de coop. O gate local só enxerga o EFT deste
           launcher, nunca a sessão Fika Coop dos outros jogadores. Assume-se o pior. -->
      <TextBlock TextWrapping="Wrap" Classes="trl-danger"
                 Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_coop_warning}"/>

      <StackPanel Spacing="6">
        <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_type_name_label}"/>
        <TextBlock Classes="trl-mono trl-accent" Text="{Binding Username}"/>
        <TextBox Text="{Binding TypedUsername, Mode=TwoWay}"
                 Watermark="{Binding Username}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=cancel_button}" Classes="ghost" Cursor="Hand"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}">
          <Button.CommandParameter>
            <s:Boolean>False</s:Boolean>
          </Button.CommandParameter>
        </Button>
        <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=delete_account_confirm_button}" Classes="danger" Cursor="Hand"
                IsEnabled="{Binding CanConfirm}"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}">
          <Button.CommandParameter>
            <s:Boolean>True</s:Boolean>
          </Button.CommandParameter>
        </Button>
      </StackPanel>
    </StackPanel>
  </cc:TrlDialogChrome>
</UserControl>
