<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
             x:Class="SPT.Launcher.Views.Dialogs.CreatePasswordDialogView"
             MaxWidth="460">

  <cc:TrlDialogChrome Title="{Binding Title}">
    <cc:TrlDialogChrome.HeaderContent>
      <!-- ✕ = cancelar (retorna null; caller trata como cancelamento) -->
      <Button Classes="icon sm" Content="✕" Cursor="Hand"
              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
    </cc:TrlDialogChrome.HeaderContent>

    <StackPanel Spacing="12">
      <!-- Message -->
      <TextBlock Text="{Binding Message}" Classes="trl-muted" FontSize="{DynamicResource TrlTextMd}" TextWrapping="Wrap"/>

      <!-- Password field -->
      <TextBox Watermark="{Binding PasswordWatermark}"
               PasswordChar="●"
               Text="{Binding Password, Mode=TwoWay}"/>

      <!-- Confirm password field -->
      <TextBox Watermark="{Binding RepeatPasswordText}"
               PasswordChar="●"
               Text="{Binding ConfirmPassword, Mode=TwoWay}"/>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Content="{Binding CancelButtonText}" Classes="ghost" Cursor="Hand"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
        <Button Content="{Binding ConfirmButtonText}" Classes="primary" Cursor="Hand"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"
                CommandParameter="{Binding Password}"
                IsEnabled="{Binding CanConfirm}"/>
      </StackPanel>
    </StackPanel>
  </cc:TrlDialogChrome>
</UserControl>
