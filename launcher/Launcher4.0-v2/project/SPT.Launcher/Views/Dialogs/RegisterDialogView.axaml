<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="360"
             x:Class="SPT.Launcher.Views.Dialogs.RegisterDialogView"
             MaxWidth="560">

  <cc:TrlDialogChrome Title="CRIAR CONTA">
    <cc:TrlDialogChrome.HeaderContent>
      <!-- ✕ = cancelar (retorna null; caller só age com o VM como resultado) -->
      <Button Classes="icon sm" Content="✕" Cursor="Hand"
              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
    </cc:TrlDialogChrome.HeaderContent>

    <StackPanel Spacing="12" MinWidth="480">
      <!-- Question Text -->
      <TextBlock Text="{Binding Question}" FontSize="{DynamicResource TrlTextMd}" TextWrapping="Wrap"/>

      <!-- Editions Combo Selection -->
      <ComboBox ItemsSource="{Binding Editions.AvailableEditions}"
                HorizontalAlignment="Stretch"
                SelectedItem="{Binding Editions.SelectedEdition}"
                PlaceholderText="{Binding ComboBoxPlaceholderText}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Background="Transparent" Text="{Binding Name}" ToolTip.Tip="{Binding Description}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Password Input -->
      <TextBox Text="{Binding Password}"
               PasswordChar="●"
               Watermark="{Binding PasswordPlaceholderText}"
               HorizontalAlignment="Stretch"/>

      <!-- Description Area -->
      <Border Background="{DynamicResource TrlBgInputBrush}"
              BorderBrush="{DynamicResource TrlEdgeBrush}"
              BorderThickness="1"
              CornerRadius="0"
              MinHeight="50"
              HorizontalAlignment="Stretch">
        <StackPanel Spacing="8" Margin="10">
          <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=description}"
                     Classes="trl-label"/>
          <TextBlock Text="{Binding Editions.SelectedEdition.Description}"
                     Classes="trl-muted"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Content="{Binding CancelButtonText}" Classes="ghost" Cursor="Hand"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
        <Button Content="{Binding RegisterButtonText}" Classes="primary" Cursor="Hand"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding CanRegister}"
                IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </cc:TrlDialogChrome>
</UserControl>
