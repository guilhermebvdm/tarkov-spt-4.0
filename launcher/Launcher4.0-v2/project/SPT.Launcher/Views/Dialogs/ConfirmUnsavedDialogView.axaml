<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:vm="using:SPT.Launcher.ViewModels.Dialogs"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="240"
             x:Class="SPT.Launcher.Views.Dialogs.ConfirmUnsavedDialogView"
             MaxWidth="500">

  <cc:TrlDialogChrome Title="{Binding Title}">
    <StackPanel Spacing="18">
      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="{DynamicResource TrlTextMd}"/>

      <!-- Cancel isolado à esquerda; Discard/Save (ações de sair) agrupados à direita — a separação
           evita clicar "Descartar" no lugar de "Cancelar" (CR 🟠). Save (primary) é a ação enfatizada. -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <Button Grid.Column="0" Content="{Binding CancelText}" Classes="ghost" Cursor="Hand"
                CommandParameter="{x:Static vm:ConfirmUnsavedDialogViewModel.CancelResult}"
                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Button Content="{Binding DiscardText}" Classes="ghost" Cursor="Hand"
                  CommandParameter="{x:Static vm:ConfirmUnsavedDialogViewModel.DiscardResult}"
                  Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
          <Button Content="{Binding SaveText}" Classes="primary" Cursor="Hand"
                  CommandParameter="{x:Static vm:ConfirmUnsavedDialogViewModel.SaveResult}"
                  Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </cc:TrlDialogChrome>
</UserControl>
