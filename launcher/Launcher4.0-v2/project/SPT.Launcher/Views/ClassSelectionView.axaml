<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:base="clr-namespace:SPT.Launcher;assembly=SPT.Launcher.Base"
             x:Class="SPT.Launcher.Views.ClassSelectionView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>

        <!-- Card de perk/drawback (item 029): barra de acento à esquerda + título esmaecido +
             chip de valor colorido + label. Espelha o PerksPanelView in-game. -->
        <DataTemplate x:Key="perkCardTemplate">
            <Border Background="{Binding BgBrush}"
                    BorderBrush="{Binding AccentBrush}" BorderThickness="3,0,0,0"
                    CornerRadius="2" Padding="12,8" Margin="0,0,0,6">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                               FontSize="{DynamicResource TrlText2Xs}"
                               Foreground="{Binding AccentBrush}" Opacity="0.85"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding ValueToken}" FontWeight="Bold"
                                   Foreground="{Binding AccentBrush}" Margin="0,0,6,0"
                                   IsVisible="{Binding HasToken}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TrlFgBrush}"/>
                    </Grid>
                    <TextBlock Text="· em breve" FontStyle="Italic"
                               FontSize="{DynamicResource TrlText2Xs}"
                               Foreground="{Binding AccentBrush}"
                               IsVisible="{Binding Pending}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- cursor mãozinha ao navegar pelas classes -->
        <Style Selector="ListBox.trl-nav ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Fundo + overlay TRL. bg_02 é placeholder: a arte-alvo (post do Reddit) não foi
             extraível — trocar por bg dedicado quando houver o URL direto da imagem. -->
        <Image Source="/Assets/Backgrounds/bg_02.jpg" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Border Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

        <Grid ColumnDefinitions="300, *">

            <!-- Coluna 0: lista de classes -->
            <Border Grid.Column="0"
                    Background="{DynamicResource TrlPanelOverPhotoBrush}"
                    BorderBrush="{DynamicResource TrlEdgeBrush}"
                    BorderThickness="0,0,1,0">
                <!-- top 44: título desce abaixo da top bar (34px) + respiro -->
                <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="16,44,16,16">

                    <TextBlock Grid.Row="0" Text="SELEÇÃO DE CLASSE" Classes="trl-label"
                               LetterSpacing="{DynamicResource TrlTrackWider}"
                               Margin="0,8,0,16"/>

                    <Grid Grid.Row="1">
                        <ListBox Classes="trl-nav"
                                 ItemsSource="{Binding AvailableClasses}"
                                 SelectedItem="{Binding SelectedClass}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <!-- ícone do server (arquivo em cache) -->
                                        <Image Width="24" Height="24"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath, Converter={StaticResource imageSourceCvt}}"
                                               IsVisible="{Binding HasIcon}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <!-- fallback local bundlado (Assets/ClassIcons) quando o server não trouxe ícone -->
                                        <Image Width="24" Height="24"
                                               VerticalAlignment="Center"
                                               Source="{Binding FallbackIcon}"
                                               IsVisible="{Binding HasFallbackIcon}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <!-- Dois TextBlocks alternados: com nameColor do server ou herdando o foreground por estado do trl-nav -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{Binding NameBrush}"
                                                   IsVisible="{Binding HasNameColor}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasNameColor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Carregando classes..." Classes="trl-muted"
                                   FontSize="{DynamicResource TrlTextSm}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsLoading}"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding RegisterErrorMsg}" Classes="trl-danger"
                               FontSize="{DynamicResource TrlTextSm}" FontWeight="Bold" TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Grid.Row="3" Spacing="10" Margin="0,16,0,0">
                        <Button Content="ESCOLHER CLASSE" Command="{Binding FinalizeAccountCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Content="VOLTAR" Command="{Binding GoToRegisterCommand}"
                                Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <cc:TrlVersionFooter HorizontalAlignment="Center" Margin="0,10,0,0"
                                             LauncherVersion="{x:Static helpers:LauncherUpdateHelper.CurrentVersion}"
                                             ServerVersion="{x:Static base:ServerManager.TrlServerVersion}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coluna 1: detalhe da classe selecionada -->
            <cc:TrlPanel Grid.Column="1" Margin="40" Padding="0" ShowHeader="False"
                         Background="{DynamicResource TrlPanelOverPhotoBrush}"
                         VerticalAlignment="Stretch"
                         IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                    <cc:TrlScreenBar DockPanel.Dock="Top"
                                     Title="{Binding SelectedClass.NameUpper}"
                                     Meta="CLASSE"/>

                    <!-- 2 zonas: arte da classe (esquerda, fundo removido, colada na base) + info (direita).
                         Sem arte (classe sem PNG) → coluna esquerda colapsa e a info ocupa tudo. -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="300"
                                IsVisible="{Binding SelectedClass.HasClassImage}"
                                VerticalAlignment="Stretch">
                            <Image Source="{Binding SelectedClass.ClassImage}"
                                   Stretch="Uniform"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                   Margin="12,8,0,0"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16" Spacing="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="DESCRIÇÃO DA CLASSE" Classes="trl-label"/>
                                <TextBlock Text="{Binding SelectedClass.Description}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource TrlTextMd}"
                                           LineHeight="22"
                                           Foreground="{DynamicResource TrlFgMutedBrush}"/>
                            </StackPanel>

                            <!-- Multiplicadores de XP (Fase 1): já vêm do server em /customclasses/classes.
                                 Cor verde/vermelha = mesma linguagem do painel de perks in-game. -->
                            <StackPanel Spacing="8" IsVisible="{Binding SelectedClass.HasMultipliers}">
                                <TextBlock Text="MULTIPLICADORES DE XP" Classes="trl-label"/>
                                <ItemsControl ItemsSource="{Binding SelectedClass.MultiplierRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="72,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Token}"
                                                           Foreground="{Binding Brush}" FontWeight="Bold"
                                                           FontSize="{DynamicResource TrlTextMd}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource TrlTextMd}"
                                                           Foreground="{DynamicResource TrlFgMutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Perks & Drawbacks (item 029): 2 colunas espelhando o painel in-game.
                                 Visível só quando a classe tem efeitos (server serve `effects`, ou
                                 preview de Dev Mode). Colunas independentes por HasPerks/HasDrawbacks. -->
                            <StackPanel Spacing="10" IsVisible="{Binding SelectedClass.HasAnyEffects}">
                                <TextBlock Text="PERKS E DRAWBACKS" Classes="trl-label"/>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="6"
                                                IsVisible="{Binding SelectedClass.HasPerks}">
                                        <TextBlock Text="PERKS" Classes="trl-label"
                                                   Foreground="#9ad27a" Opacity="0.9"/>
                                        <ItemsControl ItemsSource="{Binding SelectedClass.Perks}"
                                                      ItemTemplate="{StaticResource perkCardTemplate}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="6"
                                                IsVisible="{Binding SelectedClass.HasDrawbacks}">
                                        <TextBlock Text="DRAWBACKS" Classes="trl-label"
                                                   Foreground="#d27a7a" Opacity="0.9"/>
                                        <ItemsControl ItemsSource="{Binding SelectedClass.Drawbacks}"
                                                      ItemTemplate="{StaticResource perkCardTemplate}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </cc:TrlPanel>
        </Grid>
    </Grid>
</UserControl>
