<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:base="clr-namespace:SPT.Launcher;assembly=SPT.Launcher.Base"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.RegisterView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <Grid>
        <!-- TAQUILA em tela cheia, render nítido (posição original) — a cena aparece através do painel de vidro -->
        <Image Source="/Assets/bg1.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <Grid ColumnDefinitions="*, 450">

            <!-- Scrim atrás do painel (Coluna 1) p/ legibilidade AA — a arte à esquerda fica nítida -->
            <Border Grid.Column="1" Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- 2. ÁREA CENTRAL (REGISTRO) - painel de vidro (50%) com margem uniforme -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource TrlEdgeBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource TrlPanelAuthBrush}"
                    Padding="40,64,40,40">
                <Grid RowDefinitions="Auto, *, Auto">

                    <!-- Logo Topo (item 008: desce levemente do topo) -->
                    <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="56" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <!-- Painel de Registro -->
                    <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_heading}" Classes="trl-h3"
                                   LetterSpacing="{DynamicResource TrlTrackWider}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_username_label}" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding RegisterUsername, Mode=TwoWay}" Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_username_watermark}"/>

                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_password_label}" Classes="trl-label" Margin="0,0,0,-10"/>
                        <Grid>
                            <TextBox Text="{Binding RegisterPassword, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_password_watermark}" Padding="8,5,32,5"/>
                            <Button Classes="icon" Command="{Binding TogglePasswordVisibilityCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,2,0" Cursor="Hand" ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=toggle_password_visibility_tooltip}">
                                <Panel>
                                    <Path Data="{StaticResource TrlIconEye}" IsVisible="{Binding !IsPasswordVisible}"
                                          Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                    <Path Data="{StaticResource TrlIconEyeOff}" IsVisible="{Binding IsPasswordVisible}"
                                          Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                </Panel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_confirm_password_label}" Classes="trl-label" Margin="0,0,0,-10"/>
                        <Grid>
                            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="{Binding ConfirmPasswordChar}" Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_confirm_password_watermark}" Padding="8,5,32,5"/>
                            <Button Classes="icon" Command="{Binding ToggleConfirmVisibilityCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,2,0" Cursor="Hand" ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=toggle_password_visibility_tooltip}">
                                <Panel>
                                    <Path Data="{StaticResource TrlIconEye}" IsVisible="{Binding !IsConfirmVisible}"
                                          Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                    <Path Data="{StaticResource TrlIconEyeOff}" IsVisible="{Binding IsConfirmVisible}"
                                          Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                </Panel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding RegisterErrorMsg}" Classes="trl-danger" FontSize="{DynamicResource TrlTextSm}" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_submit_button}" Command="{Binding GoToClassSelectionCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_have_account_prompt}" Classes="trl-muted" FontSize="{DynamicResource TrlTextSm}" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                        <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=register_back_to_login_button}" Command="{Binding GoToLoginCommand}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer (Versão) -->
                    <cc:TrlVersionFooter Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0"
                                         LauncherVersion="{x:Static helpers:LauncherUpdateHelper.CurrentVersion}"
                                         ServerVersion="{Binding ServerVersion}"/>
                </Grid>
            </Border>
        </Grid>
        <!-- item 001: laser recuado no TitleBar (LaserMargin) p/ telas de auth. -->
    </Grid>
</UserControl>
