<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:model="using:SPT.Launcher.Models.Launcher"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.SettingsView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <!-- Dot Dev Mode: quadrado (radius 0), cor 100% via token dirigida pelo
         estado reativo IsDevMode (class binding) — nenhuma cor mora na VM. -->
    <UserControl.Styles>
        <Style Selector="Border.dev-dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource TrlFgFaintBrush}"/>
        </Style>
        <Style Selector="Border.dev-dot.on">
            <Setter Property="Background" Value="{DynamicResource TrlSuccessBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto, *">

        <!-- 1. SIDEBAR (TrlSidebarNav — mesmo chrome da ProfileView). Escondida no modo enxuto
             (aberto a partir de um erro de conexão) — aí a coluna Auto colapsa e o painel ocupa tudo. -->
        <cc:TrlSidebarNav Grid.Column="0" IsVisible="{Binding ShowSidebar}">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Logo Topo (item 006: desce um pouco + respiro antes do menu; paridade com ProfileView) -->
                <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="52" HorizontalAlignment="Center" Margin="24,56,24,16"/>

                <!-- Menu Central -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,28,0,0">
                    <Button Classes="nav" Cursor="Hand" Command="{Binding GoBackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconHome}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_launcher}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Item 033: MODS & CONFIGS no menu (2º item) — padrão canônico da ProfileView/ModsConfigsView. -->
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenModsConfigsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconMenu2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_mods_configs}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav active" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconSettings}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenKofiCommand}">
                        <!-- xícara à esquerda, texto no meio, link-externo à extremidade direita -->
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Data="{StaticResource TrlIconCoffee}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Path DockPanel.Dock="Right" Data="{StaticResource TrlIconExternalLink}" Width="12" Height="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_support_kofi}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </cc:TrlSidebarNav>

        <!-- 2. ÁREA CENTRAL (PAINEL DE CONFIGURAÇÕES) -->
        <Grid Grid.Column="1">

            <!-- Imagem de Fundo + overlay (legibilidade sobre foto clara, paridade ProfileView) -->
            <Image Source="{Binding Background.Path, Converter={StaticResource imageSourceCvt}}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <Border Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- Conteúdo Scrolável (item 007: top 34px da top bar + 30 de respiro → título não encosta) -->
            <ScrollViewer Margin="30,64,30,30" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="20">

                    <!-- Modo enxuto (sem sidebar): botão de voltar. GoBackCommand salva as configs e
                         volta pra tela anterior (ConnectServer re-ativa e reconecta). -->
                    <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=save_and_go_back}" Classes="ghost" HorizontalAlignment="Left"
                            Cursor="Hand" IsVisible="{Binding SlimMode}"
                            Command="{Binding GoBackCommand}"/>

                    <TextBlock Classes="trl-h1" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=settings}" Margin="0,0,0,10"/>

                    <!-- Operações - Limpeza e Dados -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=settings_section_cleanup_data}">
                        <Grid ColumnDefinitions="*, *, *">
                            <Button Grid.Column="0" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clear_game_settings}"
                                    Command="{Binding ClearGameSettingsCommand}" Cursor="Hand" Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clear_game_settings_tooltip}"/>

                            <Button Grid.Column="1" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clean_temp_files}"
                                    Command="{Binding CleanTempFilesCommand}" Cursor="Hand" Margin="5,0,5,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clean_temp_files_tooltip}"/>

                            <Button Grid.Column="2" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=copy_logs_to_clipboard}"
                                    Command="{Binding CopyLogsToClipboard}" Cursor="Hand" Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=copy_logs_tooltip}"/>
                        </Grid>
                    </cc:TrlPanel>

                    <!-- Opções Básicas -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=settings_section_basic_options}">
                        <StackPanel Spacing="15">

                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=default_language}"/>
                                <ComboBox x:Name="LanguageCombo" ItemsSource="{Binding Locales.AvailableLocales}" MinWidth="300"
                                          SelectedItem="{Binding Locales.SelectedLocale, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=on_game_start}"/>
                                <cc:LocalizedLauncherActionSelector />
                            </StackPanel>

                            <!-- Item 030: o toggle "Usar configs de performance" saiu daqui (D-12) —
                                 performance agora vive na tela "Mods e Configs", item a item. -->

                            <!-- Dev Mode — protegido por senha -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="300">
                                    <TextBox Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=admin_password_watermark}"
                                             PasswordChar="{Binding DevPasswordChar}"
                                             Text="{Binding DevPassword, Mode=TwoWay}"
                                             Padding="30,6,30,6"/>
                                    <!-- adorno de cadeado (DS) à esquerda; não intercepta clique no campo -->
                                    <Path Data="{StaticResource TrlIconLock}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="8,0,0,0" IsHitTestVisible="False"
                                          Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                    <Button Classes="icon" Command="{Binding ToggleDevPasswordVisibilityCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,2,0" Cursor="Hand" ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=toggle_password_visibility}">
                                        <!-- ícones traçados do DS; olho fechado = senha oculta (clique p/ revelar) -->
                                        <Panel>
                                            <Path Data="{StaticResource TrlIconEye}" IsVisible="{Binding !IsDevPasswordVisible}"
                                                  Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                                  Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                            <Path Data="{StaticResource TrlIconEyeOff}" IsVisible="{Binding IsDevPasswordVisible}"
                                                  Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                                  Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                        </Panel>
                                    </Button>
                                </Grid>
                                <Button Command="{Binding ToggleDevModeCommand}" Cursor="Hand"
                                        ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=toggle_dev_mode_tooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource TrlIconLockOpen}" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                              Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter"/>
                                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=dev_mode}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Classes="dev-dot"
                                        Classes.on="{Binding IsDevMode, Source={x:Static helpers:LauncherSettingsProvider.Instance}}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding DevModeStatusText}"/>
                            </StackPanel>

                            <!-- Descrição intuitiva do Dev Mode: pra quem CRIA mods, não jogador comum.
                                 Reflete o comportamento pós-regras config-*: preserva arquivos/builds locais
                                 (não reverte) + pula a verificação automática no login. -->
                            <TextBlock Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}" TextWrapping="Wrap"
                                       MaxWidth="460" HorizontalAlignment="Left"
                                       Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=dev_mode_description}"/>
                        </StackPanel>
                    </cc:TrlPanel>

                    <!-- Painel Dev Mode -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=settings_section_dev_tools}" IsVisible="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=IsDevMode}">
                        <StackPanel Spacing="15">

                            <!-- Edição de URL Local -->
                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=server_url_label}"/>
                                <TextBox Watermark="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=server_url_watermark}"
                                         Text="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=Server.Url, Mode=TwoWay}"
                                         MaxWidth="300" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Atalho: usar servidor local (guarda a URL atual, restaura ao desmarcar) -->
                            <StackPanel Spacing="2">
                                <CheckBox Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=use_local_server_checkbox}"
                                          IsChecked="{Binding UseLocalServer}"
                                          ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=use_local_server_tooltip}"/>
                                <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" TextWrapping="Wrap"
                                           MaxWidth="460" HorizontalAlignment="Left"
                                           Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=use_local_server_description}"/>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <CheckBox Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=block_launcher_update_checkbox}"
                                          IsChecked="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=DisableUpdates}"
                                          ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=block_launcher_update_tooltip}"/>
                                <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" TextWrapping="Wrap"
                                           MaxWidth="460" HorizontalAlignment="Left"
                                           Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=block_launcher_update_description}"/>
                            </StackPanel>

                            <!-- Modo homolog: prefixa as rotas do mod com /homolog (bate no TarkovRedLine.Server.Homolog) -->
                            <StackPanel Spacing="2">
                                <CheckBox Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=homolog_mode_checkbox}"
                                          IsChecked="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=HomologMode}"
                                          ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=homolog_mode_tooltip}"/>
                                <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}"
                                           Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=homolog_mode_description}"/>
                            </StackPanel>

                            <Button x:Name="ofb" Command="{Binding OpenGameFolderCommand}" Cursor="Hand" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource TrlIconFolder}" Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}" Width="16" Height="16" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=open_folder}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </cc:TrlPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
