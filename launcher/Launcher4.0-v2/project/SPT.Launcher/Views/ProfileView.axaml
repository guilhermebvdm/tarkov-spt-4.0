<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.ProfileView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
        <!-- item 012: separador de milhar PT-BR no contador de XP -->
        <cvt:ThousandSeparatorConverter x:Key="thousandsCvt"/>
    </UserControl.Resources>

    <!-- Dots do carrossel de fundo: quadradinho (radius 0), inativo faint / ativo accent, cursor hand -->
    <UserControl.Styles>
        <Style Selector="Button.carousel-dot">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.carousel-dot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.carousel-dot-fill">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource TrlFgFaintBrush}"/>
        </Style>
        <Style Selector="Border.carousel-dot-fill.active">
            <Setter Property="Background" Value="{DynamicResource TrlAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Nav buttons: Button.nav agora é global (Assets/Theme/Controls/Nav.axaml, item 024) -->

    <Grid ColumnDefinitions="Auto, *">

        <!-- 1. SIDEBAR (TrlSidebarNav — chrome do tema) -->
        <cc:TrlSidebarNav Grid.Column="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Logo Topo (item 006: desce um pouco + respiro antes do menu) -->
                <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="52" HorizontalAlignment="Center" Margin="24,56,24,16"/>

                <!-- Menu Central -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,28,0,0">
                    <Button Classes="nav active" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconHome}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_launcher}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconSettings}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenKofiCommand}">
                        <!-- xícara à esquerda, texto no meio, link-externo à extremidade direita -->
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Data="{StaticResource TrlIconCoffee}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Path DockPanel.Dock="Right" Data="{StaticResource TrlIconExternalLink}" Width="12" Height="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_support_coffee}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_under_construction_tooltip}" IsEnabled="False" Opacity="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconMenu2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=nav_mods_list}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sair / Logout -->
                <Button Grid.Row="2" Cursor="Hand" Margin="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="{StaticResource TrlIconArrowBackUp}" Stroke="{DynamicResource TrlAccentBrush}" StrokeThickness="1.75" Fill="{x:Null}" Width="18" Height="18" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=sidebar_logout}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </cc:TrlSidebarNav>

        <!-- 2. ÁREA CENTRAL (CARROSSEL E JOGO) -->
        <!-- item 010: ClipToBounds contém o zoom do fundo dentro da coluna (não vaza p/ o sidebar) -->
        <Grid Grid.Column="1" ClipToBounds="True">

            <!-- Fundo da tela logada: key art do EFT (bg-hero, vinda da tela de login) + overlay olive p/ legibilidade.
                 item 010: a imagem (2500x1610) preenche exatamente a altura e é cortada só na horizontal,
                 então VerticalAlignment não teria efeito. Zoom ancorado no topo (origem 0.5,0) empurra as
                 cabeças e a logo EFT p/ baixo (longe do laser) e corta a base (menos relevante). UniformToFill
                 preservado (escala uniforme, sem distorção). -->
            <!-- item carrossel: Source dinâmico (Image_Cache/bg ∪ bundlado) trocando a cada 10s.
                 TranslateTransform X=-50 desloca a arte ~50px à esquerda (dentro do ClipToBounds). -->
            <Image Source="{Binding Carousel.CurrentBackground}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                   RenderTransformOrigin="0.5,0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                        <TranslateTransform X="-50"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <!-- overlay mais leve (menos ofuscação) — a key art fica mais visível -->
            <Border Background="{DynamicResource TrlPhotoOverlaySoftBrush}" IsHitTestVisible="False"/>

            <!-- Layout Sobreposto da Tela Principal -->
            <Grid RowDefinitions="*, AUTO, AUTO">

                <!-- CONTEÚDO TOP/RIGHT -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,50,20,0" Width="250" Spacing="8">

                    <!-- Box: VERSÃO -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=version_panel_title}" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=version_server_label}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding ServerVersion}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=version_launcher_label}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding Source={x:Static helpers:LauncherUpdateHelper.CurrentVersion}}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </cc:TrlPanel>

                    <!-- Box: MODS OPCIONAIS (item 009: descrição visível abaixo do nome) -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=optional_mods_panel_title}" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <ItemsControl ItemsSource="{Binding OptionalMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <CheckBox Content="{Binding Name}"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsEnabled}"/>
                                        <TextBlock Classes="trl-muted"
                                                   FontSize="{DynamicResource TrlTextXs}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </cc:TrlPanel>

                    <!-- Box: CONTA -->
                    <cc:TrlPanel Title="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_panel_title}" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <StackPanel Spacing="8">
                            <!-- ref: CR-01-03 — mesmo gate do EXCLUIR: mudar edição dispara wipe
                                 (Remove+Register) e não pode rodar com o jogo em execução -->
                            <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_change_edition_button}" Classes="sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding ChangeEditionCommand}"
                                    IsEnabled="{Binding CanStartGame}"/>

                            <!-- ref: CR-01-03 — idem: wipe no meio da sessão é tão destrutivo quanto o delete -->
                            <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_wipe_button}" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding WipeConfirmCommand}"
                                    IsEnabled="{Binding CanStartGame}"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_wipe_tooltip}"/>

                            <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_delete_button}" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding DeleteAccountCommand}"
                                    IsEnabled="{Binding CanStartGame}"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_delete_tooltip}"/>

                            <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=account_wipe_delete_explainer}"/>
                        </StackPanel>
                    </cc:TrlPanel>

                </StackPanel>

                <!-- Dots do carrossel: base central, logo acima da barra de progresso/status -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Carousel.Dots}" IsVisible="{Binding Carousel.HasMultiple}"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="carousel-dot" Command="{Binding SelectCommand}" Cursor="Hand"
                                    ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=carousel_change_background_tooltip}">
                                <Border Classes="carousel-dot-fill" Classes.active="{Binding IsActive}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BARRA DE PROGRESSO / UPDATE (item 007: cancelar + link do relatório) -->
                <StackPanel Grid.Row="1" Margin="20,0,20,5" IsVisible="{Binding IsUpdateVisible}" Spacing="5" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding UpdateStatusText}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ProgressBar Minimum="0" Maximum="{Binding UpdateMaxProgress}" Value="{Binding UpdateProgress}" VerticalAlignment="Center"/>
                        <!-- velocidade de download removida a pedido -->
                        <Button Grid.Column="2" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=update_cancel_button}" Classes="ghost sm" Cursor="Hand" Margin="8,0,0,0"
                                Command="{Binding CancelUpdateCommand}" IsVisible="{Binding CanCancelUpdate}"
                                ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=update_cancel_tooltip}"/>
                    </Grid>
                    <!-- 4.1.3: clicar abre a pasta do last-update.json -->
                    <Button Content="{Binding LastUpdateText}" Classes="link" Cursor="Hand" HorizontalAlignment="Left" Padding="0"
                            FontSize="{DynamicResource TrlTextXs}"
                            Command="{Binding OpenLastUpdateFolderCommand}" IsVisible="{Binding HasLastUpdate}"
                            ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=last_update_report_tooltip}"/>
                </StackPanel>

                <!-- STATUS BAR INFERIOR (PERFIL E AÇÕES) -->
                <Border Grid.Row="2" Background="{DynamicResource TrlPanelOverPhotoBrush}" BorderBrush="{DynamicResource TrlEdgeBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Margin="0" Padding="15,10">
                    <Grid ColumnDefinitions="AUTO, *, AUTO">

                        <!-- Perfil (Esquerda) -->
                        <Image Grid.Column="0" Source="{Binding SideImage.Path, Converter={StaticResource imageSourceCvt}}" Width="60" Height="60" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ProfileInfo.Level, StringFormat='Nível: {0}'}" Classes="trl-accent" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                                <!-- XP barra expandida (ProgressBar do tema) -->
                                <ProgressBar Value="{Binding ProfileInfo.XPLevelProgress}" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="150"/>
                                <TextBlock Text="{Binding ProfileInfo.RemainingExp, Converter={StaticResource thousandsCvt}, ConverterParameter='Faltam: {0:N0} xp'}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ProfileInfo.Nickname, StringFormat='Operador: {0}'}" Foreground="{DynamicResource TrlFgBrush}" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                            <!-- item 013: classe do operador (edição do CustomClasses) -->
                            <TextBlock Text="{Binding CurrentEdition, StringFormat='Classe: {0}'}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}"
                                       IsVisible="{Binding CurrentEdition, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CurrentId, StringFormat='Id: {0}'}" Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" Cursor="Hand"
                                       ToolTip.Tip="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=profile_id_copy_tooltip}"
                                       PointerPressed="CopyIdToClipboard"
                                       TextDecorations="Underline"/>
                            <TextBlock Text="{Binding ProfileInfo.Side, StringFormat='Facção: {0}'}" Classes="trl-accent" FontSize="{DynamicResource TrlTextXs}"/>
                        </StackPanel>

                        <!-- Ações (Direita) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10" Width="180">
                            <!-- Verificar Arquivos (outlined base) — ref: CR-01-01: também travado durante sync -->
                            <Button Classes="sm" Cursor="Hand" Command="{Binding VerifyFilesCommand}" IsEnabled="{Binding CanVerifyFiles}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource TrlIconSearch}" Stroke="{DynamicResource TrlFgMutedBrush}" StrokeThickness="1.75" Fill="{x:Null}"
                                          Width="13" Height="13" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=verify_files_button}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- JOGAR (.primary — tan, R1) -->
                            <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=play_button}" Classes="primary" Cursor="Hand" Command="{Binding StartGameCommand}" IsEnabled="{Binding CanStartGame}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15,10" FontWeight="Bold" FontSize="{DynamicResource TrlTextLg}"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
