<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SPT.Launcher.Views.ConnectServerView">

  <Grid RowDefinitions="*,AUTO,AUTO,AUTO,*" Background="{DynamicResource TrlBgAppBrush}">

    <Label Content="{Binding connectModel.InfoText}" Grid.Row="1"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Foreground="{DynamicResource TrlFgMutedBrush}"
           FontFamily="{DynamicResource TrlFontDisplay}"
           FontSize="{DynamicResource TrlTextMd}"
           Margin="0,0,0,10"
           />
    <ProgressBar Grid.Row="2" HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="300"
                 IsIndeterminate="{Binding !connectModel.ConnectionFailed}"
                 Classes.error="{Binding connectModel.ConnectionFailed}"
                 IsVisible="{Binding !connectModel.IsDownloading}"
                 />

    <ProgressBar Grid.Row="2" HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="300"
                 Minimum="0" Maximum="100"
                 Value="{Binding connectModel.DownloadProgress}"
                 IsVisible="{Binding connectModel.IsDownloading}"
                 />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10"
                Margin="10,16" HorizontalAlignment="Center"
                IsVisible="{Binding connectModel.ConnectionFailed}">
      <Button Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=retry}"
              Command="{Binding RetryCommand}"/>
      <!-- Acesso a Configurações no erro (ex.: trocar URL do servidor). Abre modo enxuto; ao voltar, reconecta. -->
      <Button Content="CONFIGURAÇÕES" Classes="ghost" Cursor="Hand"
              Command="{Binding OpenSettingsCommand}"/>
    </StackPanel>

  </Grid>

</UserControl>
