<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\spt-logo.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <AssemblyName>Tarkov Red Line</AssemblyName>
    <Product>Tarkov Red Line</Product>
    <Version>2.6.2</Version>
    <AssemblyVersion>2.6.2.0</AssemblyVersion>
    <FileVersion>2.6.2.0</FileVersion>
    <InformationalVersion>2.6.2</InformationalVersion>
    <!-- Server lê ProductVersion (=InformationalVersion) do exe p/ auto-update:
         sem o sufixo +sha, senão IsNewerVersion/Version.TryParse falha (item 014). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\tailscale-setup-1.98.4-amd64.msi">
      <LogicalName>TailscaleInstaller</LogicalName>
    </EmbeddedResource>
    <!-- i18n (TRL): locales OFICIAIS completos embutidos no exe. O LocaleBootstrap os escreve na pasta
         de runtime no boot se faltarem/divergirem (a do SPT server é vanilla, sem as chaves do TRL). -->
    <None Remove="SPT_Data\Launcher\Locales\English.json" />
    <None Remove="SPT_Data\Launcher\Locales\Portuguese.json" />
    <EmbeddedResource Include="SPT_Data\Launcher\Locales\English.json">
      <LogicalName>locale.English.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SPT_Data\Launcher\Locales\Portuguese.json">
      <LogicalName>locale.Portuguese.json</LogicalName>
    </EmbeddedResource>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaXaml Remove="Properties\**" />
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
    <!-- Theme axaml files are compiled XAML (AvaloniaXaml default glob), not raw resources -->
    <AvaloniaResource Remove="Assets\Theme\**\*.axaml" />
    <None Remove=".gitignore" />
    <None Remove="Assets\SPT-logo.png" />
    <None Remove="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.1" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="0.10.12" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.1" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.8.0-avalonia11dot1-3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SPT.ByteBanger\SPT.ByteBanger.csproj" />
    <ProjectReference Include="..\SPT.Launcher.Base\SPT.Launcher.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="zlib.net">
      <HintPath>References\zlib.net.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
