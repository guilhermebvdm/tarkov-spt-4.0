<!--
  TRL Theme - Icons.axaml
  Ícones do Design System portados do sprite Tabler requadrado (design-system/assets/icons.svg).
  Tabler é TRAÇADO (stroke), então cada geometria é renderizada com Stroke + StrokeThickness=1.75
  + Fill="none" no ponto de uso (NÃO Fill). viewBox nativo 0..24 → use Width/Height + Stretch="Uniform".

  Uso:
    <Path Data="{StaticResource TrlIconSettings}" Stroke="{DynamicResource TrlFgMutedBrush}"
          StrokeThickness="1.75" Fill="none" Width="18" Height="18" Stretch="Uniform"
          StrokeLineCap="Flat" StrokeJoin="Miter"/>
  (linecap butt / linejoin miter = hard-edges do DS)

  Mapa launcher → DS: settings→gear, open-folder→folder, senha→eye/eye-off, dev→lock/lock-open,
  Kofi→external-link, voltar→arrow-back-up, lista→menu-2, sair→logout, fechar→x, minimizar→minus.
  Nav "LAUNCHER"(home) e "cubo de mods" não têm 1:1 no set → target/crosshair como aproximação tática.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- chrome / ações -->
	<StreamGeometry x:Key="TrlIconSettings">M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0</StreamGeometry>
