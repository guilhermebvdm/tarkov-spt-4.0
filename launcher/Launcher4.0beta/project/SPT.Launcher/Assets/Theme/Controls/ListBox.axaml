<!--
  TRL Theme - ListBox.axaml
  Scoped to ListBox.trl-nav (sidebar navigation look): item 36px, 2px left accent
  bar + tan wash on selection. Plain ListBox is untouched (views own their styles).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="ListBox.trl-nav">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
	</Style>

	<Style Selector="ListBox.trl-nav ListBoxItem">
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding" Value="12,0"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="BorderThickness" Value="2,0,0,0"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TrlFgMutedBrush}"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>

	<Style Selector="ListBox.trl-nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource TrlBgHoverBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TrlFgBrush}"/>
	</Style>

	<Style Selector="ListBox.trl-nav ListBoxItem:selected">
		<Setter Property="BorderBrush" Value="{DynamicResource TrlAccentBrush}"/>
	</Style>
	<Style Selector="ListBox.trl-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource TrlBgActiveBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TrlFgBrush}"/>
	</Style>
	<Style Selector="ListBox.trl-nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource TrlBgActiveBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TrlFgBrush}"/>
	</Style>

</Styles>
