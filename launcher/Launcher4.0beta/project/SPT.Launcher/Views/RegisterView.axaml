<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:base="clr-namespace:SPT.Launcher;assembly=SPT.Launcher.Base"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.RegisterView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <Grid>
        <!-- TAQUILA em tela cheia, render nítido (posição original) — a cena aparece através do painel de vidro -->
        <Image Source="/Assets/bg1.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <Grid ColumnDefinitions="*, 450">

            <!-- Scrim atrás do painel (Coluna 1) p/ legibilidade AA — a arte à esquerda fica nítida -->
            <Border Grid.Column="1" Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- 2. ÁREA CENTRAL (REGISTRO) - painel de vidro (50%) com margem uniforme -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource TrlEdgeBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource TrlPanelAuthBrush}"
                    Padding="40,56,40,40">
                <Grid RowDefinitions="Auto, *, Auto">

                    <!-- Logo Topo (abaixo da top bar de 34px; respeita a margem do painel) -->
                    <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="56" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- Painel de Registro -->
                    <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="CRIE SUA CONTA" Classes="trl-h3"
                                   LetterSpacing="{DynamicResource TrlTrackWider}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="DEFINA SEU USUÁRIO" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding RegisterUsername, Mode=TwoWay}" Watermark="Escolha um nome de usuário"/>

                        <TextBlock Text="CRIE UMA SENHA" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding RegisterPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Digite sua senha"/>

                        <TextBlock Text="CONFIRME A SENHA" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Repita a senha"/>

                        <TextBlock Text="{Binding RegisterErrorMsg}" Classes="trl-danger" FontSize="{DynamicResource TrlTextSm}" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <Button Content="CRIAR CONTA" Command="{Binding GoToClassSelectionCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,20"/>

                        <Separator Margin="0,10"/>

                        <TextBlock Text="Já possui uma conta?" Classes="trl-muted" FontSize="{DynamicResource TrlTextSm}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="VOLTAR PARA LOGIN" Command="{Binding GoToLoginCommand}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer (Versão) -->
                    <cc:TrlVersionFooter Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0"
                                         LauncherVersion="{x:Static helpers:LauncherUpdateHelper.CurrentVersion}"
                                         ServerVersion="{x:Static base:ServerManager.TrlServerVersion}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
