<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:base="clr-namespace:SPT.Launcher;assembly=SPT.Launcher.Base"
             x:Class="SPT.Launcher.Views.ClassSelectionView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <Grid>
        <!-- Fundo hero + overlay TRL (padrão dos pilotos Login/Register) -->
        <Image Source="/Assets/bg-hero.jpg" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Border Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

        <Grid ColumnDefinitions="300, *">

            <!-- Coluna 0: lista de classes -->
            <Border Grid.Column="0"
                    Background="{DynamicResource TrlPanelOverPhotoBrush}"
                    BorderBrush="{DynamicResource TrlEdgeBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="16">

                    <TextBlock Grid.Row="0" Text="SELEÇÃO DE CLASSE" Classes="trl-label"
                               LetterSpacing="{DynamicResource TrlTrackWider}"
                               Margin="0,8,0,16"/>

                    <Grid Grid.Row="1">
                        <ListBox Classes="trl-nav"
                                 ItemsSource="{Binding AvailableClasses}"
                                 SelectedItem="{Binding SelectedClass}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Image Width="24" Height="24"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath, Converter={StaticResource imageSourceCvt}}"
                                               IsVisible="{Binding HasIcon}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <!-- Dois TextBlocks alternados: com nameColor do server ou herdando o foreground por estado do trl-nav -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{Binding NameBrush}"
                                                   IsVisible="{Binding HasNameColor}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasNameColor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Carregando classes..." Classes="trl-muted"
                                   FontSize="{DynamicResource TrlTextSm}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsLoading}"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding RegisterErrorMsg}" Classes="trl-danger"
                               FontSize="{DynamicResource TrlTextSm}" FontWeight="Bold" TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Grid.Row="3" Spacing="10" Margin="0,16,0,0">
                        <Button Content="ESCOLHER CLASSE" Command="{Binding FinalizeAccountCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Content="VOLTAR" Command="{Binding GoToRegisterCommand}"
                                Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <cc:TrlVersionFooter HorizontalAlignment="Center" Margin="0,10,0,0"
                                             LauncherVersion="{x:Static helpers:LauncherUpdateHelper.CurrentVersion}"
                                             ServerVersion="{x:Static base:ServerManager.TrlServerVersion}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coluna 1: detalhe da classe selecionada -->
            <cc:TrlPanel Grid.Column="1" Margin="40" Padding="0" ShowHeader="False"
                         Background="{DynamicResource TrlPanelOverPhotoBrush}"
                         VerticalAlignment="Stretch"
                         IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                    <cc:TrlScreenBar DockPanel.Dock="Top"
                                     Title="{Binding SelectedClass.NameUpper}"
                                     Meta="CLASSE"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16" Spacing="12">
                            <TextBlock Text="DESCRIÇÃO DA CLASSE" Classes="trl-label"/>
                            <TextBlock Text="{Binding SelectedClass.Description}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource TrlTextMd}"
                                       LineHeight="22"
                                       Foreground="{DynamicResource TrlFgMutedBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </cc:TrlPanel>
        </Grid>
    </Grid>
</UserControl>
