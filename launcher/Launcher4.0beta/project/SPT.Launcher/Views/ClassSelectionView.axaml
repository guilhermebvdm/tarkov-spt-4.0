<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SPT.Launcher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.ClassSelectionView">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Imagem de Fundo (bg2) -->
        <Image Source="/Assets/bg2.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <!-- Conteúdo transparente -->
        <Grid Background="Transparent">
        <Grid ColumnDefinitions="300, *">
            
            <!-- Lista de Classes -->
            <Border Grid.Column="0" BorderBrush="#333" BorderThickness="0,0,1,0" Background="#B3000000">
                <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="15">
                    <TextBlock Grid.Row="0" Text="SELEÇÃO DE CLASSE" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableClasses}" SelectedItem="{Binding SelectedClass}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <TextBlock Grid.Row="2" Text="{Binding RegisterErrorMsg}" Foreground="#CC1111" FontSize="12" FontWeight="Bold" Margin="0,10,0,0" IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Grid.Row="3" Spacing="10" Margin="0,20,0,0">
                        <Button Content="Escolher classe ✔️" Command="{Binding FinalizeAccountCommand}" Background="#990000" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Content="Voltar" Command="{Binding GoToRegisterCommand}" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Center"/>
                        
                        <!-- Footer (Versão) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" Spacing="5">
                            <TextBlock Text="Versão do launcher:" Foreground="LightGray" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="15.0" Foreground="#CC1111" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="|" Foreground="LightGray" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Versão do servidor:" Foreground="LightGray" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="0.10" Foreground="#CC1111" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalhes da Classe -->
            <Grid Grid.Column="1" Margin="40" DataContext="{Binding SelectedClass}">
                <Grid ColumnDefinitions="300, *" RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Name}" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,0,0,30"/>
                    
                    <!-- Imagem Mock -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Margin="0,0,30,0" Background="#1A1A1A">
                        <Grid>
                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                            <!-- Fallback texto se não tiver imagem -->
                            <TextBlock Text="[Imagem do Personagem]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="True"/>
                        </Grid>
                    </Border>

                    <!-- Textos e Atributos -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Descrição da Classe" Foreground="LightGray" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding Description}" Foreground="#AAAAAA" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                            
                            <!-- Vantagens -->
                            <TextBlock Text="Vantagens:" Foreground="LightGray" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
                            <ItemsControl ItemsSource="{Binding Advantages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#00CC66" FontSize="14" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Desvantagens -->
                            <TextBlock Text="Desvantagens:" Foreground="LightGray" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
                            <ItemsControl ItemsSource="{Binding Disadvantages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#CC3333" FontSize="14" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Habilidades -->
                            <TextBlock Text="Habilidades:" Foreground="LightGray" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2">
                                            <TextBlock Text="•" Foreground="#CCCCCC" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
