<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:model="using:SPT.Launcher.Models.Launcher"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.SettingsView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <!-- Dot Dev Mode: quadrado (radius 0), cor 100% via token dirigida pelo
         estado reativo IsDevMode (class binding) — nenhuma cor mora na VM. -->
    <UserControl.Styles>
        <Style Selector="Border.dev-dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource TrlFgFaintBrush}"/>
        </Style>
        <Style Selector="Border.dev-dot.on">
            <Setter Property="Background" Value="{DynamicResource TrlSuccessBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto, *">

        <!-- 1. SIDEBAR (TrlSidebarNav — mesmo chrome da ProfileView) -->
        <cc:TrlSidebarNav Grid.Column="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Logo Topo (item 006: desce um pouco + respiro antes do menu; paridade com ProfileView) -->
                <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="52" HorizontalAlignment="Center" Margin="24,56,24,16"/>

                <!-- Menu Central -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,28,0,0">
                    <Button Classes="nav" Cursor="Hand" Command="{Binding GoBackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12 5.69l5 4.5V18h-2v-6H9v6H7v-7.81l5-4.5M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCHER" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav active" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" VerticalAlignment="Center"/>
                            <TextBlock Text="CONFIGURAÇÕES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenKofiCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M2,21H20V19H2M20,8H18V5H20M20,3H4V13A4,4 0 0,0 8,17H14A4,4 0 0,0 18,13V10H20A2,2 0 0,0 22,8V5C22,3.89 21.1,3 20,3M16,5V13A2,2 0 0,1 14,15H8A2,2 0 0,1 6,13V5H16Z" VerticalAlignment="Center"/>
                            <TextBlock Text="APOIE UM CAFEZINHO" VerticalAlignment="Center"/>
                            <!-- item 005: ícone de link externo (abre no navegador) -->
                            <Path Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"
                                  Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" ToolTip.Tip="Em construção" IsEnabled="False" Opacity="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12.87,15.07L8.33,12.46V7.22L12.87,9.84V15.07M22.67,10L17.43,13.06L12.5,10.22L17.73,7.17L22.67,10M21.5,11.3V15.33C21.5,15.33 21.08,16.5 19.33,16.5C17.58,16.5 17.17,15.33 17.17,15.33V11.3L15.33,12.37V16.5C15.33,16.5 15.33,19.25 19.33,19.25C23.33,19.25 23.33,16.5 23.33,16.5V11.3L21.5,11.3M8.33,13.62L3.8,16.24V11L8.33,8.38V13.62M12.5,22.25L3.8,17.22V6.15L12.5,1.11L21.2,6.15L21.2,9.3L19.33,10.37L12.5,6.43L2,12.5L12.5,18.57L15.33,16.94V19.11L12.5,20.73" VerticalAlignment="Center"/>
                            <TextBlock Text="LISTA DE MODS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </cc:TrlSidebarNav>

        <!-- 2. ÁREA CENTRAL (PAINEL DE CONFIGURAÇÕES) -->
        <Grid Grid.Column="1">

            <!-- Imagem de Fundo + overlay (legibilidade sobre foto clara, paridade ProfileView) -->
            <Image Source="{Binding Background.Path, Converter={StaticResource imageSourceCvt}}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <Border Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- Conteúdo Scrolável (item 007: top 34px da top bar + 30 de respiro → título não encosta) -->
            <ScrollViewer Margin="30,64,30,30" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="20">

                    <TextBlock Classes="trl-h1" Text="CONFIGURAÇÕES" Margin="0,0,0,10"/>

                    <!-- Operações - Limpeza e Dados -->
                    <cc:TrlPanel Title="LIMPEZA E DADOS">
                        <Grid ColumnDefinitions="*, *, *">
                            <Button Grid.Column="0" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clear_game_settings}"
                                    Command="{Binding ClearGameSettingsCommand}" Cursor="Hand" Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="1" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=clean_temp_files}"
                                    Command="{Binding CleanTempFilesCommand}" Cursor="Hand" Margin="5,0,5,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <Button Grid.Column="2" Content="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=copy_logs_to_clipboard}"
                                    Command="{Binding CopyLogsToClipboard}" Cursor="Hand" Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </cc:TrlPanel>

                    <!-- Opções Básicas -->
                    <cc:TrlPanel Title="OPÇÕES BÁSICAS">
                        <StackPanel Spacing="15">

                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=default_language}"/>
                                <ComboBox x:Name="LanguageCombo" ItemsSource="{Binding Locales.AvailableLocales}" MinWidth="300"
                                          SelectedItem="{Binding Locales.SelectedLocale, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=on_game_start}"/>
                                <cc:LocalizedLauncherActionSelector />
                            </StackPanel>

                            <!-- Item 008: configs de performance (overlay via motor de sync) -->
                            <StackPanel Spacing="4">
                                <ToggleSwitch IsChecked="{Binding UsePerformanceConfigs, Mode=TwoWay}"
                                              OnContent="Ativado" OffContent="Desativado" Cursor="Hand">
                                    <ToggleSwitch.Content>
                                        <TextBlock Classes="trl-label" Text="USAR CONFIGS PERFORMANCE"/>
                                    </ToggleSwitch.Content>
                                </ToggleSwitch>
                                <!-- ref: CR-01-03 — texto reflete a semântica real do preserve-divergent:
                                     arquivo modificado desde a última sincronização (por você ou pelo
                                     próprio jogo) é preservado também no desligar; não prometer
                                     restauração incondicional. -->
                                <TextBlock Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}" TextWrapping="Wrap"
                                           MaxWidth="460" HorizontalAlignment="Left"
                                           Text="Aplica o pacote de configurações de performance do servidor na próxima verificação de arquivos. Configs que você personalizou são preservadas. Ao desligar, a próxima verificação restaura as configs padrão do servidor que não foram modificadas desde a última sincronização — as demais permanecem como estão."/>
                            </StackPanel>

                            <!-- Dev Mode — protegido por senha -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="300">
                                    <TextBox Watermark="🔒 Senha admin"
                                             PasswordChar="{Binding DevPasswordChar}"
                                             Text="{Binding DevPassword, Mode=TwoWay}"
                                             Padding="8,6,30,6"/>
                                    <Button Classes="icon" Command="{Binding ToggleDevPasswordVisibilityCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,2,0" Cursor="Hand" ToolTip.Tip="Mostrar/ocultar senha">
                                        <TextBlock Text="{Binding DevPasswordEyeIcon}"/>
                                    </Button>
                                </Grid>
                                <Button Command="{Binding ToggleDevModeCommand}" Cursor="Hand"
                                        ToolTip.Tip="Ativar/Desativar modo desenvolvedor">
                                    <TextBlock Text="🔑 Dev Mode"/>
                                </Button>
                                <Border Classes="dev-dot"
                                        Classes.on="{Binding IsDevMode, Source={x:Static helpers:LauncherSettingsProvider.Instance}}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding DevModeStatusText}"/>
                            </StackPanel>
                        </StackPanel>
                    </cc:TrlPanel>

                    <!-- Painel Dev Mode -->
                    <cc:TrlPanel Title="FERRAMENTAS DEV" IsVisible="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=IsDevMode}">
                        <StackPanel Spacing="15">

                            <!-- Edição de URL Local -->
                            <StackPanel Spacing="4">
                                <TextBlock Classes="trl-label" Text="URL DO SERVIDOR (LOCAL/CUSTOM)"/>
                                <TextBox Watermark="Ex: http://127.0.0.1:6969"
                                         Text="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=Server.Url, Mode=TwoWay}"
                                         MaxWidth="300" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <CheckBox Content="Bloquear atualizações (Desativar verificador)"
                                      IsChecked="{Binding Source={x:Static helpers:LauncherSettingsProvider.Instance}, Path=DisableUpdates}"/>

                            <Button x:Name="ofb" Command="{Binding OpenGameFolderCommand}" Cursor="Hand" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource OpenFolder}" Fill="{DynamicResource TrlFgMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationProvider.Instance}, Path=open_folder}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </cc:TrlPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
