<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:launcher="using:SPT.Launcher.Models.Launcher"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:base="clr-namespace:SPT.Launcher;assembly=SPT.Launcher.Base"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.LoginView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <Grid>
        <!-- TAQUILA em tela cheia, render nítido (posição original) — a cena aparece através do painel de vidro -->
        <Image Source="/Assets/bg1.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <Grid ColumnDefinitions="*, 450">

            <!-- Scrim atrás do painel (Coluna 1) p/ legibilidade AA — a arte à esquerda fica nítida -->
            <Border Grid.Column="1" Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- 2. ÁREA CENTRAL (LOGIN) - painel de vidro (50%) com margem uniforme -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource TrlEdgeBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource TrlPanelAuthBrush}"
                    Padding="40,56,40,40">
                <Grid RowDefinitions="Auto, *, Auto">

                    <!-- Logo Topo (abaixo da top bar de 34px; respeita a margem do painel) -->
                    <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="56" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- Painel de Login -->
                    <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="BEM-VINDO" Classes="trl-h3"
                                   LetterSpacing="{DynamicResource TrlTrackWider}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="USUÁRIO" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding Login.Username, Mode=TwoWay}" Watermark="Insira seu usuário"/>

                        <TextBlock Text="SENHA" Classes="trl-label" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding Login.Password, Mode=TwoWay}" PasswordChar="●" Watermark="Insira sua senha"/>

                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                            <TextBlock Text="Esqueceu a senha?" Classes="trl-muted" FontSize="{DynamicResource TrlTextSm}" VerticalAlignment="Center"/>
                            <Button Content="Redefinir" Command="{Binding ResetPasswordCommand}" Classes="link" FontSize="{DynamicResource TrlTextSm}" Padding="0" Margin="0"/>
                        </StackPanel>

                        <Button Content="ENTRAR" Command="{Binding LoginCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,20"/>

                        <Separator Margin="0,10"/>

                        <TextBlock Text="Ainda não possui uma conta?" Classes="trl-muted" FontSize="{DynamicResource TrlTextSm}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="CADASTRAR" Command="{Binding GoToRegisterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer (Versão) -->
                    <cc:TrlVersionFooter Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0"
                                         LauncherVersion="{x:Static helpers:LauncherUpdateHelper.CurrentVersion}"
                                         ServerVersion="{Binding ServerVersion}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
