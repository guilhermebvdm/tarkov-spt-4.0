<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:launcher="using:SPT.Launcher.Models.Launcher"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.LoginView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.PanelCard">
            <Setter Property="Background" Value="#CC111111"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="250, *">

        <!-- 1. BARRA LATERAL ESQUERDA (SIDEBAR - CLEAN PARA LOGIN) -->
        <Border Grid.Column="0" Background="#111111" BorderThickness="0,0,1,0" BorderBrush="#222">
            <Grid RowDefinitions="120, *, AUTO">
                
                <!-- Logo Topo -->
                <Image Grid.Row="0" Margin="15" Source="/Assets/logo-redline.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Área de Informação de Login -->
                <StackPanel Grid.Row="1" Spacing="20" Margin="20,50,20,0">
                    <TextBlock Text="AUTENTICAÇÃO" Foreground="DarkGray" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Faça login com seu perfil local ou cadastre uma nova conta para iniciar o protocolo Red Line." 
                               Foreground="#555555" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 2. ÁREA CENTRAL (LOGIN) -->
        <Grid Grid.Column="1">
            
            <!-- Imagem de Fundo Estática -->
            <Image Source="{Binding Background.Path, Converter={StaticResource imageSourceCvt}}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <Grid RowDefinitions="*,Auto,20" ColumnDefinitions="*,Auto,*">
                
                <!-- Painel de Login -->
                <Border Grid.Row="1" Grid.Column="1" Classes="PanelCard" Padding="30" Margin="0,0,0,0" IsVisible="{Binding IsLoginState}">
                    <StackPanel Spacing="15" Width="300">
                        <TextBlock Text="BEM-VINDO" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Usuário" Foreground="White" FontSize="14" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding Login.Username, Mode=TwoWay}" Watermark="Insira seu usuário" Classes="dark"/>
                        
                        <TextBlock Text="Senha" Foreground="White" FontSize="14" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding Login.Password, Mode=TwoWay}" PasswordChar="●" Watermark="Insira sua senha" Classes="dark"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                            <TextBlock Text="Esqueceu a senha?" Foreground="White" FontSize="12"/>
                            <Button Content="Redefinir" Command="{Binding ResetPasswordCommand}" Classes="transparent" Foreground="#CC1111" FontSize="12" Padding="0" Margin="0"/>
                        </StackPanel>

                        <Button Content="Entrar" Command="{Binding LoginCommand}" Background="#990000" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,20"/>
                        
                        <Separator Background="#333" Margin="0,10"/>

                        <TextBlock Text="Ainda não possui uma conta?" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="Cadastrar" Command="{Binding GoToRegisterCommand}" Background="#990000" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Painel de Registro -->
                <Border Grid.Row="1" Grid.Column="1" Classes="PanelCard" Padding="30" Margin="0,0,0,0" IsVisible="{Binding IsRegisterState}">
                    <StackPanel Spacing="15" Width="300">
                        <TextBlock Text="CRIE SUA CONTA" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Defina seu usuário" Foreground="White" FontSize="14" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding RegisterUsername, Mode=TwoWay}" Watermark="Usuário" Classes="dark"/>
                        
                        <TextBlock Text="Crie uma senha" Foreground="White" FontSize="14" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding RegisterPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Senha" Classes="dark"/>
                        
                        <TextBlock Text="Confirme a senha" Foreground="White" FontSize="14" Margin="0,0,0,-10"/>
                        <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Confirme a Senha" Classes="dark"/>
                        
                        <TextBlock Text="{Binding RegisterErrorMsg}" Foreground="#CC1111" FontSize="12" FontWeight="Bold" IsVisible="{Binding RegisterErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        
                        <Separator Background="#333" Margin="0,10"/>

                        <Button Content="Criar conta" Command="{Binding CreateAccountCommand}" Background="#990000" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="Voltar para o Login" Command="{Binding GoToLoginCommand}" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Painel de Seleção de Classes (Tela 3 - Mock) -->
                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Classes="PanelCard" IsVisible="{Binding IsClassSelectionState}" Background="#F2080808">
                    <Grid ColumnDefinitions="300, *">
                        
                        <!-- Lista de Classes -->
                        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="0,0,1,0" Background="#111">
                            <StackPanel Margin="15">
                                <TextBlock Text="SELEÇÃO DE CLASSE" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                                
                                <!-- Mock de lista (depois será um ListBox com bindings) -->
                                <Button Content="Armeiro" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                <Button Content="Batedor" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                <Button Content="Caçador" Background="#222" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                <Button Content="Médico de Combate" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                <Button Content="Operador Furtivo" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                <Button Content="Sobrevivencialista" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="0,2"/>
                                
                                <Button Content="Escolher classe ✔️" Command="{Binding FinalizeAccountCommand}" Background="#990000" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,30,0,0"/>
                                <Button Content="Voltar" Command="{Binding GoToRegisterCommand}" Classes="transparent" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Detalhes da Classe -->
                        <Grid Grid.Column="1" Margin="30">
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Caçador" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                                
                                <!-- Imagem Mock -->
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="0,0,20,0" Background="#222">
                                    <!-- Para o mockup, deixaremos o box vazio ou com texto indicativo -->
                                    <TextBlock Text="[Imagem do Personagem]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Textos e Atributos -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="15">
                                    <TextBlock Text="Descrição da Classe" Foreground="LightGray" FontWeight="Bold"/>
                                    <TextBlock Text="Um especialista em reconhecimento e combate a longa distância, o Caçador domina a arte da camuflagem e do tiro de precisão. Ideal para eliminar ameaças de longe sem ser detectado." 
                                               Foreground="#999" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Vantagens:" Foreground="LightGray" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <TextBlock Text="🟢 + Rastreamento de Pegadas" Foreground="#00CC66"/>
                                    <TextBlock Text="🟢 + Dano de Longo Alcance" Foreground="#00CC66"/>
                                    <TextBlock Text="🟢 + Camuflagem Passiva" Foreground="#00CC66"/>

                                    <TextBlock Text="Desvantagens:" Foreground="LightGray" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <TextBlock Text="🔴 - Velocidade de Movimento" Foreground="#CC3333"/>
                                    <TextBlock Text="🔴 - Velocidade de Recarga" Foreground="#CC3333"/>
                                    <TextBlock Text="🔴 - Capacidade de Carga" Foreground="#CC3333"/>

                                    <TextBlock Text="Habilidades:" Foreground="LightGray" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <TextBlock Text="• Binóculos de Reconhecimento" Foreground="#CCC"/>
                                    <TextBlock Text="• Munição de Precisão" Foreground="#CCC"/>
                                    <TextBlock Text="• Armadilha de Urso" Foreground="#CCC"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
