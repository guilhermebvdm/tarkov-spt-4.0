<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SPT.Launcher.Views.Notifications.SPTNotificationView"
             >

  <!-- TRL toast: raised surface, strong hairline, 2px status bar on the left
       (bar color per type still comes from the VM - token migration = phase 2) -->
  <Border MinHeight="20"
          Background="{DynamicResource TrlBgRaisedBrush}"
          BorderBrush="{DynamicResource TrlEdgeStrongBrush}"
          BorderThickness="1">
    <Border Padding="12"
            BorderBrush="{Binding BarColor}"
            BorderThickness="2 0 0 0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}"
                   FontFamily="{DynamicResource TrlFontDisplay}"
                   FontSize="{DynamicResource TrlTextSm}"
                   LetterSpacing="{DynamicResource TrlTrackWide}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TrlFgBrush}"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                   FontSize="{DynamicResource TrlTextSm}"
                   Foreground="{DynamicResource TrlFgMutedBrush}"
                   Margin="0,8,0,0"/>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
