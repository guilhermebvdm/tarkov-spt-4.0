<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.ProfileView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
        <!-- item 012: separador de milhar PT-BR no contador de XP -->
        <cvt:ThousandSeparatorConverter x:Key="thousandsCvt"/>
    </UserControl.Resources>

    <!-- Nav buttons: Button.nav agora é global (Assets/Theme/Controls/Nav.axaml, item 024) -->

    <Grid ColumnDefinitions="Auto, *">

        <!-- 1. SIDEBAR (TrlSidebarNav — chrome do tema) -->
        <cc:TrlSidebarNav Grid.Column="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Logo Topo (item 006: desce um pouco + respiro antes do menu) -->
                <Image Grid.Row="0" Source="/Assets/logo-redline.png" Stretch="Uniform" MaxHeight="52" HorizontalAlignment="Center" Margin="24,56,24,16"/>

                <!-- Menu Central -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,28,0,0">
                    <Button Classes="nav active" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconTarget}" VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCHER" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconSettings}" VerticalAlignment="Center"/>
                            <TextBlock Text="CONFIGURAÇÕES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenKofiCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconExternalLink}" VerticalAlignment="Center"/>
                            <TextBlock Text="APOIE UM CAFEZINHO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" ToolTip.Tip="Em construção" IsEnabled="False" Opacity="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource TrlIconMenu2}" VerticalAlignment="Center"/>
                            <TextBlock Text="LISTA DE MODS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sair / Logout -->
                <Button Grid.Row="2" Cursor="Hand" Margin="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="{StaticResource TrlIconArrowBackUp}" Stroke="{DynamicResource TrlAccentBrush}" StrokeThickness="1.75" Fill="{x:Null}" Width="18" Height="18" Stretch="Uniform" StrokeLineCap="Flat" StrokeJoin="Miter" VerticalAlignment="Center"/>
                        <TextBlock Text="SAIR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </cc:TrlSidebarNav>

        <!-- 2. ÁREA CENTRAL (CARROSSEL E JOGO) -->
        <!-- item 010: ClipToBounds contém o zoom do fundo dentro da coluna (não vaza p/ o sidebar) -->
        <Grid Grid.Column="1" ClipToBounds="True">

            <!-- Fundo da tela logada: key art do EFT (bg-hero, vinda da tela de login) + overlay olive p/ legibilidade.
                 item 010: a imagem (2500x1610) preenche exatamente a altura e é cortada só na horizontal,
                 então VerticalAlignment não teria efeito. Zoom ancorado no topo (origem 0.5,0) empurra as
                 cabeças e a logo EFT p/ baixo (longe do laser) e corta a base (menos relevante). UniformToFill
                 preservado (escala uniforme, sem distorção). -->
            <Image Source="/Assets/bg-hero.jpg" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                   RenderTransformOrigin="0.5,0">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                </Image.RenderTransform>
            </Image>
            <Border Background="{DynamicResource TrlPhotoOverlayBrush}" IsHitTestVisible="False"/>

            <!-- Layout Sobreposto da Tela Principal -->
            <Grid RowDefinitions="*, AUTO, AUTO">

                <!-- CONTEÚDO TOP/RIGHT -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,50,20,0" Width="250" Spacing="8">

                    <!-- Box: VERSÃO -->
                    <cc:TrlPanel Title="VERSÃO" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="SERVIDOR" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding ServerVersion}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="LAUNCHER" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding Source={x:Static helpers:LauncherUpdateHelper.CurrentVersion}}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </cc:TrlPanel>

                    <!-- Box: MODS OPCIONAIS (item 009: descrição visível abaixo do nome) -->
                    <cc:TrlPanel Title="MODS OPCIONAIS" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <ItemsControl ItemsSource="{Binding OptionalMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <CheckBox Content="{Binding Name}"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsEnabled}"/>
                                        <TextBlock Classes="trl-muted"
                                                   FontSize="{DynamicResource TrlTextXs}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </cc:TrlPanel>

                    <!-- Box: CONTA -->
                    <cc:TrlPanel Title="CONTA" Background="{DynamicResource TrlPanelOverPhotoBrush}">
                        <StackPanel Spacing="8">
                            <!-- ref: CR-01-03 — mesmo gate do EXCLUIR: mudar edição dispara wipe
                                 (Remove+Register) e não pode rodar com o jogo em execução -->
                            <Button Content="MUDAR EDIÇÃO DO PERFIL" Classes="sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding ChangeEditionCommand}"
                                    IsEnabled="{Binding CanStartGame}"/>

                            <!-- ref: CR-01-03 — idem: wipe no meio da sessão é tão destrutivo quanto o delete -->
                            <Button Content="RESETAR PROGRESSO (WIPE)" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding WipeConfirmCommand}"
                                    IsEnabled="{Binding CanStartGame}"
                                    ToolTip.Tip="Zera o progresso do perfil — a conta continua existindo"/>

                            <Button Content="EXCLUIR CONTA" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding DeleteAccountCommand}"
                                    IsEnabled="{Binding CanStartGame}"
                                    ToolTip.Tip="Remove a conta e o perfil do servidor — definitivo"/>

                            <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" TextWrapping="Wrap"
                                       Text="Wipe reseta o progresso e mantém a conta. Excluir remove a conta do servidor em definitivo."/>
                        </StackPanel>
                    </cc:TrlPanel>

                </StackPanel>

                <!-- BARRA DE PROGRESSO / UPDATE (item 007: cancelar + link do relatório) -->
                <StackPanel Grid.Row="1" Margin="20,0,20,5" IsVisible="{Binding IsUpdateVisible}" Spacing="5" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding UpdateStatusText}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ProgressBar Minimum="0" Maximum="{Binding UpdateMaxProgress}" Value="{Binding UpdateProgress}" VerticalAlignment="Center"/>
                        <!-- Item 016: taxa de download (média móvel, MB/s decimal, separador PT-BR) -->
                        <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" IsVisible="{Binding HasDownloadSpeed}"
                                   Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip.Tip="Velocidade de download atual"/>
                        <Button Grid.Column="2" Content="CANCELAR" Classes="ghost sm" Cursor="Hand" Margin="8,0,0,0"
                                Command="{Binding CancelUpdateCommand}" IsVisible="{Binding CanCancelUpdate}"
                                ToolTip.Tip="Cancelar a verificação/atualização (pede confirmação)"/>
                    </Grid>
                    <!-- 4.1.3: clicar abre a pasta do last-update.json -->
                    <Button Content="{Binding LastUpdateText}" Classes="link" Cursor="Hand" HorizontalAlignment="Left" Padding="0"
                            FontSize="{DynamicResource TrlTextXs}"
                            Command="{Binding OpenLastUpdateFolderCommand}" IsVisible="{Binding HasLastUpdate}"
                            ToolTip.Tip="Abrir a pasta com o relatório da última atualização"/>
                </StackPanel>

                <!-- STATUS BAR INFERIOR (PERFIL E AÇÕES) -->
                <Border Grid.Row="2" Background="{DynamicResource TrlPanelOverPhotoBrush}" BorderBrush="{DynamicResource TrlEdgeBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Margin="0" Padding="15,10">
                    <Grid ColumnDefinitions="AUTO, *, AUTO">

                        <!-- Perfil (Esquerda) -->
                        <Image Grid.Column="0" Source="{Binding SideImage.Path, Converter={StaticResource imageSourceCvt}}" Width="60" Height="60" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ProfileInfo.Level, StringFormat='Nível: {0}'}" Classes="trl-accent" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                                <!-- XP barra expandida (ProgressBar do tema) -->
                                <ProgressBar Value="{Binding ProfileInfo.XPLevelProgress}" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="150"/>
                                <TextBlock Text="{Binding ProfileInfo.RemainingExp, Converter={StaticResource thousandsCvt}, ConverterParameter='Faltam: {0:N0} xp'}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ProfileInfo.Nickname, StringFormat='Operador: {0}'}" Foreground="{DynamicResource TrlFgBrush}" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                            <!-- item 013: classe do operador (edição do CustomClasses) -->
                            <TextBlock Text="{Binding CurrentEdition, StringFormat='Classe: {0}'}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}"
                                       IsVisible="{Binding CurrentEdition, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CurrentId, StringFormat='Id: {0}'}" Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" Cursor="Hand"
                                       ToolTip.Tip="Clique para copiar"
                                       PointerPressed="CopyIdToClipboard"
                                       TextDecorations="Underline"/>
                            <TextBlock Text="{Binding ProfileInfo.Side, StringFormat='Facção: {0}'}" Classes="trl-accent" FontSize="{DynamicResource TrlTextXs}"/>
                        </StackPanel>

                        <!-- Ações (Direita) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10" Width="180">
                            <!-- Verificar Arquivos (outlined base) — ref: CR-01-01: também travado durante sync -->
                            <Button Content="VERIFICAR ARQUIVOS" Classes="sm" Cursor="Hand" Command="{Binding VerifyFilesCommand}" IsEnabled="{Binding CanVerifyFiles}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <!-- JOGAR (.primary — tan, R1) -->
                            <Button Content="▶ JOGAR" Classes="primary" Cursor="Hand" Command="{Binding StartGameCommand}" IsEnabled="{Binding CanStartGame}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15,10" FontWeight="Bold" FontSize="{DynamicResource TrlTextLg}"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
