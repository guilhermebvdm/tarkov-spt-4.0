<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPT.Launcher.CustomControls"
             xmlns:helpers="using:SPT.Launcher.Helpers"
             xmlns:cvt="using:SPT.Launcher.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
             x:Class="SPT.Launcher.Views.ProfileView">

    <UserControl.Resources>
        <cvt:ImageSourceConverter x:Key="imageSourceCvt"/>
    </UserControl.Resources>

    <!-- Nav buttons: command-based twin of ListBox.trl-nav (token-pure, item 010) -->
    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TrlFgMutedBrush}"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TrlBgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TrlFgBrush}"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="BorderBrush" Value="{DynamicResource TrlAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TrlBgActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TrlAccentBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TrlBgActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TrlAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TrlAccentBrush}"/>
        </Style>
        <Style Selector="Button.nav Path">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto, *">

        <!-- 1. SIDEBAR (TrlSidebarNav — chrome do tema) -->
        <cc:TrlSidebarNav Grid.Column="0">
            <Grid RowDefinitions="120, *, Auto">

                <!-- Logo Topo -->
                <Image Grid.Row="0" Margin="15" Source="/Assets/logo-redline.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Menu Central -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,20,0,0">
                    <Button Classes="nav active" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12 5.69l5 4.5V18h-2v-6H9v6H7v-7.81l5-4.5M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCHER" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" VerticalAlignment="Center"/>
                            <TextBlock Text="CONFIGURAÇÕES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" Command="{Binding OpenKofiCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M2,21H20V19H2M20,8H18V5H20M20,3H4V13A4,4 0 0,0 8,17H14A4,4 0 0,0 18,13V10H20A2,2 0 0,0 22,8V5C22,3.89 21.1,3 20,3M16,5V13A2,2 0 0,1 14,15H8A2,2 0 0,1 6,13V5H16Z" VerticalAlignment="Center"/>
                            <TextBlock Text="APOIE UM CAFEZINHO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Cursor="Hand" ToolTip.Tip="Em construção" IsEnabled="False" Opacity="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12.87,15.07L8.33,12.46V7.22L12.87,9.84V15.07M22.67,10L17.43,13.06L12.5,10.22L17.73,7.17L22.67,10M21.5,11.3V15.33C21.5,15.33 21.08,16.5 19.33,16.5C17.58,16.5 17.17,15.33 17.17,15.33V11.3L15.33,12.37V16.5C15.33,16.5 15.33,19.25 19.33,19.25C23.33,19.25 23.33,16.5 23.33,16.5V11.3L21.5,11.3M8.33,13.62L3.8,16.24V11L8.33,8.38V13.62M12.5,22.25L3.8,17.22V6.15L12.5,1.11L21.2,6.15L21.2,9.3L19.33,10.37L12.5,6.43L2,12.5L12.5,18.57L15.33,16.94V19.11L12.5,20.73" VerticalAlignment="Center"/>
                            <TextBlock Text="LISTA DE MODS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sair / Logout -->
                <Button Grid.Row="2" Cursor="Hand" Margin="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" Fill="{DynamicResource TrlAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SAIR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </cc:TrlSidebarNav>

        <!-- 2. ÁREA CENTRAL (CARROSSEL E JOGO) -->
        <Grid Grid.Column="1">

            <!-- Imagem de Fundo Estática (Futuro: Carrossel) -->
            <Image Source="{Binding Background.Path, Converter={StaticResource imageSourceCvt}}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <!-- Layout Sobreposto da Tela Principal -->
            <Grid RowDefinitions="*, AUTO, AUTO">

                <!-- CONTEÚDO TOP/RIGHT -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,50,20,0" Width="250" Spacing="8">

                    <!-- Box: VERSÃO -->
                    <cc:TrlPanel Title="VERSÃO">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="SERVIDOR" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding ServerVersion}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="trl-label" Text="LAUNCHER" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="trl-mono trl-accent" FontSize="{DynamicResource TrlTextXs}" FontWeight="Bold" Text="{Binding Source={x:Static helpers:LauncherUpdateHelper.CurrentVersion}}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </cc:TrlPanel>

                    <!-- Box: MODS OPCIONAIS -->
                    <cc:TrlPanel Title="MODS OPCIONAIS">
                        <ItemsControl ItemsSource="{Binding OptionalMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsEnabled}"
                                              ToolTip.Tip="{Binding Description}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </cc:TrlPanel>

                    <!-- Box: CONTA -->
                    <cc:TrlPanel Title="CONTA">
                        <StackPanel Spacing="8">
                            <Button Content="MUDAR EDIÇÃO DO PERFIL" Classes="sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding ChangeEditionCommand}"/>

                            <Button Content="RESETAR PROGRESSO (WIPE)" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding WipeConfirmCommand}"
                                    ToolTip.Tip="Zera o progresso do perfil — a conta continua existindo"/>

                            <Button Content="EXCLUIR CONTA" Classes="danger sm" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding DeleteAccountCommand}"
                                    IsEnabled="{Binding CanStartGame}"
                                    ToolTip.Tip="Remove a conta e o perfil do servidor — definitivo"/>

                            <TextBlock Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" TextWrapping="Wrap"
                                       Text="Wipe reseta o progresso e mantém a conta. Excluir remove a conta do servidor em definitivo."/>
                        </StackPanel>
                    </cc:TrlPanel>

                </StackPanel>

                <!-- BARRA DE PROGRESSO / UPDATE -->
                <StackPanel Grid.Row="1" Margin="20,0,20,5" IsVisible="{Binding IsUpdateVisible}" Spacing="5" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding UpdateStatusText}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}"/>
                    <ProgressBar Minimum="0" Maximum="{Binding UpdateMaxProgress}" Value="{Binding UpdateProgress}"/>
                </StackPanel>

                <!-- STATUS BAR INFERIOR (PERFIL E AÇÕES) -->
                <Border Grid.Row="2" Background="{DynamicResource TrlBgPanelBrush}" BorderBrush="{DynamicResource TrlEdgeBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Margin="0" Padding="15,10">
                    <Grid ColumnDefinitions="AUTO, *, AUTO">

                        <!-- Perfil (Esquerda) -->
                        <Image Grid.Column="0" Source="{Binding SideImage.Path, Converter={StaticResource imageSourceCvt}}" Width="60" Height="60" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ProfileInfo.Level, StringFormat='Nível: {0}'}" Classes="trl-accent" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                                <!-- XP barra expandida (ProgressBar do tema) -->
                                <ProgressBar Value="{Binding ProfileInfo.XPLevelProgress}" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="150"/>
                                <TextBlock Text="{Binding ProfileInfo.RemainingExp, StringFormat='Faltam: {0} xp'}" Classes="trl-muted" FontSize="{DynamicResource TrlTextXs}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ProfileInfo.Nickname, StringFormat='Operador: {0}'}" Foreground="{DynamicResource TrlFgBrush}" FontWeight="Bold" FontSize="{DynamicResource TrlTextSm}"/>
                            <TextBlock Text="{Binding CurrentId, StringFormat='Id: {0}'}" Classes="trl-faint" FontSize="{DynamicResource TrlText2Xs}" Cursor="Hand"
                                       ToolTip.Tip="Clique para copiar"
                                       PointerPressed="CopyIdToClipboard"
                                       TextDecorations="Underline"/>
                            <TextBlock Text="{Binding ProfileInfo.Side, StringFormat='Facção: {0}'}" Classes="trl-accent" FontSize="{DynamicResource TrlTextXs}"/>
                        </StackPanel>

                        <!-- Ações (Direita) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10" Width="180">
                            <!-- Verificar Arquivos (outlined base) -->
                            <Button Content="VERIFICAR ARQUIVOS" Classes="sm" Cursor="Hand" Command="{Binding VerifyFilesCommand}" IsEnabled="{Binding CanStartGame}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <!-- JOGAR (.primary — tan, R1) -->
                            <Button Content="▶ JOGAR" Classes="primary" Cursor="Hand" Command="{Binding StartGameCommand}" IsEnabled="{Binding CanStartGame}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15,10" FontWeight="Black" FontSize="{DynamicResource TrlTextLg}"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
